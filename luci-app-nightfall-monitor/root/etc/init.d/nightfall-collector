#!/bin/sh /etc/rc.common
# Фоновый сборщик истории для Nightfall «Монитор ресурсов»
START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/libexec/nightfall-collector
	procd_set_param respawn
	procd_set_param nice 10
	procd_close_instance

	# бот с командами для Telegram: только если включены уведомления, бот и заданы токен и chat id
	cfg() { sed -n "s/^$1=\"\{0,1\}\([^ #\"]*\).*/\1/p" /etc/nightfall-monitor.conf 2>/dev/null | head -n 1; }
	if [ "$(cfg TG)" = 1 ] && [ "$(cfg TG_BOT)" != 0 ] && [ -n "$(cfg TG_TOKEN)" ] && [ -n "$(cfg TG_CHAT)" ]; then
		procd_open_instance bot
		procd_set_param command /usr/libexec/nightfall-bot
		procd_set_param respawn 3600 15 0
		procd_set_param nice 10
		procd_close_instance
	fi
}
