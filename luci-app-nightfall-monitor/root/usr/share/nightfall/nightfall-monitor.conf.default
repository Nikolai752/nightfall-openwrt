# Настройки фонового сборщика Nightfall (/etc/nightfall-monitor.conf).
# Удобнее править на странице: Status → Монитор ресурсов → История → «Настройки предупреждений».
# После изменений:  /etc/init.d/nightfall-collector restart

# --- пороги предупреждений ---
TEMP_WARN=80          # °C, предупреждение (держится больше минуты)
TEMP_CRIT=90          # °C, критический перегрев
MEM_MIN_PCT=10        # предупреждение, если свободно меньше N % памяти (2 мин)
FLASH_MAX_PCT=90      # предупреждение, если флеш занят на N % и больше
CT_MAX_PCT=80         # предупреждение, если таблица соединений заполнена на N % и больше
CPU_MAX_PCT=90        # предупреждение, если процессор загружен на N % и больше
CPU_MINUTES=3         # ...дольше N минут

# --- проверка интернета (ping). Нужен ответ хотя бы от одного адреса ---
PING_TARGET=1.1.1.1
PING_TARGET2=77.88.8.8

# --- сохранять историю между перезагрузками ---
# По умолчанию история хранится в памяти (/tmp) и теряется при перезагрузке.
# Укажите папку на флешке/USB, например /mnt/sda1/nightfall. Не указывайте /etc и /root,
# чтобы не изнашивать встроенную флеш-память (запись раз в час).
PERSIST_DIR=

# --- экономия флеш-памяти ---
# Как часто (в часах) сбрасывать историю из памяти в PERSIST_DIR. Файлы без изменений не пишутся.
# Если PERSIST_DIR окажется на встроенной флеш-памяти роутера, запись будет заблокирована.
PERSIST_HOURS=6
# 1 = разрешить сохранять историю на встроенную флеш-память (например, eMMC или SSD с общим разделом). Обычно 0.
PERSIST_ANY=0
# Сколько суток хранить длинную историю (шаг 30 минут, 7–90). Она переживает перезагрузку, если задан PERSIST_DIR;
# 90 суток занимают около 300 КБ в памяти и столько же на накопителе.
HIST_DAYS=30
# Журнал перезагрузок и обрывов связи (/etc/nightfall-journal.log): одна короткая запись на событие, не более 200 строк.
JOURNAL=1
# История уровня сигнала Wi-Fi клиентов (только в памяти, раз в минуту)
WIFI_HIST=1

# --- замер скорости самим роутером ---
# Автоматически раз в N часов (0 = выключено; вручную можно кнопкой «Измерить сейчас»).
# Каждый замер скачивает файл в SPEED_STREAMS потоков сразу (по умолчанию 4 × 25 МБ = до 100 МБ трафика).
# Несколько потоков нужны, чтобы загрузить быстрый канал; на лимитном тарифе поставьте 1. Адрес можно заменить на любой файл по http/https.
SPEED_HOURS=0
SPEED_URL=https://speed.cloudflare.com/__down?bytes=25000000
SPEED_STREAMS=4

# --- трафик по приложениям (YouTube, Telegram и т. д.) ---
# 1 = включено. Включать лучше кнопкой в карточке «Трафик по приложениям» на странице «Обзор»: она заодно включит журнал DNS в dnsmasq.
APPS=0

# --- новые устройства в сети ---
# 1 = записывать в ленту событий (и в Telegram, если он включён), когда в сети появляется незнакомое устройство.
# Известные устройства хранятся в /etc/nightfall-known.list. Телефоны со «случайным» Wi-Fi адресом могут считаться новыми.
NEWDEV=1

# --- уведомления в Telegram ---
# Токен бота получите у @BotFather, chat id определяется кнопкой в настройках монитора. Если api.telegram.org у вас закрыт,
# укажите прокси, например socks5h://127.0.0.1:1080 (нужен curl: apk add curl).
TG=0
TG_ALERTS=1
# Бот с кнопками (/menu): статус, клиенты, трафик, блокировка устройств, перезагрузка. Отвечает только владельцу (TG_CHAT).
TG_BOT=1
# Бот убирает за собой: ваша команда и прошлые ответы удаляются, новый ответ всегда внизу и виден сразу (только в личном чате).
TG_CLEAN=1
# Интерактивные сообщения (виджеты, Bot API 10.4): «Статус» с живыми кольцами. Только личный чат; на старых клиентах виден обычный текст.
TG_WIDGETS=0
# Ежедневный отчёт в Telegram в указанное время (например 21:00); пусто = не отправлять.
TG_REPORT=
TG_TOKEN=
TG_CHAT=
# Если TG_CHAT это группа (id начинается с «-»): id людей через запятую, которым бот разрешает управление
# (блокировка, перезагрузка, резервная копия). Остальным участникам группы доступен только просмотр. В личном чате не нужно.
TG_USERS=
TG_PROXY=
# Либо имя интерфейса VPN (wg0, tun0…): запросы к Telegram пойдут через него (нужен curl).
TG_IFACE=
