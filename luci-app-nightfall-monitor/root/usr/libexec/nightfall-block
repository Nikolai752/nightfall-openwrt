#!/bin/sh
# Nightfall: отключение интернета для выбранных устройств (по MAC-адресу), вручную и по расписанию.
#   nightfall-block list                    — устройства и их состояние (JSON)
#   nightfall-block block MAC [ИМЯ]         — отключить интернет устройству
#   nightfall-block unblock MAC             — вернуть интернет
#   nightfall-block sched MAC ЧЧ:ММ ЧЧ:ММ [ИМЯ [ДНИ]] — первое окно расписания: отключать с … до … (можно через полночь); ДНИ — цифры 1–7 (1 — понедельник), пусто или all — каждый день
#   nightfall-block sadd MAC ЧЧ:ММ ЧЧ:ММ [ДНИ] — добавить ещё одно окно (например, отдельно будни и выходные)
#   nightfall-block sdel MAC НОМЕР          — убрать окно по номеру (1 — первое)
#   nightfall-block sched MAC off           — убрать всё расписание
#   nightfall-block quota MAC МБ|off        — лимит трафика в сутки: при превышении интернет отключается до конца суток
#   nightfall-block log                     — журнал блокировок (JSON)
#   nightfall-block meta MAC ИМЯ ИКОНКА ГРУППА — своё имя, значок и группа устройства (пустые значения сбрасывают)
#   nightfall-block groups                  — группы и их правила (JSON)
#   nightfall-block gadd|gdel ГРУППА        — создать или удалить группу (при удалении участники остаются без группы)
#   nightfall-block gblock|gunblock ГРУППА  — отключить интернет всем устройствам группы / вернуть
#   nightfall-block gsched ГРУППА ЧЧ:ММ ЧЧ:ММ [ДНИ]|off — первое окно расписания группы; gsadd ГРУППА С ДО [ДНИ] и gsdel ГРУППА НОМЕР — остальные окна
#   nightfall-block gquota ГРУППА МБ|off    — суточный лимит на каждое устройство группы
#   nightfall-block apply                   — применить правила брандмауэра (вызывается сборщиком и при загрузке)
# Правила живут в отдельной таблице nft «inet nightfall» (брандмауэр fw4 её не трогает): отбрасываются пакеты, идущие
# от устройства в сеть (forward). Доступ к самому роутеру и локальной сети не ограничивается, поэтому разблокировать можно всегда.
# Список хранится в /etc/nightfall-block.list: «mac|имя|вручную(0/1)|с|до|лимит МБ|пропуск на день ГГГГММДД|дни первого окна|остальные окна».
# Остальные окна: «ЧЧ:ММ-ЧЧ:ММ@дни;…». Дни: цифры 1–7 (1 — понедельник), пусто — каждый день. Окно через полночь («Пт 23:00–09:00»)
# относится к ночи с пятницы на субботу.
# Свои имена, значки и группы: /etc/nightfall-devices.list («mac|имя|значок|группа»).
# Правила групп: /etc/nightfall-groups.list («группа|вручную(0/1)|с|до|лимит МБ|пропуск на день|дни первого окна|остальные окна»); действуют на каждого участника.
# Журнал (последние 200 записей) — /etc/nightfall-block.log: «время|mac|имя|on/off|причина».
# Для тестов: NF_BLOCK (файл списка), NF_BLOCKLOG, NF_NOTIFY, NF_TODAY (ГГГГММДД), NF_BY (кто запросил: bot/ui), NF_NFT (команда nft), NF_PROC, NF_LEASES, NF_NOW (время ЧЧММ), NF_DOW (день недели 1–7), NF_DIR.
LIST=${NF_BLOCK:-/etc/nightfall-block.list}
NFT=${NF_NFT:-nft}
PROC=${NF_PROC:-/proc}
LEASES=${NF_LEASES:-/tmp/dhcp.leases}
DIR=${NF_DIR:-/tmp/nightfall}
LOGF=${NF_BLOCKLOG:-/etc/nightfall-block.log}
DEVF=${NF_DEVICES:-/etc/nightfall-devices.list}
GLIST=${NF_GROUPS:-/etc/nightfall-groups.list}
ICONS=' phone laptop pc tablet tv console speaker camera printer iot watch router other '
NOTIFY=${NF_NOTIFY:-/usr/libexec/nightfall-notify}
STATE=$DIR/block.state
DAYF=$DIR/dev.day

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }

mac_ok() { printf '%s' "$1" | grep -qE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'; }
time_ok() { printf '%s' "$1" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$'; }
lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
clean() { printf '%s' "$1" | tr -d '"\\|' | tr '\n' ' ' | cut -c1-40; }

own_macs() {   # свои MAC-адреса роутера: их блокировать нельзя
	for f in /sys/class/net/*/address; do [ -r "$f" ] && cat "$f"; done 2>/dev/null
}

today() { [ -n "$NF_TODAY" ] && echo "$NF_TODAY" || date +%Y%m%d; }

# запись в список: set_row MAC ИМЯ ВРУЧНУЮ С ДО ЛИМИТ ПРОПУСК ДНИ ДОПОЛНИТЕЛЬНЫЕ_ОКНА (строка нужна, если есть блокировка, расписание или лимит)
set_row() {
	m=$(lower "$1")
	touch "$LIST" 2>/dev/null || fail "не удалось записать список"
	grep -v "^$m|" "$LIST" > "$LIST.tmp" 2>/dev/null
	if [ "$3" = 1 ] || [ -n "$4" ] || [ -n "$6" ] || [ -n "$7" ]; then printf '%s|%s|%s|%s|%s|%s|%s|%s|%s\n' "$m" "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" >> "$LIST.tmp"; fi
	mv "$LIST.tmp" "$LIST" 2>/dev/null || fail "не удалось записать список"
}

row() { grep "^$(lower "$1")|" "$LIST" 2>/dev/null | head -n 1; }

# разобрать строку списка в R_NAME R_MAN R_F R_T R_Q R_SN R_D R_X
load_row() {
	r=$(row "$1")
	R_NAME=$(printf '%s' "$r" | cut -d'|' -f2); R_MAN=$(printf '%s' "$r" | cut -d'|' -f3); R_F=$(printf '%s' "$r" | cut -d'|' -f4)
	R_T=$(printf '%s' "$r" | cut -d'|' -f5); R_Q=$(printf '%s' "$r" | cut -d'|' -f6); R_SN=$(printf '%s' "$r" | cut -d'|' -f7)
	R_D=$(printf '%s' "$r" | cut -d'|' -f8); R_X=$(printf '%s' "$r" | cut -d'|' -f9)
	[ -n "$R_MAN" ] || R_MAN=0
}

now_hm() { [ -n "$NF_NOW" ] && echo "$NF_NOW" || date +%H%M; }

dow_now() { [ -n "$NF_DOW" ] && echo "$NF_DOW" || date +%u; }   # 1 — понедельник … 7 — воскресенье
day_in() { [ -z "$1" ] || case "$1" in *"$2"*) return 0 ;; *) return 1 ;; esac; }   # день входит в набор (пустой набор — все дни)

# попадает ли сейчас время в окно расписания; окно через полночь принадлежит дню, в который оно началось
in_window() {  # in_window С ДО [ДНИ]
	[ -n "$1" ] && [ -n "$2" ] || return 1
	n=$(now_hm); f=$(printf '%s' "$1" | tr -d ':'); t=$(printf '%s' "$2" | tr -d ':')
	n=$(printf '%s' "$n" | sed 's/^0*//'); f=$(printf '%s' "$f" | sed 's/^0*//'); t=$(printf '%s' "$t" | sed 's/^0*//')
	n=${n:-0}; f=${f:-0}; t=${t:-0}
	d=$(dow_now); p=$(( (d + 5) % 7 + 1 ))
	if [ "$f" -le "$t" ]; then
		[ "$n" -ge "$f" ] && [ "$n" -lt "$t" ] && day_in "$3" "$d"
	else
		{ [ "$n" -ge "$f" ] && day_in "$3" "$d"; } || { [ "$n" -lt "$t" ] && day_in "$3" "$p"; }
	fi
}

# окна расписания по строке на окно «с|до|дни»: первое окно лежит в полях С ДО ДНИ, остальные в ДОПОЛНИТЕЛЬНЫХ («с-до@дни;с-до@дни»)
wins_of() {  # wins_of С ДО ДНИ ДОПОЛНИТЕЛЬНЫЕ
	[ -n "$1" ] && [ -n "$2" ] && printf '%s|%s|%s\n' "$1" "$2" "$3"
	[ -n "$4" ] && printf '%s\n' "$4" | tr ';' '\n' | awk -F'[-@]' 'NF >= 2 { printf "%s|%s|%s\n", $1, $2, $3 }'
	return 0
}
in_any() {  # попадает ли сейчас время в любое окно
	while IFS='|' read -r wf wt wd; do
		[ -n "$wf" ] || continue
		in_window "$wf" "$wt" "$wd" && return 0
	done <<EOF
$(wins_of "$1" "$2" "$3" "$4")
EOF
	return 1
}
# собрать поля из списка окон (строки «с|до|дни») в W_F W_T W_D W_X
pack_wins() {
	W_F=; W_T=; W_D=; W_X=; wi=0
	while IFS='|' read -r wf wt wd; do
		[ -n "$wf" ] || continue
		wi=$((wi + 1))
		if [ "$wi" = 1 ]; then W_F=$wf; W_T=$wt; W_D=$wd; else W_X="${W_X:+$W_X;}$wf-$wt${wd:+@$wd}"; fi
	done <<EOF
$1
EOF
}
# проверить и привести к виду «цифры по возрастанию, без повторов»; пусто и all — каждый день; 1234567 — тоже каждый день
norm_days() {
	case "$1" in ''|all|ALL) ND=; return 0 ;; *[!1-7]*) return 1 ;; esac
	ND=$(printf '%s' "$1" | grep -o . | sort -u | tr -d '\n')
	[ "$ND" != 1234567 ] || ND=
	return 0
}
win_ok() {  # win_ok С ДО ДНИ: проверка полей окна; результат дней в ND
	time_ok "$1" && time_ok "$2" || fail "время нужно в формате ЧЧ:ММ"
	[ "$1" != "$2" ] || fail "начало и конец не должны совпадать"
	norm_days "$3" || fail "дни недели: цифры от 1 (понедельник) до 7 (воскресенье)"
}

# трафик устройства за сегодня (байт): по IP из ARP и dev.day
used_of() {
	ipa=$(awk -v m="$1" 'NR > 1 && tolower($4) == m { print $1; exit }' "$PROC/net/arp" 2>/dev/null)
	[ -n "$ipa" ] && [ -r "$DAYF" ] || { echo 0; return; }
	awk -v ip="$ipa" '$1 == ip { s += $2 + $3 } END { printf "%d", s }' "$DAYF"
}

# причина, по которой интернет отключён сейчас: manual, quota, sched или пусто
calc_reason() {  # calc_reason MAC ВРУЧНУЮ С ДО ЛИМИТ ПРОПУСК ДНИ ДОПОЛНИТЕЛЬНЫЕ_ОКНА
	[ "$2" = 1 ] && { echo manual; return; }
	[ "$6" = "$(today)" ] && return 0
	if [ -n "$5" ] && [ "$5" -gt 0 ] 2>/dev/null; then
		u=$(used_of "$1"); [ "${u:-0}" -ge $(($5 * 1048576)) ] && { echo quota; return; }
	fi
	in_any "$3" "$4" "$7" "$8" && echo sched
	return 0
}

gclean() { printf '%s' "$1" | tr -d '"\\|' | tr '\n' ' ' | sed 's/^ *//; s/ *$//' | cut -c1-30; }
group_of() { [ -r "$DEVF" ] && awk -F'|' -v m="$1" '$1 == m { print $4; exit }' "$DEVF"; }
grow() { [ -r "$GLIST" ] && awk -v g="$1" -F'|' '$1 == g { print; exit }' "$GLIST"; }
dev_name() { [ -r "$DEVF" ] && awk -F'|' -v m="$1" '$1 == m { print $2; exit }' "$DEVF"; }
# запись группы: gset ГРУППА ВРУЧНУЮ С ДО ЛИМИТ ПРОПУСК ДНИ ДОПОЛНИТЕЛЬНЫЕ_ОКНА
gset() {
	touch "$GLIST" 2>/dev/null || fail "не удалось записать список групп"
	# строка группы заменяется на месте (порядок групп не меняется: бот ссылается на них по номеру)
	awk -F'|' -v g="$1" -v row="$1|$2|$3|$4|$5|$6|$7|$8" '$1 == g { print row; done = 1; next } { print } END { if (!done) print row }' "$GLIST" > "$GLIST.tmp" 2>/dev/null
	mv "$GLIST.tmp" "$GLIST" 2>/dev/null || fail "не удалось записать список групп"
}
# причина отключения с учётом правил группы: manual, gmanual, quota, sched или пусто
reason_all() {  # reason_all MAC
	load_row "$1"
	rs=$(calc_reason "$1" "$R_MAN" "$R_F" "$R_T" "$R_Q" "$R_SN" "$R_D" "$R_X"); [ -n "$rs" ] && { echo "$rs"; return; }
	g=$(group_of "$1"); [ -n "$g" ] || return 0
	gr=$(grow "$g"); [ -n "$gr" ] || return 0
	gm=$(printf '%s' "$gr" | cut -d'|' -f2); gf=$(printf '%s' "$gr" | cut -d'|' -f3); gt=$(printf '%s' "$gr" | cut -d'|' -f4)
	gq=$(printf '%s' "$gr" | cut -d'|' -f5); gs=$(printf '%s' "$gr" | cut -d'|' -f6)
	gd=$(printf '%s' "$gr" | cut -d'|' -f7); gx=$(printf '%s' "$gr" | cut -d'|' -f8)
	[ "$gm" = 1 ] && { echo gmanual; return; }
	[ "$R_SN" = "$(today)" ] && return 0
	calc_reason "$1" 0 "$gf" "$gt" "$gq" "$gs" "$gd" "$gx"
}

logev() {  # logev MAC ИМЯ on|off ПРИЧИНА
	t=$(date +%s)
	printf '%s|%s|%s|%s|%s\n' "$t" "$1" "$2" "$3" "$4" >> "$LOGF" 2>/dev/null
	[ "$(wc -l < "$LOGF" 2>/dev/null)" -le 240 ] 2>/dev/null || { tail -n 200 "$LOGF" > "$LOGF.tmp" && mv "$LOGF.tmp" "$LOGF"; }
}

apply() {
	macs=""; new=""
	cands=$( { [ -r "$LIST" ] && cut -d'|' -f1 "$LIST"; [ -s "$GLIST" ] && [ -r "$DEVF" ] && awk -F'|' 'NR == FNR { g[$1] = 1; next } $4 in g { print $1 }' "$GLIST" "$DEVF"; } 2>/dev/null | sort -u )
	for m in $cands; do
		[ -n "$m" ] || continue
		rs=$(reason_all "$m")
		[ -n "$rs" ] || continue
		nm=$R_NAME; [ -n "$nm" ] || nm=$(dev_name "$m")
		macs="${macs:+$macs, }$m"
		new="$new$m|$rs|$nm
"
	done
	# журнал: фиксируем только изменения (после перезагрузки состояние неизвестно, тогда просто запоминаем)
	if [ -f "$STATE" ]; then
		printf '%s' "$new" | while IFS='|' read -r m rs nm; do
			[ -n "$m" ] || continue
			grep -q "^$m|" "$STATE" && continue
			case "$rs" in manual) why="вручную (${NF_BY:-интерфейс})" ;; gmanual) why="группа отключена вручную" ;; quota) why="лимит трафика" ;; *) why="расписание" ;; esac
			logev "$m" "$nm" on "$why"
			if [ "$rs" = quota ] && [ -x "$NOTIFY" ]; then
				k=$(printf '%s' "$m" | tr -d ':')
				"$NOTIFY" send "🚫 ${nm:-$m}: достиг суточного лимита, интернет отключён до конца суток." "{\"inline_keyboard\":[[{\"text\":\"↩️ Вернуть на сегодня\",\"callback_data\":\"ub:$k\"}]]}" >/dev/null 2>&1 &
			fi
		done
		while IFS='|' read -r m rs nm; do
			[ -n "$m" ] || continue
			printf '%s' "$new" | grep -q "^$m|" && continue
			case "$rs" in manual) why="вручную (${NF_BY:-интерфейс})" ;; gmanual) why="группа возвращена" ;; quota) why="новые сутки или возвращён" ;; *) why="расписание закончилось или возвращён" ;; esac
			logev "$m" "$nm" off "$why"
		done < "$STATE"
	fi
	mkdir -p "$DIR" 2>/dev/null; printf '%s' "$new" > "$STATE"
	if [ -z "$macs" ]; then
		$NFT delete table inet nightfall 2>/dev/null
		return 0
	fi
	# одна транзакция: таблица создаётся (если не было), удаляется и создаётся заново с актуальным набором
	printf 'add table inet nightfall\ndelete table inet nightfall\ntable inet nightfall {\n\tset blocked {\n\t\ttype ether_addr\n\t\telements = { %s }\n\t}\n\tchain forward {\n\t\ttype filter hook forward priority -10; policy accept;\n\t\tether saddr @blocked counter drop\n\t}\n}\n' "$macs" | $NFT -f - 2>/dev/null
}


# ---------- кто в сети сейчас ----------
# Запись в таблице ARP живёт и у ушедших устройств, и пропадает у простаивающих (телефон со случайным MAC молчит, и роутер
# про него «забывает»). Поэтому: клиенты Wi-Fi определяются по подключению к точке доступа, остальные проверяются живым
# ARP-запросом (запись сбрасывается, роутер отправляет пинг и ждёт ответ). Ответ на ARP приходит и у устройств, которые
# не отвечают на ping.
# Определить физический LAN-порт по FDB моста. Wi-Fi определяется отдельно через assoclist.
# NF_PORTMAP — тестовый источник «MAC PORT»; в системе используются bridge fdb или brctl.
lan_port() {
	m=$(lower "$1")
	[ -n "$m" ] || return 0
	if [ -n "$NF_PORTMAP" ] && [ -r "$NF_PORTMAP" ]; then
		awk -v m="$m" 'tolower($1) == m { print $2; exit }' "$NF_PORTMAP"
		return 0
	fi
	for bd in /sys/class/net/*; do
		[ -d "$bd/bridge" ] || continue
		br=${bd##*/}
		if command -v bridge >/dev/null 2>&1; then
			d=$(bridge fdb show br "$br" 2>/dev/null | awk -v m="$m" 'tolower($1) == m { for (i=1; i<NF; i++) if ($i == "dev") { print $(i+1); exit } }')
			[ -n "$d" ] || continue
		else
			command -v brctl >/dev/null 2>&1 || continue
			p=$(brctl showmacs "$br" 2>/dev/null | awk -v m="$m" 'tolower($2) == m { print $1; exit }')
			[ -n "$p" ] || continue
			d=$(brctl showstp "$br" 2>/dev/null | awk -v p="$p" '/^[^[:space:]].* \\([0-9]+\\)$/ { n=$2; gsub(/[()]/, "", n); if (n == p) { print $1; exit } }')
			[ -n "$d" ] || continue
		fi
		case "$d" in
			lan[0-9]*) printf 'LAN%s\\n' "${d#lan}"; return 0 ;;
			eth*|en*) printf 'LAN · %s\\n' "$d"; return 0 ;;
		esac
	done
}

annotate_live() {
	while read -r kind m ip dev; do
		port=""
		[ "$kind" = A ] && port=$(lan_port "$m")
		printf '%s %s %s %s %s\\n' "$kind" "$m" "$ip" "$dev" "$port"
	done
}

wifi_macs() {
	if [ -n "$NF_WIFI" ]; then cat "$NF_WIFI" 2>/dev/null; return 0; fi
	command -v ubus >/dev/null 2>&1 || return 0
	for d in $(ubus call iwinfo devices 2>/dev/null | awk -F'"' 'NF >= 3 && $2 != "devices" { print $2 }'); do
		ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null | awk -F'"' '$2 == "mac" { print tolower($4) }'
	done
}
neigh_dump() { if [ -n "$NF_NEIGH" ]; then cat "$NF_NEIGH" 2>/dev/null; else ${NF_IP:-ip} -4 neigh show 2>/dev/null; fi; }
live_list() {   # строки «W mac» (Wi-Fi) и «A mac ip интерфейс» (ответили по ARP)
	wm=$(wifi_macs | tr 'A-F' 'a-f' | sort -u)
	[ -n "$wm" ] && printf '%s\n' "$wm" | awk '{ print "W", $1 }'
	if [ -z "$NF_NEIGH" ] && ! command -v "${NF_IP:-ip}" >/dev/null 2>&1; then
		[ -r "$PROC/net/arp" ] && awk 'NR > 1 && $3 == "0x2" && $4 != "00:00:00:00:00:00" { print "A", tolower($4), $1, $6 }' "$PROC/net/arp"
		return 0
	fi
	mkdir -p "$DIR" 2>/dev/null
	neigh_dump > "$DIR/neigh.cur"
	cand=$( { [ -r "$LEASES" ] && awk '{ print "L", tolower($2), $3 }' "$LEASES"
		awk '/lladdr/ { for (i = 1; i < NF; i++) if ($i == "lladdr") print "N", tolower($(i + 1)), $1, $NF }' "$DIR/neigh.cur"; } 2>/dev/null |
		awk -v wm=" $(printf '%s ' $wm)" '
			$1 == "N" && $4 == "REACHABLE" { fresh[$2] = 1 }
			{ l[NR] = $0 }
			END { for (i = 1; i <= NR; i++) { split(l[i], f, " "); m = f[2]; if (index(wm, " " m " ") || (m in fresh) || f[3] !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ || (f[3] in seen)) continue; seen[f[3]] = 1; print f[3] } }' | head -n 40 )
	rm -f "$DIR/ping.ok"
	if [ -n "$cand" ]; then
		for ip in $cand; do
			${NF_IP:-ip} neigh flush to "$ip" >/dev/null 2>&1
			( ${NF_PING:-ping} -c 1 -W 1 "$ip" >/dev/null 2>&1 && echo "$ip" >> "$DIR/ping.ok" ) &
		done
		wait
		neigh_dump > "$DIR/neigh.cur"
	fi
	res=$( {
		awk '/lladdr/ && $NF == "REACHABLE" { m = ""; d = ""; for (i = 1; i < NF; i++) { if ($i == "lladdr") m = tolower($(i + 1)); if ($i == "dev") d = $(i + 1) } if (m != "") print "A", m, $1, d }' "$DIR/neigh.cur"
		# ответ на ping — прямое доказательство, что устройство включено (даже если запись ARP успела устареть)
		if [ -s "$DIR/ping.ok" ]; then
			{ sed 's/^/P /' "$DIR/ping.ok"
			  awk '/lladdr/ { m = ""; d = ""; for (i = 1; i < NF; i++) { if ($i == "lladdr") m = tolower($(i + 1)); if ($i == "dev") d = $(i + 1) } if (m != "") print "N", $1, m, d }' "$DIR/neigh.cur"
			  [ -r "$LEASES" ] && awk '{ print "L", $3, tolower($2) }' "$LEASES"; } |
			awk '$1 == "N" { nm[$2] = $3; nd[$2] = $4; next } $1 == "L" { lm[$2] = $3; next } $1 == "P" { p[$2] = 1 }
				END { for (ip in p) { m = (ip in nm ? nm[ip] : lm[ip]); if (m != "") print "A", m, ip, (ip in nd ? nd[ip] : "") } }'
		fi; } )
	# Запасной вариант: если проверка ничего не нашла (нет ip, ping или прав), показываем записи ARP, как раньше. Страницу открывает
	# устройство из сети, так что «никого нет в сети» означает сбой проверки, а не реальность.
	if [ -z "$res" ] && [ -z "$wm" ] && [ -r "$PROC/net/arp" ]; then
		awk 'NR > 1 && $3 == "0x2" && $4 != "00:00:00:00:00:00" { print "A", tolower($4), $1, $6 }' "$PROC/net/arp"
		return 0
	fi
	[ -n "$res" ] && printf '%s\n' "$res"
}

# unblock устройства, отключённого группой вручную, невозможен: нужно вернуть группу
grp_ok() { [ -n "$(grow "$1")" ] || fail "такой группы нет"; }

case "$1" in
list)
	# устройства: ARP (кто в сети сейчас) + аренды DHCP (имена, давно не видимые) + уже заблокированные
	{ [ -s "$DEVF" ] && awk -F'|' '$1 != "" { print "D|" $1 "|" $3 "|" $4 "|" $2 }' "$DEVF"
	  [ -s "$LIST" ] && awk -F'|' '{ print "B", $1, ($3 == "" ? 0 : $3), ($4 == "" ? "-" : $4), ($5 == "" ? "-" : $5), ($6 == "" ? "-" : $6), ($7 == "" ? "-" : $7), ($8 == "" ? "-" : $8), ($9 == "" ? "-" : $9), $2 }' "$LIST"
	  [ -r "$LEASES" ] && awk '{ print "L", tolower($2), $3, ($4 == "*" ? "" : $4) }' "$LEASES"
	  live_list
	} 2>/dev/null | annotate_live | awk -v own="$(own_macs | tr '\n' ' ')" -v wan="$(sed -n 's/^wan_dev=//p' "$DIR/info" 2>/dev/null | head -n 1)" '
		function esc(s) { gsub(/["\\|]/, "", s); return s }
		BEGIN { n = split(tolower(own), o, " "); for (i = 1; i <= n; i++) mine[o[i]] = 1 }
		index($0, "D|") == 1 { split($0, p, "|"); m = p[2]; di[m] = p[3]; dg[m] = p[4]; dn[m] = p[5]; seen[m] = 1; next }
		$1 == "B" { m = $2; man[m] = $3; sf[m] = ($4 == "-" ? "" : $4); st[m] = ($5 == "-" ? "" : $5); qq[m] = ($6 == "-" ? "" : $6); sn[m] = ($7 == "-" ? "" : $7); sd[m] = ($8 == "-" ? "" : $8); sx[m] = ($9 == "-" ? "" : $9); x = ""; for (i = 10; i <= NF; i++) x = x (i > 10 ? " " : "") $i; bn[m] = x; seen[m] = 1 }
		$1 == "L" { m = $2; ip[m] = $3; nm[m] = $4; seen[m] = 1 }
		$1 == "W" { m = $2; wf[m] = 1; on[m] = 1; seen[m] = 1 }
		$1 == "A" { m = $2; if ($4 == wan && !(m in seen)) next; ip[m] = $3; on[m] = 1; seen[m] = 1; if ($5 != "") port[m] = $5 }   # на устройстве WAN пропускаем только чужих: если WAN и LAN на одном интерфейсе, клиенты известны по DHCP
		END {
			for (m in seen) {
				if (m in mine) continue
				name = (dn[m] != "" ? dn[m] : (nm[m] != "" ? nm[m] : bn[m]))
				printf "%s|%s|%s|%d|%d|%s|%s|%s|%s|%s|%s|%d|%s|%s|%s\n", m, esc(ip[m]), esc(name), (m in on ? 1 : 0), man[m] + 0, sf[m], st[m], qq[m], sn[m], esc(di[m]), esc(dg[m]), (m in wf ? 1 : 0), sd[m], sx[m], esc(port[m])
			}
		}' | {
		printf '{"ok":true,"devices":['
		c=0
		while IFS='|' read -r m ipa nm on man f t q sn ic gr wfi dy xw link; do
			rs=$(reason_all "$m")
			[ -n "$q" ] || q=$(grow "$gr" | cut -d'|' -f5)
			[ -n "$q" ] && u=$(used_of "$m") || u=0
			[ "$on" = 1 ] && on=true || on=false
			[ "$man" = 1 ] && man=true || man=false
			[ "$wfi" = 1 ] && wfi=true || wfi=false
			[ "$c" = 0 ] || printf ','
			c=1
			printf '{"mac":"%s","ip":"%s","name":"%s","online":%s,"manual":%s,"from":"%s","to":"%s","quota":%s,"used":%s,"active":%s,"reason":"%s","snoozed":%s,"icon":"%s","group":"%s","wifi":%s,"days":"%s","rules":"%s","connection":"%s"}' "$m" "$ipa" "$nm" "$on" "$man" "$f" "$t" "${q:-0}" "${u:-0}" "$([ -n "$rs" ] && echo true || echo false)" "$rs" "$([ "$sn" = "$(today)" ] && echo true || echo false)" "$ic" "$gr" "$wfi" "$dy" "$xw" "$link"
		done
		printf ']}\n'
	} ;;
block)
	mac_ok "$2" || fail "неверный MAC-адрес"
	m=$(lower "$2")
	own_macs | tr 'A-Z' 'a-z' | grep -qx "$m" && fail "это адрес самого роутера"
	load_row "$m"; nn=$(clean "${3:-$R_NAME}")
	set_row "$m" "$nn" 1 "$R_F" "$R_T" "$R_Q" "" "$R_D" "$R_X"; apply; printf '{"ok":true}\n' ;;
unblock)
	mac_ok "$2" || fail "неверный MAC-адрес"
	m=$(lower "$2"); load_row "$m"
	[ "$(reason_all "$m")" = gmanual ] && fail "устройство отключено группой «$(group_of "$m")»: верните группу"
	# если интернет отключён лимитом или расписанием, «вернуть» пропускает их до конца суток
	rs=$(calc_reason "$m" 0 "$R_F" "$R_T" "$R_Q" "$R_SN" "$R_D" "$R_X"); sn=$R_SN
	if [ -z "$rs" ] && [ "$R_MAN" != 1 ]; then rs=$(reason_all "$m"); fi
	[ -n "$rs" ] && sn=$(today)
	set_row "$m" "$R_NAME" 0 "$R_F" "$R_T" "$R_Q" "$sn" "$R_D" "$R_X"; apply; printf '{"ok":true}\n' ;;
sched)
	mac_ok "$2" || fail "неверный MAC-адрес"
	m=$(lower "$2"); load_row "$m"
	if [ "$3" = off ]; then set_row "$m" "$R_NAME" "$R_MAN" "" "" "$R_Q" "$R_SN" "" ""
	else
		win_ok "$3" "$4" "$6"
		own_macs | tr 'A-Z' 'a-z' | grep -qx "$m" && fail "это адрес самого роутера"
		set_row "$m" "$(clean "${5:-$R_NAME}")" "$R_MAN" "$3" "$4" "$R_Q" "$R_SN" "$ND" "$R_X"   # первое окно заменяется, остальные остаются
	fi
	apply; printf '{"ok":true}\n' ;;
sadd|sdel)
	mac_ok "$2" || fail "неверный MAC-адрес"
	m=$(lower "$2"); load_row "$m"
	if [ "$1" = sadd ]; then
		win_ok "$3" "$4" "$5"
		own_macs | tr 'A-Z' 'a-z' | grep -qx "$m" && fail "это адрес самого роутера"
		cur=$(wins_of "$R_F" "$R_T" "$R_D" "$R_X")
		[ "$(printf '%s\n' "$cur" | grep -c .)" -lt 7 ] || fail "не больше 7 окон"
		pack_wins "$cur
$3|$4|$ND"
	else
		case "$3" in ''|*[!0-9]*) fail "номер окна нужен числом" ;; esac
		cur=$(wins_of "$R_F" "$R_T" "$R_D" "$R_X")
		[ "$3" -ge 1 ] && [ "$3" -le "$(printf '%s\n' "$cur" | grep -c .)" ] || fail "такого окна нет"
		pack_wins "$(printf '%s\n' "$cur" | sed "${3}d")"
	fi
	set_row "$m" "$R_NAME" "$R_MAN" "$W_F" "$W_T" "$R_Q" "$R_SN" "$W_D" "$W_X"
	apply; printf '{"ok":true}\n' ;;
quota)
	mac_ok "$2" || fail "неверный MAC-адрес"
	m=$(lower "$2"); load_row "$m"
	if [ "$3" = off ]; then set_row "$m" "$R_NAME" "$R_MAN" "$R_F" "$R_T" "" "" "$R_D" "$R_X"
	else
		case "$3" in ''|*[!0-9]*) fail "лимит нужен числом мегабайт" ;; esac
		[ "$3" -ge 1 ] && [ "$3" -le 1000000 ] || fail "лимит от 1 до 1000000 МБ"
		own_macs | tr 'A-Z' 'a-z' | grep -qx "$m" && fail "это адрес самого роутера"
		set_row "$m" "$(clean "${4:-$R_NAME}")" "$R_MAN" "$R_F" "$R_T" "$3" "" "$R_D" "$R_X"
	fi
	apply; printf '{"ok":true}\n' ;;
meta)
	mac_ok "$2" || fail "неверный MAC-адрес"
	m=$(lower "$2"); nn=$(clean "$3"); ic=$(printf '%s' "$4" | tr -cd 'a-z')
	[ -z "$ic" ] || case "$ICONS" in *" $ic "*) ;; *) fail "неизвестный значок" ;; esac
	gg=$(gclean "$5"); [ -z "$gg" ] || grp_ok "$gg"
	touch "$DEVF" 2>/dev/null || fail "не удалось записать список устройств"
	awk -F'|' -v m="$m" '$1 != m' "$DEVF" > "$DEVF.tmp" 2>/dev/null
	[ -n "$nn$ic$gg" ] && printf '%s|%s|%s|%s\n' "$m" "$nn" "$ic" "$gg" >> "$DEVF.tmp"
	mv "$DEVF.tmp" "$DEVF" 2>/dev/null || fail "не удалось записать список устройств"
	apply; printf '{"ok":true}\n' ;;
groups)
	printf '{"ok":true,"groups":['
	[ -r "$GLIST" ] && awk -F'|' '{ gsub(/["\\]/, "", $1); printf "%s{\"name\":\"%s\",\"manual\":%s,\"from\":\"%s\",\"to\":\"%s\",\"quota\":%d,\"snoozed\":%s,\"days\":\"%s\",\"rules\":\"%s\"}", (NR > 1 ? "," : ""), $1, ($2 == 1 ? "true" : "false"), $3, $4, $5 + 0, ($6 == "'"$(today)"'" ? "true" : "false"), $7, $8 }' "$GLIST"
	printf ']}\n' ;;
gadd)
	g=$(gclean "$2"); [ -n "$g" ] || fail "введите название группы"
	[ -z "$(grow "$g")" ] || fail "такая группа уже есть"
	[ "$({ wc -l < "$GLIST"; } 2>/dev/null || echo 0)" -lt 20 ] || fail "не больше 20 групп"
	gset "$g" 0 "" "" "" "" "" ""; printf '{"ok":true}\n' ;;
gdel)
	g=$(gclean "$2"); grp_ok "$g"
	awk -F'|' -v g="$g" '$1 != g' "$GLIST" > "$GLIST.tmp" 2>/dev/null; mv "$GLIST.tmp" "$GLIST"
	[ -r "$DEVF" ] && { awk -F'|' -v g="$g" 'BEGIN { OFS = "|" } $4 == g { $4 = "" } $2 != "" || $3 != "" || $4 != "" { print }' "$DEVF" > "$DEVF.tmp" && mv "$DEVF.tmp" "$DEVF"; }
	apply; printf '{"ok":true}\n' ;;
gblock|gunblock)
	g=$(gclean "$2"); grp_ok "$g"; gr=$(grow "$g")
	f=$(printf '%s' "$gr" | cut -d'|' -f3); t=$(printf '%s' "$gr" | cut -d'|' -f4); q=$(printf '%s' "$gr" | cut -d'|' -f5); sn=$(printf '%s' "$gr" | cut -d'|' -f6)
	gd=$(printf '%s' "$gr" | cut -d'|' -f7); gx=$(printf '%s' "$gr" | cut -d'|' -f8)
	if [ "$1" = gblock ]; then gset "$g" 1 "$f" "$t" "$q" "" "$gd" "$gx"
	else
		rs=$(calc_reason zz:zz 0 "$f" "$t" "" "$sn" "$gd" "$gx"); [ -n "$rs" ] && sn=$(today)   # расписание группы пропускается до конца суток
		gset "$g" 0 "$f" "$t" "$q" "$sn" "$gd" "$gx"
	fi
	apply; printf '{"ok":true}\n' ;;
gsched)
	g=$(gclean "$2"); grp_ok "$g"; gr=$(grow "$g")
	m=$(printf '%s' "$gr" | cut -d'|' -f2); q=$(printf '%s' "$gr" | cut -d'|' -f5); sn=$(printf '%s' "$gr" | cut -d'|' -f6); gx=$(printf '%s' "$gr" | cut -d'|' -f8)
	if [ "$3" = off ]; then gset "$g" "$m" "" "" "$q" "$sn" "" ""
	else
		win_ok "$3" "$4" "$5"
		gset "$g" "$m" "$3" "$4" "$q" "$sn" "$ND" "$gx"
	fi
	apply; printf '{"ok":true}\n' ;;
gsadd|gsdel)
	g=$(gclean "$2"); grp_ok "$g"; gr=$(grow "$g")
	m=$(printf '%s' "$gr" | cut -d'|' -f2); f=$(printf '%s' "$gr" | cut -d'|' -f3); t=$(printf '%s' "$gr" | cut -d'|' -f4); q=$(printf '%s' "$gr" | cut -d'|' -f5)
	sn=$(printf '%s' "$gr" | cut -d'|' -f6); gd=$(printf '%s' "$gr" | cut -d'|' -f7); gx=$(printf '%s' "$gr" | cut -d'|' -f8)
	cur=$(wins_of "$f" "$t" "$gd" "$gx")
	if [ "$1" = gsadd ]; then
		win_ok "$3" "$4" "$5"
		[ "$(printf '%s\n' "$cur" | grep -c .)" -lt 7 ] || fail "не больше 7 окон"
		pack_wins "$cur
$3|$4|$ND"
	else
		case "$3" in ''|*[!0-9]*) fail "номер окна нужен числом" ;; esac
		[ "$3" -ge 1 ] && [ "$3" -le "$(printf '%s\n' "$cur" | grep -c .)" ] || fail "такого окна нет"
		pack_wins "$(printf '%s\n' "$cur" | sed "${3}d")"
	fi
	gset "$g" "$m" "$W_F" "$W_T" "$q" "$sn" "$W_D" "$W_X"
	apply; printf '{"ok":true}\n' ;;
gquota)
	g=$(gclean "$2"); grp_ok "$g"; gr=$(grow "$g")
	m=$(printf '%s' "$gr" | cut -d'|' -f2); f=$(printf '%s' "$gr" | cut -d'|' -f3); t=$(printf '%s' "$gr" | cut -d'|' -f4)
	gd=$(printf '%s' "$gr" | cut -d'|' -f7); gx=$(printf '%s' "$gr" | cut -d'|' -f8)
	if [ "$3" = off ]; then gset "$g" "$m" "$f" "$t" "" "" "$gd" "$gx"
	else
		case "$3" in ''|*[!0-9]*) fail "лимит нужен числом мегабайт" ;; esac
		[ "$3" -ge 1 ] && [ "$3" -le 1000000 ] || fail "лимит от 1 до 1000000 МБ"
		gset "$g" "$m" "$f" "$t" "$3" "" "$gd" "$gx"
	fi
	apply; printf '{"ok":true}\n' ;;
log)
	if [ "$2" = plain ]; then   # текст для бота: «время|имя|on/off|причина», новые сверху
		[ -r "$LOGF" ] && tail -n 12 "$LOGF" | awk -F'|' 'NF >= 5 { l[++n] = $1 "|" ($3 != "" ? $3 : $2) "|" $4 "|" $5 } END { for (i = n; i >= 1; i--) print l[i] }'
		exit 0
	fi
	printf '{"ok":true,"log":['
	[ -r "$LOGF" ] && tail -n 30 "$LOGF" | awk -F'|' 'NF >= 5 { gsub(/["\\]/, "", $3); gsub(/["\\]/, "", $5); l[++n] = sprintf("[%s,\"%s\",\"%s\",\"%s\",\"%s\"]", $1, $2, $3, $4, $5) } END { for (i = n; i >= 1; i--) printf "%s%s", (i < n ? "," : ""), l[i] }'
	printf ']}\n' ;;
apply)
	apply ;;
*)
	echo "usage: nightfall-block list | block|unblock MAC | sched|sadd|sdel|quota MAC ... | meta MAC NAME ICON GROUP | groups | gadd|gdel|gblock|gunblock G | gsched G f t [days]|off | gsadd|gsdel G ... | gquota G MB|off | log | apply" >&2
	exit 1 ;;
esac
