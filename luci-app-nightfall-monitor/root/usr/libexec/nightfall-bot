#!/bin/sh
# Nightfall bot: команды в Telegram. Работает в фоне (запускает init-скрипт), отвечает только владельцу (TG_CHAT).
#   /status   состояние роутера     /clients  кто в сети        /traffic  трафик устройств за сегодня
#   /apps     трафик по приложениям /speed    последний замер   /help     список команд
#   /menu     меню с кнопками (так бот и работает: все команды доступны кнопками, плюс блокировка устройств и перезагрузка)
#   nightfall-bot report            — вывести текст ежедневного отчёта (его отправляет сборщик в заданное время)
# Получение команд: длинный опрос getUpdates (запросы идут туда же, куда и уведомления: прокси или интерфейс VPN).
# Для тестов: NF_DIR, NF_PROC, NF_LEASES, NF_NOTIFY, NF_ONCE=1 (обработать один ответ и выйти), NF_NOSLEEP.
DIR=${NF_DIR:-/tmp/nightfall}
PROC=${NF_PROC:-/proc}
LEASES=${NF_LEASES:-/tmp/dhcp.leases}
NOTIFY=${NF_NOTIFY:-/usr/libexec/nightfall-notify}
BLOCK=${NF_BLOCKBIN:-/usr/libexec/nightfall-block}
WOL=${NF_WOLBIN:-/usr/libexec/nightfall-wol}
SPEEDBIN=${NF_SPEEDBIN:-/usr/libexec/nightfall-speed}
GUEST=${NF_GUESTBIN:-/usr/libexec/nightfall-guest}
WIFI=${NF_WIFI:-wifi}
INITD=${NF_INITD:-/etc/init.d}
WDIR=${NF_WIDGETS:-/usr/share/nightfall/widgets}   # HTML-шаблоны виджетов
DF=${NF_DF:-df}
REBOOT=${NF_REBOOT:-reboot}
DATE_NOW=${NF_DATE_NOW:-}
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
cfg() { [ -r "$CONF" ] && sed -n "s/^$1=\"\{0,1\}\([^ #\"]*\).*/\1/p" "$CONF" | head -n 1; }
CHAT=$(cfg TG_CHAT)
USERS=$(cfg TG_USERS)
FROM=""; ADM=0
HOST=$(cat "$PROC/sys/kernel/hostname" 2>/dev/null || echo router)

# кнопки под сообщением (inline-клавиатура); ответ без явного второго параметра получает главное меню
KB_MAIN='{"inline_keyboard":[[{"text":"📊 Статус","callback_data":"status"},{"text":"🖥 Клиенты","callback_data":"clients"}],[{"text":"📈 Трафик","callback_data":"traffic"},{"text":"📱 Приложения","callback_data":"apps"}],[{"text":"⚡ Скорость","callback_data":"speed"},{"text":"🚫 Блокировка","callback_data":"block"}],[{"text":"📶 Гостевой Wi-Fi","callback_data":"gs"},{"text":"⏻ Включить устройство","callback_data":"wk"}],[{"text":"💾 Резервная копия","callback_data":"bk"},{"text":"🔁 Службы","callback_data":"svc"}],[{"text":"🔄 Перезагрузка","callback_data":"rb"},{"text":"🧹 Очистить чат","callback_data":"cl"}]]}'
KB_SPEED='{"inline_keyboard":[[{"text":"▶️ Замерить сейчас","callback_data":"sp:run"}],[{"text":"⬅️ Меню","callback_data":"menu"}]]}'
KB_BACK='{"inline_keyboard":[[{"text":"⬅️ Меню","callback_data":"menu"}]]}'
KB_SVC='{"inline_keyboard":[[{"text":"📡 Wi-Fi","callback_data":"rs:wifi"},{"text":"🌐 DHCP и DNS","callback_data":"rs:dns"}],[{"text":"🛡 Брандмауэр","callback_data":"rs:fw"},{"text":"🔌 Сеть","callback_data":"rs:net"}],[{"text":"⬅️ Меню","callback_data":"menu"}]]}'
KB_REBOOT='{"inline_keyboard":[[{"text":"✅ Да, перезагрузить","callback_data":"rb:yes"},{"text":"Отмена","callback_data":"menu"}]]}'
MID=""   # id сообщения с нажатой кнопкой: если он есть, ответ правит это сообщение, а не шлёт новое
UMID=""  # id сообщения-команды, которую написал человек (его удаляем, чтобы в чате оставался только ответ)
LASTID="" # id последнего отправленного ботом сообщения
MSGS="$DIR/bot.msgs"   # id сообщений бота и команд: по ним работает очистка чата
reply() {
	if [ -n "$MID" ]; then "$NOTIFY" edit "$MID" "$1" "${2-$KB_MAIN}" >/dev/null 2>&1
	else
		r=$("$NOTIFY" reply "$1" "${2-$KB_MAIN}" 2>/dev/null)
		LASTID=$(printf '%s' "$r" | sed -n 's/.*"message_id":\([0-9][0-9]*\).*/\1/p' | head -n 1)
		[ -z "$LASTID" ] || track "$LASTID"
	fi
}
track() { echo "$1" >> "$MSGS"; tail -n 100 "$MSGS" > "$MSGS.t" 2>/dev/null && mv "$MSGS.t" "$MSGS"; }
# purge ID…: удалить сообщения одним запросом, в фоне (Telegram сам пропускает уже удалённые и старше 48 часов)
purge() {
	ids=$(printf '%s\n' "$@" | grep -E '^[0-9]+$' | sort -un | head -n 100 | paste -sd, -)
	[ -n "$ids" ] || return 0
	"$NOTIFY" raw deleteMessages -d "chat_id=$CHAT" -d "message_ids=[$ids]" >/dev/null 2>&1 &
}

# ---- форматирование ----
BYTES='function fb(b,   x) { x = "Б"; if (b >= 1024) { b /= 1024; x = "КБ" } if (b >= 1024) { b /= 1024; x = "МБ" } if (b >= 1024) { b /= 1024; x = "ГБ" } return (x == "Б" ? sprintf("%d %s", b, x) : sprintf("%.1f %s", b, x)) }'
dur() { awk -v s="$1" 'BEGIN { d = int(s / 86400); h = int(s % 86400 / 3600); m = int(s % 3600 / 60); if (d) printf "%d д %d ч", d, h; else if (h) printf "%d ч %d мин", h, m; else printf "%d мин", m }'; }

names() {   # печатает «ip имя» из аренд DHCP (для подписей)
	[ -r "$LEASES" ] && awk '{ print $3, ($4 == "*" ? "" : $4) }' "$LEASES"
}

# bar ПРОЦЕНТ: полоска из 10 делений, например ▰▰▰▱▱▱▱▱▱▱
bar() { awk -v p="$1" 'BEGIN { n = int(p / 10 + 0.5); if (n < 0) n = 0; if (n > 10) n = 10; for (i = 0; i < n; i++) printf "▰"; for (; i < 10; i++) printf "▱" }'; }

status_build() {   # собирает текст «Статуса» в $STXT
	up=$(awk '{ print int($1) }' "$PROC/uptime" 2>/dev/null)
	ld=$(awk '{ printf "%s · %s · %s", $1, $2, $3 }' "$PROC/loadavg" 2>/dev/null)
	mp=$(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } END { if (t) printf "%d|%d", 100 * (t - a) / t, t / 1024 }' "$PROC/meminfo" 2>/dev/null)
	memp=${mp%%|*}; memt=${mp#*|}
	last=$(tail -n 1 "$DIR/hist.fine" 2>/dev/null)
	set -- $last
	temp=${4:-}; netms=${8:-}; cpu=${2:-}
	dead=0; net="нет данных"
	if [ -n "$netms" ]; then   # пинг в истории дробный (12.3), поэтому сравниваем через awk
		net=$(awk -v n="$netms" 'BEGIN { if (n + 0 >= 0 && n ~ /^[0-9.]+$/) printf "есть, %.0f мс", n; else print "НЕТ СВЯЗИ" }')
		[ "$net" = "НЕТ СВЯЗИ" ] && dead=1
	fi
	t=$(awk -v n="$temp" 'BEGIN { if (n ~ /^[0-9]+(\.[0-9]+)?$/ && n + 0 >= 0) printf "%.1f °C", n; else print "н/д" }')   # температура дробная (67.8): целочисленный test её не принимал
	fp=/; [ -d /overlay ] && fp=/overlay
	rp=$($DF -kP "$fp" 2>/dev/null | awk 'function sz(k) { if (k >= 1048576) return sprintf("%.1f ГБ", k / 1048576); return sprintf("%.1f МБ", k / 1024) }
		NR == 2 && $2 > 0 { printf "%d|%s из %s", 100 * $3 / $2, sz($3), sz($2) }')
	romp=${rp%%|*}; romd=${rp#*|}
	rate=$(awk -v rx="${5:-0}" -v tx="${6:-0}" 'BEGIN { printf "↓ %.1f · ↑ %.1f Мбит/с", rx * 8 / 1e6, tx * 8 / 1e6 }')
	# общий цвет заголовка: красный нет связи, жёлтый перегрев или нехватка ресурсов, иначе зелёный
	tw=$(cfg TEMP_WARN); tw=${tw:-80}
	dot=🟢
	awk -v t="$temp" -v tw="$tw" -v c="${cpu:-0}" -v m="${memp:-0}" -v r="${romp:-0}" 'BEGIN { exit !((t ~ /^[0-9.]+$/ && t + 0 >= tw + 0) || c + 0 >= 90 || m + 0 >= 90 || r + 0 >= 90) }' && dot=🟡
	[ "$dead" = 1 ] && dot=🔴
	cl="н/д"; [ -n "$cpu" ] && cl="$(bar "$cpu") ${cpu}%"
	ml="н/д"; [ -n "$memp" ] && ml="$(bar "$memp") ${memp}% · ${memt} МБ"
	rl="н/д"; [ -n "$romp" ] && [ "$romp" != "$rp" ] && rl="$(bar "$romp") ${romp}% · $romd"
	STXT="$dot $HOST · работает $(dur "${up:-0}")

🌐 Интернет: $net
⚡ Скорость: $rate

🧠 Процессор
$cl
💾 Память
$ml
📀 ПЗУ
$rl

🌡 Температура: $t
📈 Нагрузка: $ld"
}

# те же данные числами, для виджета: {"h":имя,"c":процессор %,"m":память %,"r":ПЗУ %,"t":°C или -1,"p":пинг мс или -1,"d":↓ Мбит/с,"u":↑ Мбит/с,"w":секунд работы}
status_json() {
	hn=$(printf '%s' "$HOST" | tr -d '"\\' | cut -c1-24)
	set -- $(tail -n 1 "$DIR/hist.fine" 2>/dev/null)
	fp=/; [ -d /overlay ] && fp=/overlay
	{ cat "$PROC/meminfo" 2>/dev/null; echo "@@"; $DF -kP "$fp" 2>/dev/null | sed 's/^/D /'; } | awk -v h="$hn" -v cpu="${2:-0}" -v t="${4:-}" -v p="${8:-}" -v rx="${5:-0}" -v tx="${6:-0}" -v w="$(awk '{ print int($1) }' "$PROC/uptime" 2>/dev/null)" '
		/^MemTotal:/ { mt = $2 } /^MemAvailable:/ { ma = $2 }
		/^D / && !/Filesystem/ && $3 > 0 { rt = $3; ru = $4 }
		END {
			if (cpu !~ /^[0-9.]+$/) cpu = 0
			m = mt ? 100 * (mt - ma) / mt : 0; r = rt ? 100 * ru / rt : 0
			tt = (t ~ /^[0-9]+(\.[0-9]+)?$/) ? t : -1; pp = (p ~ /^[0-9]+(\.[0-9]+)?$/) ? p : -1
			printf "{\"h\":\"%s\",\"c\":%.0f,\"m\":%.0f,\"r\":%.0f,\"t\":%.1f,\"p\":%.0f,\"d\":%.1f,\"u\":%.1f,\"w\":%d}", h, cpu, m, r, tt, pp, rx * 8 / 1e6, tx * 8 / 1e6, w
		}'
}
# виджеты работают только в личном чате и если включены в настройках
widgets_on() { [ "$(cfg TG_WIDGETS)" = 1 ] && case "$CHAT" in -*) false ;; *) true ;; esac; }
# send_widget ФАЙЛ ПОДПИСЬ ДАННЫЕ КНОПКИ: 0, если виджет отправлен (тогда нажатое сообщение с кнопкой убираем: виджет в него правкой не вписать)
send_widget() {
	WERR=""
	[ -r "$1" ] || { WERR="нет файла шаблона $(basename "$1")"; return 1; }
	r=$("$NOTIFY" widget "$1" "$2" "$3" "$4" 2>/dev/null)
	if [ $? -ne 0 ]; then
		# причину сохраняем: бот покажет её под текстом «Статуса», а полный ответ лежит в bot.widget.err
		WERR=$(printf '%s' "$r" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -n 1 | cut -c1-120)
		[ -n "$WERR" ] || WERR=$([ -n "$r" ] && printf '%s' "$r" | head -c 120 | tr -d '\n' || echo "нет ответа от Telegram")
		printf '%s %s\n' "$(date +%s)" "$(printf '%s' "$r" | head -c 300 | tr -d '\n')" > "$DIR/bot.widget.err"
		return 1
	fi
	rm -f "$DIR/bot.widget.err"
	LASTID=$(printf '%s' "$r" | sed -n 's/.*"message_id":\([0-9][0-9]*\).*/\1/p' | head -n 1)
	[ -n "$LASTID" ] || return 1
	track "$LASTID"; echo "$LASTID" >> "$DIR/bot.widgets"; tail -n 30 "$DIR/bot.widgets" > "$DIR/bot.widgets.t" && mv "$DIR/bot.widgets.t" "$DIR/bot.widgets"
	[ -z "$MID" ] || purge "$MID"
	return 0
}
cmd_status() {
	status_build
	if widgets_on; then
		if send_widget "$WDIR/status.html" "$STXT" "$(status_json)" "$KB_BACK"; then return; fi
		# виджет включён, но не отправился: присылаем текст и честно пишем почему
		reply "$STXT

ℹ️ Виджет не отправился: ${WERR:-неизвестная причина}"
		return
	fi
	reply "$STXT"
}

cmd_clients() {
	[ -r "$PROC/net/arp" ] || { reply "Таблица ARP недоступна."; return; }
	wan=$(sed -n 's/^wan_dev=//p' "$DIR/info" 2>/dev/null | head -n 1)
	out=$( { names; echo ---; awk -v wan="$wan" 'NR > 1 && $3 == "0x2" { print $1, $4, $6 }' "$PROC/net/arp"; } | awk -v wan="$wan" '
		/^---$/ { f = 1; next }
		!f { nm[$1] = $2; next }
		$3 == wan && !($1 in nm) { next }   # на WAN-интерфейсе только клиенты из аренд DHCP (схема «на одной ноге»)
		{ n++; printf "• %s: %s (%s)\n", ($1 in nm && nm[$1] != "" ? nm[$1] : "без имени"), $1, $2 }
		END { if (!n) print "Устройств не видно." }' | head -n 40)
	reply "🖥 В сети сейчас:
$out"
}

cmd_traffic() {
	[ -s "$DIR/dev.day" ] || { reply "Данных о трафике за сегодня пока нет."; return; }
	out=$( { names; echo ---; cat "$DIR/dev.day"; } | awk "$BYTES"'
		/^---$/ { f = 1; next }
		!f { nm[$1] = $2; next }
		NF >= 3 { n++; if (n > 8) next; printf "• %s: ↓ %s, ↑ %s\n", ($1 in nm && nm[$1] != "" ? nm[$1] : $1), fb($2), fb($3) }')
	reply "📈 Трафик устройств за сегодня:
$out"
}

cmd_apps() {
	[ "$(cfg APPS)" = 1 ] || { reply "Учёт по приложениям выключен. Включите его в карточке «Трафик по приложениям» на странице «Обзор»."; return; }
	[ -s "$DIR/apps.day" ] || { reply "Данных по приложениям пока нет."; return; }
	out=$(awk -F'|' "$BYTES"'
		NF >= 4 { a = $2; if (a ~ /^Прочее/) a = "Прочее"; d[a] += $3; u[a] += $4 }
		END { for (a in d) printf "%d|%s|%s\n", d[a] + u[a], a, fb(d[a] + u[a]) }' "$DIR/apps.day" | sort -t'|' -k1,1nr | head -n 10 | awk -F'|' '{ printf "• %s: %s\n", $2, $3 }')
	reply "📱 Трафик по приложениям за сегодня:
$out"
}

cmd_speed() {
	l=$(tail -n 1 "$DIR/speed.log" 2>/dev/null)
	[ -n "$l" ] || { reply "⚡ Замеров скорости пока нет. Нажмите «Замерить сейчас»." "$KB_SPEED"; return; }
	set -- $l
	when=$(date -d "@$1" '+%d.%m %H:%M' 2>/dev/null || echo "$1")
	if [ "$6" = fail ]; then reply "⚡ Замер от $when не удался: нет связи или скорость слишком низкая. Попробуйте ещё раз." "$KB_SPEED"; return; fi
	reply "⚡ Последний замер скорости ($when): $(awk -v m="$2" 'BEGIN { printf "%.0f Мбит/с", m }')" "$KB_SPEED"
}
# замер по кнопке: роутер качает тестовый файл около 12 секунд; когда закончит, это же сообщение покажет результат
cmd_speedrun() {
	"$SPEEDBIN" start >/dev/null 2>&1
	reply "⏳ Замеряю скорость…
Роутер качает тестовый файл, это займёт секунд 15." ""
	[ -n "$MID" ] || MID=$LASTID
	( i=0
	  while [ "$i" -lt 45 ]; do
		sleep 1; i=$((i + 1))
		p=$(cat "$DIR/speed.lock" 2>/dev/null); [ -n "$p" ] && [ -d "$PROC/$p" ] || break
	  done
	  cmd_speed ) >/dev/null 2>&1 &
}

# ---- гостевой Wi-Fi по таймеру ----
cmd_guest() {  # cmd_guest [ПРИПИСКА]
	l=$("$GUEST" cands 2>/dev/null)
	if [ -z "$l" ]; then
		reply "${1:+$1

}📶 Гостевая сеть по таймеру: подходящих сетей не найдено.
Создайте отдельную сеть Wi-Fi (например, guest) в «Сеть → Беспроводная сеть», и здесь появятся кнопки включения." "$KB_BACK"; return
	fi
	txt=""; rows=""; n=0
	while IFS='|' read -r id ssid en until; do
		[ -n "$id" ] || continue
		n=$((n + 1)); [ "$n" -le 5 ] || break
		if [ "$en" = 1 ]; then
			if [ -n "$until" ]; then st="включена до $(date -d "@$until" +%H:%M 2>/dev/null)"; else st="включена, без таймера"; fi
			rows="$rows[{\"text\":\"⏹ Выключить $ssid\",\"callback_data\":\"gs:off:$id\"}],"
			ic="🟢"
		else
			st="выключена"; ic="⚪"
			rows="$rows[{\"text\":\"📶 $ssid · 1 ч\",\"callback_data\":\"gs:on:$id:60\"},{\"text\":\"4 ч\",\"callback_data\":\"gs:on:$id:240\"},{\"text\":\"Сутки\",\"callback_data\":\"gs:on:$id:1440\"}],"
		fi
		txt="$txt$ic $ssid: $st
"
	done <<EOF
$l
EOF
	reply "${1:+$1

}📶 Гостевой Wi-Fi
$txt
Включённая сеть выключится сама по таймеру." "{\"inline_keyboard\":[${rows}[{\"text\":\"⬅️ Меню\",\"callback_data\":\"menu\"}]]}"
}
cb_guest() {  # cb_guest on|off ID [МИНУТЫ]
	case "$1" in
	on) case "$3" in ''|*[!0-9]*) cmd_guest "Неверное время."; return ;; esac
		r=$("$GUEST" on "$2" "$3" 2>/dev/null); ok="✅ Гостевая сеть включается, появится через несколько секунд." ;;
	off) r=$("$GUEST" off "$2" 2>/dev/null); ok="✅ Гостевая сеть выключается." ;;
	*) cmd_guest; return ;;
	esac
	case "$r" in
		*'"ok":true'*) cmd_guest "$ok" ;;
		*) cmd_guest "⚠️ Не получилось: $(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')" ;;
	esac
}

# ---- перезапуск служб (с подтверждением, одноразовым и на минуту) ----
svc_name() { case "$1" in wifi) echo "Wi-Fi" ;; dns) echo "DHCP и DNS" ;; fw) echo "брандмауэр" ;; net) echo "сеть" ;; esac; }
cmd_services() { reply "🔁 Перезапуск служб. Что перезапустить?" "$KB_SVC"; }
cb_restart_ask() {  # cb_restart_ask wifi|dns|fw|net
	nm=$(svc_name "$1"); [ -n "$nm" ] || { cmd_services; return; }
	echo "$1 $(date +%s)" > "$DIR/restart.ask"
	extra=""; case "$1" in net) extra=" Связь с роутером пропадёт примерно на 30 секунд." ;; wifi) extra=" Wi-Fi устройства отключатся на несколько секунд." ;; esac
	reply "🔁 Перезапустить: $nm?$extra Подтвердите в течение минуты." "{\"inline_keyboard\":[[{\"text\":\"✅ Да, перезапустить\",\"callback_data\":\"rs:y:$1\"},{\"text\":\"Отмена\",\"callback_data\":\"svc\"}]]}"
}
cb_restart_do() {  # cb_restart_do wifi|dns|fw|net
	set -- "$1" $(cat "$DIR/restart.ask" 2>/dev/null); rm -f "$DIR/restart.ask"   # подтверждение одноразовое
	case "$3" in ''|*[!0-9]*) reply "⌛ Подтверждение устарело. Запросите перезапуск заново." "$KB_SVC"; return ;; esac
	[ "$2" = "$1" ] && [ $(( $(date +%s) - $3 )) -le 60 ] || { reply "⌛ Подтверждение устарело. Запросите перезапуск заново." "$KB_SVC"; return; }
	case "$1" in
		wifi) c="$WIFI reload" ;;
		dns) c="$INITD/dnsmasq restart" ;;
		fw) c="$INITD/firewall restart" ;;
		net) c="$INITD/network restart" ;;
		*) cmd_services; return ;;
	esac
	reply "🔁 Перезапускаю: $(svc_name "$1")…" "$KB_BACK"
	( sleep 2; $c ) >/dev/null 2>&1 &
}

# ---- очистка чата ----
cmd_clear() {
	old="$(cat "$MSGS" 2>/dev/null) $MID $UMID"; : > "$MSGS"
	MID=""; reply "🧹 Чат очищен. Меню $HOST:"
	purge $old
}

cmd_menu() { reply "Меню $HOST. Выберите действие:"; }

# список устройств с кнопками: нажатие отключает или возвращает интернет устройству
cmd_block() {  # cmd_block [ПРЕФИКС]
	j=$("$BLOCK" list 2>/dev/null)
	rows=$(printf '%s' "$j" | sed 's/},{"mac"/}\n{"mac"/g' | awk '
		function g(k,   s) { if (match($0, "\"" k "\":\"[^\"]*\"")) return substr($0, RSTART + length(k) + 4, RLENGTH - length(k) - 5); return "" }
		/"mac":"/ {
			m = g("mac"); nm = g("name"); ip = g("ip"); on = ($0 ~ /"online":true/); bl = ($0 ~ /"active":true/); sc = (g("from") != ""); qt = ($0 !~ /"quota":0,/)
			if (nm == "") nm = ip; if (nm == "") nm = m
			if (!on && !bl && !sc && !qt) next
			rk = (bl ? 0 : (on ? 1 : 2)); gsub(/:/, "", m)
			printf "%d|[{\"text\":\"%s%s%s\",\"callback_data\":\"tb:%s\"}]\n", rk, (bl ? "🔴 " : (on ? "🟢 " : "⚪ ")), nm, (sc ? " ⏰" : "") (qt ? " 📉" : ""), m
		}' | sort -t'|' -k1,1n | head -n 14 | cut -d'|' -f2- | paste -sd, -)
	if [ -z "$rows" ]; then reply "${1:+$1

}Устройств не видно."; return; fi
	reply "${1:+$1

}🚫 Нажмите на устройство, чтобы отключить или вернуть ему интернет.
🟢 в сети   🔴 отключено   ⏰ расписание   📉 лимит (расписание и лимиты задаются в теме на странице «Обзор»)" "{\"inline_keyboard\":[$rows,[{\"text\":\"👥 Группы\",\"callback_data\":\"gr\"},{\"text\":\"📜 Журнал\",\"callback_data\":\"bl\"}],[{\"text\":\"« Меню\",\"callback_data\":\"menu\"}]]}"
}

# группы устройств (создаются в теме: Состояние → Устройства): одна кнопка отключает или возвращает интернет всей группе
cmd_groups() {  # cmd_groups [СООБЩЕНИЕ]
	rows=$("$BLOCK" groups 2>/dev/null | sed 's/},{"name"/}\n{"name"/g' | awk '
		function g(k,   s) { if (match($0, "\"" k "\":\"[^\"]*\"")) return substr($0, RSTART + length(k) + 4, RLENGTH - length(k) - 5); return "" }
		/"name":"/ {
			nm = g("name"); man = ($0 ~ /"manual":true/); sc = (g("from") != ""); qt = ($0 !~ /"quota":0,/)
			printf "[{\"text\":\"%s%s%s\",\"callback_data\":\"gt:%d\"}]\n", (man ? "🔴 " : "🟢 "), nm, (sc ? " ⏰" : "") (qt ? " 📉" : ""), n++
		}' | head -n 12 | paste -sd, -)
	if [ -z "$rows" ]; then reply "${1:+$1

}Групп пока нет. Создайте их в теме: Состояние → Устройства (например «Дети»), и тут появятся кнопки." '{"inline_keyboard":[[{"text":"« Блокировка","callback_data":"block"},{"text":"« Меню","callback_data":"menu"}]]}'; return; fi
	reply "${1:+$1

}👥 Нажмите на группу, чтобы отключить или вернуть интернет всем её устройствам.
🟢 работает   🔴 отключена   ⏰ расписание   📉 лимит" "{\"inline_keyboard\":[$rows,[{\"text\":\"« Блокировка\",\"callback_data\":\"block\"},{\"text\":\"« Меню\",\"callback_data\":\"menu\"}]]}"
}

cb_gtoggle() {  # cb_gtoggle НОМЕР_ГРУППЫ
	case "$1" in ''|*[!0-9]*) cmd_groups "Неверная группа."; return ;; esac
	obj=$("$BLOCK" groups 2>/dev/null | sed 's/},{"name"/}\n{"name"/g' | grep '"name":"' | sed -n "$(($1 + 1))p")
	nm=$(printf '%s' "$obj" | sed -n 's/.*"name":"\([^"]*\)".*/\1/p')
	[ -n "$nm" ] || { cmd_groups "Такой группы уже нет."; return; }
	case "$obj" in
	*'"manual":true'*) r=$(NF_BY=бот "$BLOCK" gunblock "$nm" 2>/dev/null); msg="✅ Группа «$nm»: интернет возвращён" ;;
	*) r=$(NF_BY=бот "$BLOCK" gblock "$nm" 2>/dev/null); msg="🔴 Группа «$nm»: интернет отключён" ;;
	esac
	case "$r" in *'"ok":true'*) cmd_groups "$msg" ;; *) cmd_groups "Не получилось: $(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')" ;; esac
}

cb_toggle() {  # cb_toggle MAC без двоеточий
	mac=$(printf '%s' "$1" | sed 's/^\(..\)\(..\)\(..\)\(..\)\(..\)\(..\)$/\1:\2:\3:\4:\5:\6/')
	printf '%s' "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || { cmd_block "Неверный адрес устройства."; return; }
	obj=$("$BLOCK" list 2>/dev/null | sed 's/},{"mac"/}\n{"mac"/g' | grep "\"mac\":\"$mac\"" | head -n 1)
	nm=$(printf '%s' "$obj" | sed -n 's/.*"name":"\([^"]*\)".*/\1/p'); [ -n "$nm" ] || nm=$(printf '%s' "$obj" | sed -n 's/.*"ip":"\([^"]*\)".*/\1/p'); [ -n "$nm" ] || nm=$mac
	case "$obj" in
	*'"active":true'*) r=$(NF_BY=бот "$BLOCK" unblock "$mac" 2>/dev/null); msg="✅ $nm: интернет возвращён" ;;
	*) r=$(NF_BY=бот "$BLOCK" block "$mac" "$nm" 2>/dev/null); msg="🔴 $nm: интернет отключён" ;;
	esac
	case "$r" in *'"ok":true'*) cmd_block "$msg" ;; *) cmd_block "Не получилось: $(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')" ;; esac
}

# кнопки под сообщением о новом устройстве
cb_newdev() {  # cb_newdev ok|bk|ub MAC_без_двоеточий
	mac=$(printf '%s' "$2" | sed 's/^\(..\)\(..\)\(..\)\(..\)\(..\)\(..\)$/\1:\2:\3:\4:\5:\6/')
	printf '%s' "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || { reply "Неверный адрес устройства."; return; }
	kbu="{\"inline_keyboard\":[[{\"text\":\"↩️ Вернуть интернет\",\"callback_data\":\"ub:$2\"}]]}"
	case "$1" in
	ok) reply "👍 Устройство $mac отмечено как своё." "" ;;
	bk) r=$(NF_BY=бот "$BLOCK" block "$mac" 2>/dev/null); case "$r" in *'"ok":true'*) reply "🔴 Устройству $mac отключён интернет." "$kbu" ;; *) reply "Не получилось: $(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')" "" ;; esac ;;
	ub) r=$(NF_BY=бот "$BLOCK" unblock "$mac" 2>/dev/null); case "$r" in *'"ok":true'*) reply "✅ Устройству $mac интернет возвращён." "" ;; *) reply "Не получилось вернуть интернет." "" ;; esac ;;
	esac
}

# Wake-on-LAN: выключенные устройства с кнопками, нажатие отправляет сигнал на включение
cmd_wake() {  # cmd_wake [СООБЩЕНИЕ]
	rows=$("$BLOCK" list 2>/dev/null | sed 's/},{"mac"/}\n{"mac"/g' | awk '
		function g(k) { if (match($0, "\"" k "\":\"[^\"]*\"")) return substr($0, RSTART + length(k) + 4, RLENGTH - length(k) - 5); return "" }
		/"mac":"/ {
			if ($0 ~ /"online":true/) next
			m = g("mac"); nm = g("name"); ip = g("ip"); if (nm == "") nm = ip; if (nm == "") nm = m
			gsub(/:/, "", m); printf "[{\"text\":\"⏻ %s\",\"callback_data\":\"wk:%s\"}]\n", nm, m
		}' | head -n 12 | paste -sd, -)
	if [ -z "$rows" ]; then reply "${1:+$1

}Сейчас все известные устройства в сети, включать нечего." '{"inline_keyboard":[[{"text":"« Меню","callback_data":"menu"}]]}'; return; fi
	reply "${1:+$1

}⏻ Нажмите на устройство, чтобы включить его по сети (Wake-on-LAN). Функция должна быть включена в самом устройстве: в BIOS и в настройках сетевой карты." "{\"inline_keyboard\":[$rows,[{\"text\":\"« Меню\",\"callback_data\":\"menu\"}]]}"
}

cb_wake() {  # cb_wake MAC без двоеточий
	mac=$(printf '%s' "$1" | sed 's/^\(..\)\(..\)\(..\)\(..\)\(..\)\(..\)$/\1:\2:\3:\4:\5:\6/')
	printf '%s' "$mac" | grep -qE '^([0-9a-f]{2}:){5}[0-9a-f]{2}$' || { cmd_wake "Неверный адрес устройства."; return; }
	r=$("$WOL" send "$mac" 2>/dev/null)
	case "$r" in
	*'"ok":true'*) cmd_wake "✅ Сигнал на включение отправлен ($mac). Компьютеру нужно 10–30 секунд." ;;
	*) cmd_wake "Не получилось: $(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')" ;;
	esac
}

cmd_blocklog() {
	out=$("$BLOCK" log plain 2>/dev/null | while IFS='|' read -r ts nm ev why; do
		[ "$ev" = on ] && ev="🔴 отключён" || ev="🟢 возвращён"
		printf '• %s %s: %s (%s)\n' "$(date -d "@$ts" '+%d.%m %H:%M' 2>/dev/null)" "$nm" "$ev" "$why"
	done)
	reply "📜 Журнал блокировок:
${out:-Записей пока нет.}" '{"inline_keyboard":[[{"text":"« Блокировка","callback_data":"block"},{"text":"« Меню","callback_data":"menu"}]]}'
}

cmd_backup() {
	reply "💾 Готовлю резервную копию настроек…" ""
	r=$("$NOTIFY" backup 2>/dev/null)
	case "$r" in *'"ok":true'*) reply "💾 Резервная копия отправлена отдельным сообщением с файлом. Токен бота в неё не входит." ;; *) reply "Не получилось отправить копию: $(printf '%s' "$r" | sed -n 's/.*"error":"\([^"]*\)".*/\1/p')" ;; esac
}

cmd_reboot() { date +%s > "$DIR/reboot.ask"; reply "🔄 Перезагрузить $HOST? Интернет пропадёт примерно на 1–2 минуты. Подтвердите в течение минуты." "$KB_REBOOT"; }
do_reboot() {
	ask=$(cat "$DIR/reboot.ask" 2>/dev/null); rm -f "$DIR/reboot.ask"   # подтверждение одноразовое и живёт минуту
	case "$ask" in ''|*[!0-9]*) reply "⌛ Подтверждение устарело. Запросите перезагрузку заново."; return ;; esac
	[ $(( $(date +%s) - ask )) -le 60 ] || { reply "⌛ Подтверждение устарело. Запросите перезагрузку заново."; return; }
	reply "🔄 Перезагружаю. Вернусь через пару минут." ""; ( sleep 2; $REBOOT ) >/dev/null 2>&1 &
}

# ежедневный отчёт: nightfall-bot report печатает текст (отправляет его сборщик в заданное время)
cmd_report() {
	now=$(date +%s); since=$((now - 86400))
	tt=$(awk "$BYTES"'{ d += $2; u += $3 } END { printf "↓ %s, ↑ %s", fb(d), fb(u) }' "$DIR/dev.day" 2>/dev/null)
	[ -s "$DIR/dev.day" ] || tt="нет данных"
	devs=$( { names; echo ---; cat "$DIR/dev.day" 2>/dev/null; } | awk "$BYTES"'
		/^---$/ { f = 1; next }
		!f { nm[$1] = $2; next }
		NF >= 3 { n++; if (n > 5) next; printf "• %s: %s\n", ($1 in nm && nm[$1] != "" ? nm[$1] : $1), fb($2 + $3) }')
	apps=""
	if [ "$(cfg APPS)" = 1 ] && [ -s "$DIR/apps.day" ]; then
		apps=$(awk -F'|' "$BYTES"'
			NF >= 4 { a = $2; if (a ~ /^Прочее/) a = "Прочее"; t[a] += $3 + $4 }
			END { for (a in t) printf "%d|%s|%s\n", t[a], a, fb(t[a]) }' "$DIR/apps.day" | sort -t'|' -k1,1nr | head -n 5 | awk -F'|' '{ printf "• %s: %s\n", $2, $3 }')
	fi
	ev=$(awk -F'|' -v s="$since" '$1 >= s && ($2 == "warn" || $2 == "bad") { print $1 "|" $3 }' "$DIR/events.log" 2>/dev/null)
	evn=$(printf '%s' "$ev" | grep -c .)
	evt=""
	if [ "$evn" -gt 0 ]; then
		evt=$(printf '%s\n' "$ev" | tail -n 5 | while IFS='|' read -r ts tx; do printf '• %s %s\n' "$(date -d "@$ts" '+%H:%M' 2>/dev/null)" "$tx"; done)
	fi
	tmax=$(awk -v s="$since" '$1 >= s && $4 >= 0 { if ($4 > m) m = $4; f = 1 } END { if (f) printf "%d °C", m; else print "н/д" }' "$DIR/hist.coarse" 2>/dev/null)
	cl=$(awk -v w="$(sed -n 's/^wan_dev=//p' "$DIR/info" 2>/dev/null | head -n 1)" 'FILENAME == ARGV[1] { l[$3] = 1; next } FNR > 1 && $3 == "0x2" && ($6 != w || ($1 in l)) { n++ } END { print n + 0 }' "${LEASES:-/tmp/dhcp.leases}" "$PROC/net/arp" 2>/dev/null)
	up=$(awk '{ print int($1) }' "$PROC/uptime" 2>/dev/null)
	reply "🗓 Отчёт за сутки · $HOST
Трафик сегодня: $tt
${devs:+
Устройства:
$devs
}${apps:+
Приложения:
$apps
}
$([ "$evn" -gt 0 ] && printf 'Предупреждений за сутки: %s\n%s' "$evn" "$evt" || echo 'Предупреждений за сутки не было ✅')
Температура (максимум): ${tmax:-н/д}
Устройств в сети: $cl
Работает без перезагрузки: $(dur "${up:-0}")"
}

cmd_help() {
	reply "Бот $HOST. Всё управляется кнопками под сообщениями: /menu открывает меню.
Команды тоже работают: /status /clients /traffic /apps /speed /block /guest /wake /restart /clear /reboot /report"
}

# управлять ботом может владелец. В личном чате это сам TG_CHAT, в группе (id начинается с «-») только люди из TG_USERS:
# в группе чат один на всех, и без этой проверки перезагрузить роутер мог бы любой её участник
is_admin() {  # is_admin ID_ОТПРАВИТЕЛЯ
	case "$CHAT" in -*) ;; *) [ "$1" = "$CHAT" ]; return ;; esac
	case ",$USERS," in *",$1,"*) return 0 ;; esac
	return 1
}

run() {  # run КОМАНДА (из текста «/status» или из кнопки «status»)
	case "$1" in
	block|wk|wake|wk:*|gr|gt:*|bk|backup|bk:*|ok:*|ub:*|tb:*|rb|reboot|rb:yes|sp:run|gs|guest|gs:*|svc|restart|rs:*|cl|clear)
		[ "$ADM" = 1 ] || { reply "🔒 Управление доступно только администраторам. Ваш id: ${FROM:-неизвестен}. Владелец может добавить его в настройку TG_USERS (Монитор → История → Настройки)." ""; return; } ;;
	esac
	case "$1" in
		start|menu|help) if [ "$1" = help ]; then cmd_help; else cmd_menu; fi ;;
		status) cmd_status ;;
		clients) cmd_clients ;;
		traffic) cmd_traffic ;;
		apps) cmd_apps ;;
		speed) cmd_speed ;;
		sp:run) cmd_speedrun ;;
		gs|guest) cmd_guest ;;
		gs:*) a=${1#gs:}; k=${a%%:*}; a=${a#*:}; cb_guest "$k" "${a%%:*}" "$(case "$a" in *:*) echo "${a#*:}" ;; esac)" ;;
		svc|restart) cmd_services ;;
		rs:y:*) cb_restart_do "${1#rs:y:}" ;;
		rs:*) cb_restart_ask "${1#rs:}" ;;
		cl|clear) cmd_clear ;;
		block) cmd_block ;;
		bl) cmd_blocklog ;;
		wk|wake) cmd_wake ;;
		wk:*) cb_wake "${1#wk:}" ;;
		gr) cmd_groups ;;
		gt:*) cb_gtoggle "${1#gt:}" ;;
		bk) cmd_backup ;;
		backup) cmd_backup ;;
		ok:*|bk:*|ub:*) cb_newdev "${1%%:*}" "${1#*:}" ;;
		rb|reboot) cmd_reboot ;;
		rb:yes) do_reboot ;;
		report) cmd_report ;;
		tb:*) cb_toggle "${1#tb:}" ;;
		*) reply "Не знаю такой команды. Откройте /menu." ;;
	esac
}

handle() {  # handle ТЕКСТ
	c=$(printf '%s' "$1" | awk '{ print $1 }' | sed 's/@.*//' | tr 'A-Z' 'a-z')
	case "$c" in
		/*) run "${c#/}" ;;
		*) cmd_menu ;;
	esac
}

# разбор ответа getUpdates: строки «update_id|chat_id|id_отправителя|id_нажатия|данные_кнопки|id_сообщения|id_запроса_виджета|текст»
parse() {
	tr '\n' ' ' | sed 's/{"update_id":/\n&/g' | awk '
		/^\{"update_id":/ {
			id = $0; sub(/^\{"update_id":/, "", id); sub(/[^0-9].*/, "", id)
			chat = ""; if (match($0, /"chat":\{"id":-?[0-9]+/)) chat = substr($0, RSTART + 13, RLENGTH - 13)
			frm = ""; if (match($0, /"from":\{"id":[0-9]+/)) frm = substr($0, RSTART + 13, RLENGTH - 13)   # первый «from» в обновлении это человек, а не бот
			cb = ""; dt = ""; mid = ""
			if (match($0, /"callback_query":\{"id":"[^"]*"/)) {
				cb = substr($0, RSTART + 24, RLENGTH - 25)
				if (match($0, /"data":"[^"]*"/)) dt = substr($0, RSTART + 8, RLENGTH - 9)
			}
			if (match($0, /"message":\{"message_id":[0-9]+/)) mid = substr($0, RSTART + 24, RLENGTH - 24)
			wq = ""
			if (match($0, /"widget_query":\{"id":"[^"]*"/)) {   # запрос из виджета: id, данные и сообщение
				wq = substr($0, RSTART + 22, RLENGTH - 23)
				if (match($0, /"data":"[^"]*"/)) dt = substr($0, RSTART + 8, RLENGTH - 9)
				if (match($0, /"message_id":[0-9]+/)) mid = substr($0, RSTART + 13, RLENGTH - 13)
			}
			txt = ""
			if (cb == "" && wq == "" && match($0, /"text":"[^"]*"/)) txt = substr($0, RSTART + 8, RLENGTH - 9)
			print id "|" chat "|" frm "|" cb "|" dt "|" mid "|" wq "|" txt
		}'
}

if [ "$1" = report ]; then reply() { printf '%s\n' "$1"; }; cmd_report; exit 0; fi

[ -n "$CHAT" ] || { echo "TG_CHAT не задан" >&2; exit 1; }

# меню команд в Telegram (кнопка «Меню» у бота)
"$NOTIFY" raw setMyCommands -d 'commands=[{"command":"menu","description":"Меню с кнопками"},{"command":"status","description":"Состояние роутера"},{"command":"clients","description":"Кто в сети"},{"command":"traffic","description":"Трафик устройств"},{"command":"apps","description":"Трафик по приложениям"},{"command":"block","description":"Блокировка устройств"},{"command":"guest","description":"Гостевой Wi-Fi"},{"command":"clear","description":"Очистить чат"},{"command":"report","description":"Отчёт за сутки"},{"command":"reboot","description":"Перезагрузить роутер"}]' >/dev/null 2>&1

date +%s > "$DIR/bot.start"; rm -f "$DIR/bot.err"
# накопившиеся за время простоя команды пропускаем
off=0
r=$("$NOTIFY" raw getUpdates -d offset=-1 2>/dev/null)
last=$(printf '%s' "$r" | parse | tail -n 1 | cut -d'|' -f1)
[ -n "$last" ] && off=$((last + 1))

fails=0
while :; do
	r=$(NF_TMO=45 "$NOTIFY" raw getUpdates -d "offset=$off" -d timeout=30 -d 'allowed_updates=["message","callback_query","widget_query"]' 2>/dev/null)
	case "$r" in
	*'"ok":true'*)
		fails=0
		printf '%s' "$r" | parse > "$DIR/bot.upd"
		while IFS='|' read -r id chat frm cb dt mid wq txt; do
			[ -n "$id" ] || continue
			off=$((id + 1))
			[ "$chat" = "$CHAT" ] || continue          # чужим не отвечаем
			FROM=$frm; ADM=0; is_admin "$frm" && ADM=1
			if [ -n "$wq" ]; then   # запрос из виджета: ответить надо в течение 15 секунд, состояние хранит бот
				case "$dt" in s) ans=$(status_json) ;; *) ans="" ;; esac
				"$NOTIFY" raw answerWidgetQuery -d "widget_query_id=$wq" --data-urlencode "data=$ans" >/dev/null 2>&1
				continue
			fi
			# «убирать за собой»: в личном чате в чате остаётся один свежий ответ внизу (в группе чужие сообщения не трогаем)
			CLEAN=1; [ "$(cfg TG_CLEAN)" = 0 ] && CLEAN=0; case "$CHAT" in -*) CLEAN=0 ;; esac
			OLD=""
			if [ -n "$cb" ]; then
				"$NOTIFY" raw answerCallbackQuery -d "callback_query_id=$cb" >/dev/null 2>&1 &   # подтверждение нажатия в фоне, чтобы не задерживать ответ
				MID=$mid; UMID=""
				# кнопку нажали на старом ответе, который уже не внизу: присылаем новый, старый удаляем
				if grep -qx "$mid" "$DIR/bot.widgets" 2>/dev/null; then OLD="$mid"; MID=""   # кнопка под виджетом: его правкой не заменить, присылаем новое сообщение
				elif [ "$CLEAN" = 1 ] && grep -qx "$mid" "$MSGS" 2>/dev/null && [ "$(tail -n 1 "$MSGS")" != "$mid" ]; then OLD=$(cat "$MSGS"); : > "$MSGS"; MID=""; fi
				run "$dt"; MID=""
			else
				UMID=$mid; [ -z "$UMID" ] || track "$UMID"
				if [ "$CLEAN" = 1 ]; then OLD=$(cat "$MSGS"); : > "$MSGS"; fi
				handle "$txt"; UMID=""
			fi
			[ -z "$OLD" ] || purge $OLD
		done < "$DIR/bot.upd" ;;
	*)
		fails=$((fails + 1)); d=$((fails * 10)); [ "$d" -le 120 ] || d=120
		printf '%s %s\n' "$(date +%s)" "$(printf '%s' "$r" | head -c 300 | tr -d '\n')" > "$DIR/bot.err"   # последняя ошибка: смотреть командой cat /tmp/nightfall/bot.err
		[ -n "$NF_NOSLEEP" ] || sleep "$d" ;;
	esac
	[ -n "$NF_ONCE" ] && break
done
