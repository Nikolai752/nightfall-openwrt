#!/bin/sh
# Build a bounded, time-aware IP -> application map from dnsmasq query/reply logs.
# Format: ip|application|last_seen_epoch. Old two-column maps are intentionally discarded.
set -eu
RULES=${1:-/usr/share/nightfall/apps.list}
USER_RULES=${2:-/etc/nightfall-apps.list}
MAP=${3:-/tmp/nightfall/dns.map}
NOW=${4:-$(date +%s)}
TMP="${MAP}.tmp.$$"
trap 'rm -f "$TMP"' EXIT HUP INT TERM
mkdir -p "${MAP%/*}" 2>/dev/null || :
awk -v rules="$RULES" -v urules="$USER_RULES" -v map="$MAP" -v now="$NOW" '
function load(f,   l,a,n,d,i) {
  while ((getline l < f) > 0) {
    if (l ~ /^#/ || l == "") continue
    n=split(l,a,"|"); if (n < 2 || a[1] == "") continue
    split(a[2],d," "); for(i in d) if (!(d[i] in dom)) dom[d[i]]=a[1]
  }
  close(f)
}
function cls(n,   p) {
  n=tolower(n); sub(/\.$/,"",n)
  while (1) { if (n in dom) return dom[n]; p=index(n,"."); if (!p) return ""; n=substr(n,p+1) }
}
function sld(n,   p,k) {
  n=tolower(n); gsub(/[^a-z0-9.-]/,"",n); sub(/\.$/,"",n)
  k=split(n,p,".")
  if (k<=2) return n
  if (length(p[k])==2 && p[k-1] ~ /^(co|com|net|org|gov|edu|ac)$/) return p[k-2] "." p[k-1] "." p[k]
  return p[k-1] "." p[k]
}
function put(ip,app,key) {
  if (ip=="" || app=="") return
  key=ip SUBSEP app
  seen[key]=now
}
BEGIN {
  load(urules); load(rules)
  # Keep only observations made in the last six hours. Old two-column maps expire on upgrade.
  while ((getline l < map)>0) {
    n=split(l,a,"|")
    if (n>=3 && a[3] ~ /^[0-9]+$/ && a[3]+0 >= now-21600 && a[1]!="" && a[2]!="") {
      app=a[2]
      # Re-evaluate retained fallback domain observations against the current catalog.
      # This upgrades existing IP mappings immediately after a catalog update without
      # waiting for another client DNS query; unresolved/shared CDN names stay fallback.
      if (app ~ /^Прочее · /) {
        resolved=cls(substr(app,10))
        if (resolved!="") app=resolved
      }
      put(tolower(a[1]),app)
    }
  }
  close(map)
}
{
  k=0
  for(i=1;i<=NF;i++) if ($i ~ /^query\[/ || $i=="reply" || $i=="cached") { k=i; break }
  if(!k) next
  if($k ~ /^query\[/) { cur=$(k+1); chain=0; next }
  name=$(k+1); v=$(k+3)
  if($(k+2)!="is") next
  if(v=="<CNAME>") { chain=1; next }
  if(v !~ /^[0-9a-fA-F.:]+$/) next
  app=""; if(chain) app=cls(cur); if(app=="") app=cls(name)
  if(app=="") { app=sld(chain ? cur : name); if(app!="" && app ~ /\./) app="Прочее · " app; else app="" }
  if(app!="") put(tolower(v),app)
}
END {
  for(k in seen) { split(k,a,SUBSEP); print a[1] "|" a[2] "|" seen[k] }
}' | sort -t '|' -k3,3nr | head -n 20000 > "$TMP"
mv "$TMP" "$MAP"
trap - EXIT HUP INT TERM
