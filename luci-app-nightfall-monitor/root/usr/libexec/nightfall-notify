#!/bin/sh
# Nightfall: уведомления в Telegram.
#   nightfall-notify send ТЕКСТ   — отправить сообщение (только если TG=1)
#   nightfall-notify test         — отправить проверочное сообщение (JSON-ответ для интерфейса)
#   nightfall-notify chatid       — найти chat id по последнему сообщению боту (JSON-ответ)
# Настройки читаются из /etc/nightfall-monitor.conf: TG, TG_TOKEN, TG_CHAT, TG_PROXY (например socks5h://127.0.0.1:1080), TG_IFACE (интерфейс VPN, например wg0: запросы пойдут через него).
# Не более 30 сообщений в час, чтобы при сбое не завалить чат.
# Для тестов: NF_CONF, NF_DIR, NF_CURL (команда вместо curl).
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
DIR=${NF_DIR:-/tmp/nightfall}
CURL=${NF_CURL:-curl}
ROUTE_BIN=${NF_TG_ROUTE_BIN:-/usr/libexec/nightfall-telegram-route}
TG_USER=${NF_TG_USER:-nightfall-tg}
HOST=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo router)

cfg() { [ -r "$CONF" ] && sed -n "s/^$1=\\"\\{0,1\\}\\([^ #\\"\\]*\\).*/\\1/p" "$CONF" | head -n 1; }
TG=$(cfg TG); TOKEN=$(cfg TG_TOKEN); CHAT=$(cfg TG_CHAT); PROXY=$(cfg TG_PROXY); IFACE=$(cfg TG_IFACE)
TG_ROUTE_READY=0
TG_USE_UID=0
TG_UID=
TG_ROUTE_ERROR=

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 1; }

# api МЕТОД [аргументы curl]: токен передаётся через stdin, чтобы не светиться в списке процессов
json_escape() {
	printf '%s' "$1" | sed 's/\\\\/\\\\\\\\/g; s/"/\\\\"/g; s/[[:cntrl:]]/ /g'
}

route_prepare() {
	[ "$TG_ROUTE_READY" = 1 ] && return 0
	mode=$(cfg TG_ROUTE_MODE)
	proxy=$(cfg TG_PROXY)
	legacy_iface=$(cfg TG_IFACE)
	if [ -z "$mode" ]; then
		if [ -n "$proxy" ]; then mode=proxy
		elif [ -n "$legacy_iface" ]; then mode=vpn
		else mode=system; fi
	fi

	if [ -x "$ROUTE_BIN" ]; then
		route_result=$("$ROUTE_BIN" apply 2>/dev/null)
		case "$route_result" in *'"ok":true'*) ;;
			*)
				TG_ROUTE_ERROR=$(printf '%s' "$route_result" | sed -n 's/.*"error":"\\([^"]*\\)".*/\\1/p' | head -n 1)
				[ -n "$TG_ROUTE_ERROR" ] || TG_ROUTE_ERROR="Не удалось применить маршрут Telegram"
				return 1 ;;
		esac
	else
		# Compatibility with an older package during a partial upgrade.
		if [ -n "$(cfg TG_ROUTE_MODE)" ] || [ -n "$(cfg TG_ROUTE_OUTPUT)" ]; then
			TG_ROUTE_ERROR="Не найден $ROUTE_BIN; обновите пакет Nightfall целиком"
			return 1
		fi
		[ "$mode" != vpn ] || [ -n "$legacy_iface" ] || {
			TG_ROUTE_ERROR="Не найден модуль маршрутизации Telegram"
			return 1
		}
	fi

	case "$mode" in
		system)
			PROXY=
			IFACE=
			TG_USE_UID=0 ;;
		proxy)
			[ -n "$proxy" ] || { TG_ROUTE_ERROR="Для подключения через прокси укажите адрес прокси"; return 1; }
			PROXY=$proxy
			IFACE=
			TG_USE_UID=0 ;;
		vpn)
			if [ ! -x "$ROUTE_BIN" ]; then
				# Legacy TG_IFACE compatibility only when the new helper is absent.
				PROXY=$proxy
				IFACE=$legacy_iface
				TG_USE_UID=0
			else
				PROXY=
				IFACE=
				id "$TG_USER" >/dev/null 2>&1 || { TG_ROUTE_ERROR="Не создан системный пользователь Telegram"; return 1; }
				TG_UID=$(id -u "$TG_USER" 2>/dev/null)
				case "$TG_UID" in ''|*[!0-9]*|0|65534) TG_ROUTE_ERROR="Недопустимый UID пользователя Telegram"; return 1 ;; esac
				command -v su >/dev/null 2>&1 || { TG_ROUTE_ERROR="Не найдена команда su для изолированного VPN-маршрута"; return 1; }
				command -v chown >/dev/null 2>&1 || { TG_ROUTE_ERROR="Не найдена команда chown для временных файлов Telegram"; return 1; }
				TG_USE_UID=1
			fi ;;
		*) TG_ROUTE_ERROR="Неизвестный режим маршрутизации Telegram"; return 1 ;;
	esac
	TG_ROUTE_READY=1
	return 0
}

grant_api_files() {
	[ "$TG_USE_UID" = 1 ] || return 0
	for arg in "$@"; do
		case "$arg" in *@/*)
			file=${arg#*@}
			file=${file%%;*}
			case "$file" in /*) ;; *) continue ;; esac
			[ -f "$file" ] && [ ! -L "$file" ] || continue
			chown "$TG_UID" "$file" 2>/dev/null || {
				TG_ROUTE_ERROR="Не удалось передать временный файл Telegram пользователю $TG_USER"
				return 1
			} ;;
		esac
	done
	return 0
}

api() {
	m=$1; shift
	if ! route_prepare; then
		printf '{"ok":false,"description":"%s"}\n' "$(json_escape "$TG_ROUTE_ERROR")"
		return 0
	fi
	CURL_BIN=$(command -v "$CURL" 2>/dev/null)
	[ -n "$CURL_BIN" ] || { echo '{"ok":false,"description":"не найден curl (apk add curl)"}'; return 0; }
	grant_api_files "$@" || {
		printf '{"ok":false,"description":"%s"}\n' "$(json_escape "$TG_ROUTE_ERROR")"
		return 0
	}
	# Token and proxy credentials remain on curl's stdin, never in argv.
	if [ "$TG_USE_UID" = 1 ]; then
		{ printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$TOKEN" "$m"; } |
			su -s /bin/sh -c 'exec "$0" "$@"' "$TG_USER" -- "$CURL_BIN" -sS -m "${NF_TMO:-25}" -K - "$@" 2>&1
	else
		{ printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$TOKEN" "$m"
		  [ -n "$PROXY" ] && printf 'proxy = "%s"\n' "$PROXY"
		  [ -n "$IFACE" ] && printf 'interface = "%s"\n' "$IFACE"; } |
			"$CURL_BIN" -sS -m "${NF_TMO:-25}" -K - "$@" 2>&1
	fi
}

explain() {  # разбор ответа Telegram: печатает текст ошибки
	d=$(printf '%s' "$1" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -n 1)
	[ -n "$d" ] || d=$(printf '%s' "$1" | head -c 160 | tr -d '"\\\n')
	[ -n "$d" ] || d="нет ответа от api.telegram.org (проверьте доступ или укажите прокси)"
	printf '%s' "$d"
}

post() {  # post ТЕКСТ [КНОПКИ_JSON] -> 0 если доставлено; ответ в $RESP
	t=$(mktemp 2>/dev/null || echo "$DIR/tg.msg"); printf '%s' "$1" > "$t"
	if [ -n "$2" ]; then
		RESP=$(api sendMessage --data-urlencode "chat_id=$CHAT" --data-urlencode "text@$t" --data-urlencode "reply_markup=$2")
	else
		RESP=$(api sendMessage --data-urlencode "chat_id=$CHAT" --data-urlencode "text@$t")
	fi
	rm -f "$t"
	case "$RESP" in *'"ok":true'*) return 0 ;; esac
	return 1
}

case "$1" in
send)
	[ "$TG" = 1 ] && [ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 0
	mkdir -p "$DIR"; now=$(date +%s); rf="$DIR/tg.rate"; cnt=0
	if [ -f "$rf" ]; then
		awk -v n="$now" '$1 > n - 3600' "$rf" > "$rf.t" && mv "$rf.t" "$rf"
		cnt=$(wc -l < "$rf" | tr -d ' ')
	fi
	[ "${cnt:-0}" -lt 30 ] || exit 0
	echo "$now" >> "$rf"
	# сразу после загрузки сеть может быть ещё не готова: до трёх попыток
	for try in 1 2 3; do post "$HOST: $2" "$3" && exit 0; [ -n "$NF_NOSLEEP" ] || sleep 20; done
	exit 1 ;;
test)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	[ -n "$CHAT" ] || fail "не указан chat id"
	if post "✅ $HOST: проверка связи. Уведомления Nightfall работают."; then printf '{"ok":true}\n'
	else fail "$(explain "$RESP")"; fi ;;
chatid)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	RESP=$(api getUpdates)
	case "$RESP" in *'"ok":true'*) ;; *) fail "$(explain "$RESP")" ;; esac
	id=$(printf '%s' "$RESP" | sed -n 's/.*"chat":{"id":\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' | tail -n 1)
	[ -n "$id" ] || fail "Бот пока ничего не получал. Откройте бота в Telegram, нажмите Start или напишите ему любое сообщение и повторите."
	printf '{"ok":true,"chat":"%s"}\n' "$id" ;;
raw)       # raw МЕТОД [аргументы curl]: служебный вызов API для nightfall-bot
	[ -n "$TOKEN" ] || exit 1
	m=$2; shift 2; api "$m" "$@" ;;
reply)     # reply ТЕКСТ [КНОПКИ_JSON]: ответ в чат без лимита и без приставки (для бота)
	[ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 1
	post "$2" "$3"; rc=$?; printf '%s\n' "$RESP"; exit $rc ;;   # ответ Telegram нужен боту, чтобы запомнить id сообщения
widget)    # widget ФАЙЛ_HTML ПОДПИСЬ ДАННЫЕ [КНОПКИ_JSON]: интерактивное сообщение (Bot API 10.4), работает только в личном чате
	[ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 1
	[ -r "$2" ] || exit 1
	t=$(mktemp 2>/dev/null || echo "$DIR/tg.msg"); printf '%s' "$3" > "$t"
	d=$(mktemp 2>/dev/null || echo "$DIR/tg.data"); printf '%s' "$4" > "$d"
	if [ -n "$5" ]; then RESP=$(api sendWidget --data-urlencode "chat_id=$CHAT" --data-urlencode "html@$2" --data-urlencode "caption@$t" --data-urlencode "chat_data@$d" -d allow_queries=true --data-urlencode "reply_markup=$5")
	else RESP=$(api sendWidget --data-urlencode "chat_id=$CHAT" --data-urlencode "html@$2" --data-urlencode "caption@$t" --data-urlencode "chat_data@$d" -d allow_queries=true); fi
	rm -f "$t" "$d"
	printf '%s\n' "$RESP"
	case "$RESP" in *'"ok":true'*) exit 0 ;; esac
	exit 1 ;;
edit)      # edit ID_СООБЩЕНИЯ ТЕКСТ [КНОПКИ_JSON]: заменить текст и кнопки существующего сообщения (быстрее и без россыпи сообщений)
	[ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 1
	t=$(mktemp 2>/dev/null || echo "$DIR/tg.msg"); printf '%s' "$3" > "$t"
	if [ -n "$4" ]; then RESP=$(api editMessageText --data-urlencode "chat_id=$CHAT" -d "message_id=$2" --data-urlencode "text@$t" --data-urlencode "reply_markup=$4")
	else RESP=$(api editMessageText --data-urlencode "chat_id=$CHAT" -d "message_id=$2" --data-urlencode "text@$t" --data-urlencode 'reply_markup={"inline_keyboard":[]}'); fi
	rm -f "$t"
	case "$RESP" in *'"ok":true'*|*'not modified'*) exit 0 ;; esac
	post "$3" "$4"; rc=$?; printf '%s\n' "$RESP"; exit $rc ;;   # старое сообщение не изменить: пришлём новое и отдадим его id боту (он удалит старое)
backup)    # создать проверенный локальный архив (USB при доступности) и отправить его в Telegram
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	[ -n "$CHAT" ] || fail "не указан chat id"
	BACKUP_TOOL=${NF_BACKUP_TOOL:-/usr/libexec/nightfall-backup}
	command -v "$BACKUP_TOOL" >/dev/null 2>&1 || fail "не найден nightfall-backup"
	BR=$("$BACKUP_TOOL" create 2>&1) || fail "$(printf '%s' "$BR" | tail -n 2 | tr -d '"\\')"
	ARCHIVE=$(printf '%s\n' "$BR" | sed -n 's/^Резервная копия создана: //p' | tail -n 1)
	[ -n "$ARCHIVE" ] && [ -f "$ARCHIVE" ] && [ ! -L "$ARCHIVE" ] || fail "резервная копия создана, но архив не найден"
	n=${ARCHIVE##*/}
	# Keep a private server-side reference: callback_data must stay short and must never contain a path.
	mkdir -p "$DIR" || fail "не удалось подготовить каталог состояния"
	umask 077
	id="$(date +%s)$(awk 'BEGIN { srand(); printf "%04d", int(rand()*10000) }')"
	state="$DIR/backup.$id"
	while [ -e "$state" ] || [ -L "$state" ]; do id="${id}1"; state="$DIR/backup.$id"; done
	printf '%s\n' "$ARCHIVE" > "$state" || fail "не удалось сохранить ссылку на архив"
	chmod 600 "$state" 2>/dev/null
	kb='{"inline_keyboard":[[{"text":"🔍 Проверить и восстановить","callback_data":"bk:check:'"$id"'"}]]}'
	UPLOAD=$ARCHIVE
	if [ "$TG_USE_UID" = 1 ]; then
		UPLOAD="$DIR/tg-upload.$"
		cp "$ARCHIVE" "$UPLOAD" 2>/dev/null || fail "не удалось подготовить временную копию для отправки"
		chmod 600 "$UPLOAD" 2>/dev/null
		chown "$TG_UID" "$UPLOAD" 2>/dev/null || { rm -f "$UPLOAD"; fail "не удалось подготовить файл для VPN-маршрута Telegram"; }
	fi
	RESP=$(api sendDocument -F "chat_id=$CHAT" -F "document=@$UPLOAD;filename=$n" -F "caption=Проверенная резервная копия Nightfall. Секреты Telegram исключены. Локальная копия сохранена на роутере." -F "reply_markup=$kb")
	[ "$UPLOAD" = "$ARCHIVE" ] || rm -f "$UPLOAD"
	case "$RESP" in *'"ok":true'*) printf '{"ok":true}\n' ;; *) rm -f "$state"; fail "$(explain "$RESP")" ;; esac ;;
*)
	echo "usage: nightfall-notify send TEXT [KB] | test | chatid | backup" >&2
	exit 1 ;;
esac
