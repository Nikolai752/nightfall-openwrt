#!/bin/sh
# Nightfall: уведомления в Telegram.
#   nightfall-notify send ТЕКСТ   — отправить сообщение (только если TG=1)
#   nightfall-notify test         — отправить проверочное сообщение (JSON-ответ для интерфейса)
#   nightfall-notify chatid       — найти chat id по последнему сообщению боту (JSON-ответ)
# Настройки читаются из /etc/nightfall-monitor.conf: TG, TG_TOKEN, TG_CHAT, TG_PROXY (например socks5h://127.0.0.1:1080), TG_IFACE (интерфейс VPN, например wg0: запросы пойдут через него).
# Не более 30 сообщений в час, чтобы при сбое не завалить чат.
# Для тестов: NF_CONF, NF_DIR, NF_CURL (команда вместо curl).
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
DIR=${NF_DIR:-/tmp/nightfall}
CURL=${NF_CURL:-curl}
HOST=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo router)

cfg() { [ -r "$CONF" ] && sed -n "s/^$1=\"\{0,1\}\([^ #\"]*\).*/\1/p" "$CONF" | head -n 1; }
TG=$(cfg TG); TOKEN=$(cfg TG_TOKEN); CHAT=$(cfg TG_CHAT); PROXY=$(cfg TG_PROXY); IFACE=$(cfg TG_IFACE)

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 1; }

# api МЕТОД [аргументы curl]: токен передаётся через stdin, чтобы не светиться в списке процессов
api() {
	m=$1; shift
	command -v "$CURL" >/dev/null 2>&1 || { echo '{"ok":false,"description":"не найден curl (apk add curl)"}'; return 0; }
	# прокси (в нём может быть логин и пароль) и интерфейс тоже идут через stdin, а не аргументами
	{ printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$TOKEN" "$m"
	  [ -n "$PROXY" ] && printf 'proxy = "%s"\n' "$PROXY"
	  [ -n "$IFACE" ] && printf 'interface = "%s"\n' "$IFACE"; } | "$CURL" -sS -m "${NF_TMO:-25}" -K - "$@" 2>&1
}

explain() {  # разбор ответа Telegram: печатает текст ошибки
	d=$(printf '%s' "$1" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -n 1)
	[ -n "$d" ] || d=$(printf '%s' "$1" | head -c 160 | tr -d '"\\\n')
	[ -n "$d" ] || d="нет ответа от api.telegram.org (проверьте доступ или укажите прокси)"
	printf '%s' "$d"
}

post() {  # post ТЕКСТ [КНОПКИ_JSON] -> 0 если доставлено; ответ в $RESP
	t=$(mktemp 2>/dev/null || echo "$DIR/tg.msg"); printf '%s' "$1" > "$t"
	if [ -n "$2" ]; then
		RESP=$(api sendMessage --data-urlencode "chat_id=$CHAT" --data-urlencode "text@$t" --data-urlencode "reply_markup=$2")
	else
		RESP=$(api sendMessage --data-urlencode "chat_id=$CHAT" --data-urlencode "text@$t")
	fi
	rm -f "$t"
	case "$RESP" in *'"ok":true'*) return 0 ;; esac
	return 1
}

case "$1" in
send)
	[ "$TG" = 1 ] && [ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 0
	mkdir -p "$DIR"; now=$(date +%s); rf="$DIR/tg.rate"; cnt=0
	if [ -f "$rf" ]; then
		awk -v n="$now" '$1 > n - 3600' "$rf" > "$rf.t" && mv "$rf.t" "$rf"
		cnt=$(wc -l < "$rf" | tr -d ' ')
	fi
	[ "${cnt:-0}" -lt 30 ] || exit 0
	echo "$now" >> "$rf"
	# сразу после загрузки сеть может быть ещё не готова: до трёх попыток
	for try in 1 2 3; do post "$HOST: $2" "$3" && exit 0; [ -n "$NF_NOSLEEP" ] || sleep 20; done
	exit 1 ;;
test)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	[ -n "$CHAT" ] || fail "не указан chat id"
	if post "✅ $HOST: проверка связи. Уведомления Nightfall работают."; then printf '{"ok":true}\n'
	else fail "$(explain "$RESP")"; fi ;;
chatid)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	RESP=$(api getUpdates)
	case "$RESP" in *'"ok":true'*) ;; *) fail "$(explain "$RESP")" ;; esac
	id=$(printf '%s' "$RESP" | sed -n 's/.*"chat":{"id":\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' | tail -n 1)
	[ -n "$id" ] || fail "Бот пока ничего не получал. Откройте бота в Telegram, нажмите Start или напишите ему любое сообщение и повторите."
	printf '{"ok":true,"chat":"%s"}\n' "$id" ;;
raw)       # raw МЕТОД [аргументы curl]: служебный вызов API для nightfall-bot
	[ -n "$TOKEN" ] || exit 1
	m=$2; shift 2; api "$m" "$@" ;;
reply)     # reply ТЕКСТ [КНОПКИ_JSON]: ответ в чат без лимита и без приставки (для бота)
	[ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 1
	post "$2" "$3" ;;
edit)      # edit ID_СООБЩЕНИЯ ТЕКСТ [КНОПКИ_JSON]: заменить текст и кнопки существующего сообщения (быстрее и без россыпи сообщений)
	[ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 1
	t=$(mktemp 2>/dev/null || echo "$DIR/tg.msg"); printf '%s' "$3" > "$t"
	if [ -n "$4" ]; then RESP=$(api editMessageText --data-urlencode "chat_id=$CHAT" -d "message_id=$2" --data-urlencode "text@$t" --data-urlencode "reply_markup=$4")
	else RESP=$(api editMessageText --data-urlencode "chat_id=$CHAT" -d "message_id=$2" --data-urlencode "text@$t" --data-urlencode 'reply_markup={"inline_keyboard":[]}'); fi
	rm -f "$t"
	case "$RESP" in *'"ok":true'*|*'not modified'*) exit 0 ;; esac
	post "$3" "$4" ;;                     # старое сообщение не изменить: пришлём новое
backup)    # backup: отправить в чат архив настроек Nightfall (без токена бота)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	[ -n "$CHAT" ] || fail "не указан chat id"
	w=$(mktemp -d 2>/dev/null || { mkdir -p "$DIR/bk" && echo "$DIR/bk"; })
	mkdir -p "$w/etc"
	for f in nightfall-monitor.conf nightfall-prefs.json nightfall-block.list nightfall-block.log nightfall-devices.list nightfall-groups.list nightfall-known.list nightfall-apps.list nightfall-journal.log; do
		[ -r "/etc/$f" ] && cp "/etc/$f" "$w/etc/$f"
	done
	[ -f "$w/etc/nightfall-monitor.conf" ] && sed -i 's/^TG_TOKEN=.*/TG_TOKEN=/' "$w/etc/nightfall-monitor.conf"
	n="nightfall-backup-$HOST-$(date +%Y%m%d).tar.gz"
	tar -czf "$w/$n" -C "$w" etc 2>/dev/null || { rm -rf "$w"; fail "не удалось создать архив (нужен tar)"; }
	RESP=$(api sendDocument -F "chat_id=$CHAT" -F "document=@$w/$n;filename=$n" -F "caption=Резервная копия настроек Nightfall. Токен бота в неё не входит. Восстановление: tar -xzf $n -C /, затем снова укажите токен и перезапустите службу.")
	rm -rf "$w"
	case "$RESP" in *'"ok":true'*) printf '{"ok":true}\n' ;; *) fail "$(explain "$RESP")" ;; esac ;;
*)
	echo "usage: nightfall-notify send TEXT [KB] | test | chatid | backup" >&2
	exit 1 ;;
esac
