#!/bin/sh
# Nightfall: уведомления в Telegram.
#   nightfall-notify send ТЕКСТ   — отправить сообщение (только если TG=1)
#   nightfall-notify test         — отправить проверочное сообщение (JSON-ответ для интерфейса)
#   nightfall-notify chatid       — найти chat id по последнему сообщению боту (JSON-ответ)
# Настройки читаются из /etc/nightfall-monitor.conf: TG, TG_TOKEN, TG_CHAT, TG_PROXY (например socks5h://127.0.0.1:1080), TG_IFACE (интерфейс VPN, например wg0: запросы пойдут через него).
# Не более 30 сообщений в час, чтобы при сбое не завалить чат.
# Для тестов: NF_CONF, NF_DIR, NF_CURL (команда вместо curl).
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
DIR=${NF_DIR:-/tmp/nightfall}
CURL=${NF_CURL:-curl}
HOST=$(cat /proc/sys/kernel/hostname 2>/dev/null || echo router)

cfg() { [ -r "$CONF" ] && sed -n "s/^$1=\"\{0,1\}\([^ #\"]*\).*/\1/p" "$CONF" | head -n 1; }
TG=$(cfg TG); TOKEN=$(cfg TG_TOKEN); CHAT=$(cfg TG_CHAT); PROXY=$(cfg TG_PROXY); IFACE=$(cfg TG_IFACE)

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 1; }

# api МЕТОД [аргументы curl]: токен передаётся через stdin, чтобы не светиться в списке процессов
api() {
	m=$1; shift
	command -v "$CURL" >/dev/null 2>&1 || { echo '{"ok":false,"description":"не найден curl (apk add curl)"}'; return 0; }
	printf 'url = "https://api.telegram.org/bot%s/%s"\n' "$TOKEN" "$m" | "$CURL" -sS -m "${NF_TMO:-25}" ${PROXY:+-x "$PROXY"} ${IFACE:+--interface "$IFACE"} -K - "$@" 2>&1
}

explain() {  # разбор ответа Telegram: печатает текст ошибки
	d=$(printf '%s' "$1" | sed -n 's/.*"description":"\([^"]*\)".*/\1/p' | head -n 1)
	[ -n "$d" ] || d=$(printf '%s' "$1" | head -c 160 | tr -d '"\\\n')
	[ -n "$d" ] || d="нет ответа от api.telegram.org (проверьте доступ или укажите прокси)"
	printf '%s' "$d"
}

post() {  # post ТЕКСТ -> 0 если доставлено; ответ в $RESP
	t=$(mktemp 2>/dev/null || echo "$DIR/tg.msg"); printf '%s' "$1" > "$t"
	RESP=$(api sendMessage --data-urlencode "chat_id=$CHAT" --data-urlencode "text@$t")
	rm -f "$t"
	case "$RESP" in *'"ok":true'*) return 0 ;; esac
	return 1
}

case "$1" in
send)
	[ "$TG" = 1 ] && [ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 0
	mkdir -p "$DIR"; now=$(date +%s); rf="$DIR/tg.rate"; cnt=0
	if [ -f "$rf" ]; then
		awk -v n="$now" '$1 > n - 3600' "$rf" > "$rf.t" && mv "$rf.t" "$rf"
		cnt=$(wc -l < "$rf" | tr -d ' ')
	fi
	[ "${cnt:-0}" -lt 30 ] || exit 0
	echo "$now" >> "$rf"
	# сразу после загрузки сеть может быть ещё не готова: до трёх попыток
	for try in 1 2 3; do post "$HOST: $2" && exit 0; [ -n "$NF_NOSLEEP" ] || sleep 20; done
	exit 1 ;;
test)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	[ -n "$CHAT" ] || fail "не указан chat id"
	if post "✅ $HOST: проверка связи. Уведомления Nightfall работают."; then printf '{"ok":true}\n'
	else fail "$(explain "$RESP")"; fi ;;
chatid)
	[ -n "$TOKEN" ] || fail "не указан токен бота"
	RESP=$(api getUpdates)
	case "$RESP" in *'"ok":true'*) ;; *) fail "$(explain "$RESP")" ;; esac
	id=$(printf '%s' "$RESP" | sed -n 's/.*"chat":{"id":\(-\{0,1\}[0-9]\{1,\}\).*/\1/p' | tail -n 1)
	[ -n "$id" ] || fail "Бот пока ничего не получал. Откройте бота в Telegram, нажмите Start или напишите ему любое сообщение и повторите."
	printf '{"ok":true,"chat":"%s"}\n' "$id" ;;
raw)       # raw МЕТОД [аргументы curl]: служебный вызов API для nightfall-bot
	[ -n "$TOKEN" ] || exit 1
	m=$2; shift 2; api "$m" "$@" ;;
reply)     # reply ТЕКСТ: ответ в чат без лимита и без приставки (для команд бота)
	[ -n "$TOKEN" ] && [ -n "$CHAT" ] || exit 1
	post "$2" ;;
*)
	echo "usage: nightfall-notify send TEXT | test | chatid" >&2
	exit 1 ;;
esac
