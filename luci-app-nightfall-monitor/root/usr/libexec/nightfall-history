#!/bin/sh
# Nightfall history: отдаёт данные сборщика (nightfall-collector) одним JSON-объектом.
#   nightfall-history series fine|coarse|long — графики + события + предупреждения (long — до 90 суток, шаг 30 мин)
#   nightfall-history wifi-hr / devhr      — почасовой сигнал клиентов Wi-Fi / трафик по устройствам
#   nightfall-history devices              — трафик по устройствам
#   nightfall-history alerts               — активные предупреждения и последняя точка
#   nightfall-history apps                 — трафик по приложениям: сегодня и за прошлые сутки
DIR=${NF_DIR:-/tmp/nightfall}

info_json() {
	printf '{'
	[ -r "$DIR/info" ] && awk '{ i = index($0, "="); if (i < 2) next; v = substr($0, i + 1); gsub(/["\\]/, "", v)
		printf "%s\"%s\":\"%s\"", (n++ ? "," : ""), substr($0, 1, i - 1), v }' "$DIR/info"
	printf '}'
}

rows_json() {   # rows_json FILE LIMIT
	printf '['
	[ -r "$1" ] && tail -n "$2" "$1" | awk '{ printf "%s[", (n++ ? "," : ""); for (i = 1; i <= NF; i++) printf "%s%s", (i > 1 ? "," : ""), ($i ~ /^-?[0-9]+(\.[0-9]+)?$/ ? $i : "\"" $i "\""); printf "]" }'
	printf ']'
}

events_json() {
	printf '['
	[ -r "$DIR/events.log" ] && tail -n 80 "$DIR/events.log" | awk -F'|' 'NF >= 3 { printf "%s[%s,\"%s\",\"%s\"]", (n++ ? "," : ""), $1, $2, $3 }'
	printf ']'
}

active_json() {
	printf '['
	[ -r "$DIR/alerts.active" ] && awk -F'|' 'NF >= 4 { printf "%s[\"%s\",%s,\"%s\",\"%s\"]", (n++ ? "," : ""), $1, $2, $3, $4 }' "$DIR/alerts.active"
	printf ']'
}

router_ips() {   # адреса самого роутера через пробел: сохранённые сборщиком (в том числе прежние внешние) и текущие
	{ sed -n 's/^router_ips=//p' "$DIR/info" 2>/dev/null | head -n 1
	  ${NF_IP:-ip} -4 addr show 2>/dev/null | awk '/inet / { split($2, a, "/"); print a[1] }'; } | tr ' ' '\n' | awk 'NF && !s[$1]++ { printf "%s ", $1 }'
}

router_nets() { sed -n 's/^router_nets=//p' "$DIR/info" 2>/dev/null | head -n 1; }
# общие функции awk: mine(ip) — адрес принадлежит самому роутеру (его адреса, в том числе прежние внешние, или внешняя подсеть)
AWKR='function n_(ip,   a) { split(ip, a, "."); return ((a[1] * 256 + a[2]) * 256 + a[3]) * 256 + a[4] }
function mine(ip,   i, x) {
	if (index(rips, " " ip " ")) return 1
	if (ip !~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) return 0
	x = n_(ip); for (i = 1; i <= nn; i++) if (x >= nb[i] && x < nb[i] + ns[i]) return 1
	return 0
}
BEGIN { nn = split(nets, nl, " "); for (i = 1; i <= nn; i++) { split(nl[i], pp, "/"); ns[i] = 2 ^ (32 - pp[2]); b = n_(pp[1]); nb[i] = b - (b % ns[i]) } }
'

devs_json() {   # devs_json FILE [skip-first-line]
	printf '['
	[ -r "$1" ] && awk -v skip="$2" 'NR == 1 && skip { next } NF >= 3 { printf "%s[\"%s\",%s,%s]", (n++ ? "," : ""), $1, $2, $3 }' "$1"
	printf ']'
}

neigh_json() {  # соседи по сети: «адрес → MAC» (IPv4 и IPv6), чтобы привязывать трафик к устройству, а не к адресу
	printf '['
	{ if [ -n "$NF_NEIGH" ]; then cat "$NF_NEIGH"; else ip neigh show 2>/dev/null; fi; } | awk '
		/lladdr/ && $NF != "FAILED" && $NF != "INCOMPLETE" && $1 !~ /^fe80:/ { m = ""; for (i = 1; i < NF; i++) if ($i == "lladdr") m = tolower($(i + 1)); if (m ~ /^[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f])+$/) printf "%s[\"%s\",\"%s\"]", (n++ ? "," : ""), $1, m }'
	printf ']'
}

journal_json() {
	f=${NF_JOURNAL:-/etc/nightfall-journal.log}
	printf '['
	[ -r "$f" ] && tail -n 120 "$f" | awk -F'|' 'NF >= 4 { printf "%s[%s,\"%s\",%s,\"%s\"]", (n++ ? "," : ""), $1, $2, $3 + 0, $4 }'
	printf ']'
}

pairs_json() {  # pairs_json FILE NCOLS_AFTER_TS: строки «ip proto port down up» -> массивы
	printf '['
	[ -r "$1" ] && awk -v skip=1 'NR == 1 { next } NF >= 4 { printf "%s[", (n++ ? "," : ""); for (i = 1; i <= NF; i++) printf "%s\"%s\"", (i > 1 ? "," : ""), $i; printf "]" }' "$1"
	printf ']'
}

now=$(date +%s)
case "$1" in
series)
	case "$2" in coarse) f=hist.coarse; lim=2016 ;; long) f=hist.long; lim=4320 ;; *) f=hist.fine; lim=240 ;; esac
	printf '{"now":%s,"range":"%s","rows":' "$now" "${2:-fine}"
	rows_json "$DIR/$f" "$lim"
	printf ',"events":'; events_json
	printf ',"active":'; active_json
	printf ',"info":'; info_json
	printf '}\n' ;;
devices)
	ts=0; [ -r "$DIR/dev.rate" ] && read -r ts < "$DIR/dev.rate"
	printf '{"now":%s,"ts":%s,"rate":' "$now" "${ts:-0}"
	devs_json "$DIR/dev.rate" 1
	printf ',"day":'; devs_json "$DIR/dev.day"
	printf ',"yday":'; devs_json "$DIR/dev.yday"
	printf ',"neigh":'; neigh_json
	printf ',"info":'; info_json
	printf '}\n' ;;
channel)
	ts=0; [ -r "$DIR/svc.rate" ] && read -r ts < "$DIR/svc.rate"
	printf '{"now":%s,"ts":%s,"svc":' "$now" "${ts:-0}"
	pairs_json "$DIR/svc.rate"
	printf ',"dst":'; pairs_json "$DIR/dst.rate"
	printf ',"router_ips":"%s","router_nets":"%s"}\n' "$(sed -n 's/^router_ips=//p' "$DIR/info" 2>/dev/null | head -n 1)" "$(router_nets)" ;;
apps)
	en=$(sed -n 's/^APPS=\([01]\).*/\1/p' "${NF_CONF:-/etc/nightfall-monitor.conf}" 2>/dev/null | head -n 1)
	dm=0; [ -r "$DIR/dns.map" ] && dm=$(wc -l < "$DIR/dns.map" | tr -d ' ')
	printf '{"now":%s,"enabled":%s,"dnsmap":%s,"today":"%s","day":[' "$now" "${en:-0}" "${dm:-0}" "$(cat "$DIR/day.date" 2>/dev/null)"
	rips=" $(router_ips) "; rnets=$(router_nets)   # трафик самого роутера (VPN, прокси) повторяет трафик устройств, в приложениях его не считаем
	[ -r "$DIR/apps.day" ] && awk -F'|' -v rips="$rips" -v nets="$rnets" "$AWKR"'NF >= 4 && !mine($1) { gsub(/["\\]/, "", $2); printf "%s[\"%s\",\"%s\",%d,%d]", (n++ ? "," : ""), $1, $2, $3, $4 }' "$DIR/apps.day"
	printf '],"hist":['
	[ -r "$DIR/apps.hist" ] && awk -F'|' -v rips="$rips" -v nets="$rnets" "$AWKR"'NF >= 5 && !mine($2) { gsub(/["\\]/, "", $3); printf "%s[\"%s\",\"%s\",\"%s\",%d,%d]", (n++ ? "," : ""), $1, $2, $3, $4, $5 }' "$DIR/apps.hist"
	printf ']}\n' ;;
journal)
	printf '{"now":%s,"rows":' "$now"; journal_json
	up=0; read -r up _ < /proc/uptime; up=${up%.*}
	printf ',"up":%s,"info":' "${up:-0}"; info_json
	printf '}\n' ;;
speed)
	running=false
	[ -f "$DIR/speed.lock" ] && p=$(cat "$DIR/speed.lock" 2>/dev/null) && [ -n "$p" ] && [ -d "/proc/$p" ] && running=true
	printf '{"now":%s,"running":%s,"rows":' "$now" "$running"
	rows_json "$DIR/speed.log" 300
	printf ',"info":'; info_json
	printf '}\n' ;;
wifi)
	printf '{"now":%s,"rows":' "$now"
	# сырые точки только за последний час, всё старше усредняется по 5 минутам: ответ остаётся небольшим даже при 8000 записях
	if [ -r "$DIR/wifi.fine" ]; then
		awk -v mac="$2" -v lim=$((now - 3600)) '
			function flush(   k, a) { for (k in sm) { split(k, a, SUBSEP); printf "%s[%d,\"%s\",%d,\"%s\"]", (n++ ? "," : ""), mt[k], a[1], sm[k] / ct[k], dv[k] } delete sm; delete ct; delete mt; delete dv }
			BEGIN { printf "["; cur = "" }
			mac != "" && $2 != mac { next }
			$3 !~ /^-?[0-9]+$/ { next }
			$1 >= lim { if (cur != "") { flush(); cur = "" } printf "%s[%s,\"%s\",%s,\"%s\"]", (n++ ? "," : ""), $1, $2, $3, $4; next }
			{ b = int($1 / 300); if (b != cur) { if (cur != "") flush(); cur = b } k = $2; sm[k] += $3; ct[k]++; mt[k] = $1; dv[k] = $4 }
			END { if (cur != "") flush(); printf "]" }' "$DIR/wifi.fine"
	else printf '[]'; fi
	printf ',"events":'
	if [ -r "$DIR/wifi.ev" ]; then tail -n 200 "$DIR/wifi.ev" | awk -v mac="$2" 'BEGIN { printf "[" } mac == "" || $2 == mac { printf "%s[%s,\"%s\",\"%s\",\"%s\"]", (n++ ? "," : ""), $1, $2, $3, $4 } END { printf "]" }'; else printf '[]'; fi
	printf ',"info":'; info_json
	printf '}\n' ;;
wifi-check)
	# самопроверка «Качества Wi-Fi»: те же шаги, что у сборщика, но с подсчётом на каждом этапе
	run=0
	if [ -x /etc/init.d/nightfall-collector ] && /etc/init.d/nightfall-collector running >/dev/null 2>&1; then run=1
	elif ps w 2>/dev/null | grep '[n]ightfall-collector' >/dev/null 2>&1; then run=1; fi
	have=0; command -v ubus >/dev/null 2>&1 && ubus list iwinfo >/dev/null 2>&1 && have=1
	lines=0; [ -r "$DIR/wifi.fine" ] && lines=$(wc -l < "$DIR/wifi.fine" | tr -d ' ')
	hist=$(sed -n 's/^wifi_hist=//p' "$DIR/info" 2>/dev/null | head -n 1)
	age=-1
	if [ -f "$DIR/hist.fine" ]; then t=$(stat -c %Y "$DIR/hist.fine" 2>/dev/null); [ -n "$t" ] && age=$(( $(date +%s) - t )); fi
	printf '{"collector":%s,"iwinfo":%s,"hist":"%s","lines":%s,"age":%s,"devs":[' "$run" "$have" "${hist:-}" "${lines:-0}" "$age"
	sample=
	if [ "$have" = 1 ]; then
		sep=
		for d in $(ubus call iwinfo devices 2>/dev/null | awk -F'"' 'NF >= 3 && $2 != "devices" { print $2 }'); do
			raw=$(ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null)
			c=$(printf '%s\n' "$raw" | grep -c '"mac"')
			n=$(printf '%s\n' "$raw" | awk -F'"' '$2 == "mac" { m = $4 } $2 == "signal" && m != "" { s = $3; gsub(/[^-0-9]/, "", s); if (s != "") k++; m = "" } END { print k + 0 }')
			[ "$c" -gt 0 ] && [ "$n" = 0 ] && [ -z "$sample" ] && sample=$(printf '%s\n' "$raw" | head -n 8 | tr -cd 'A-Za-z0-9_:,.{}[ -' | tr '\n' ' ')
			printf '%s["%s",%s,%s]' "$sep" "$d" "${c:-0}" "${n:-0}"; sep=,
		done
	fi
	printf '],"sample":"%s"}\n' "$sample" ;;
wifi-hr)
	printf '{"now":%s,"rows":[' "$now"
	[ -r "$DIR/wifi.hr" ] && awk -v mac="$2" 'NF >= 3 && (mac == "" || $2 == mac) { printf "%s[%s,\"%s\",%d,%d]", (n++ ? "," : ""), $1, $2, $3, $4 }' "$DIR/wifi.hr"
	printf ']}\n' ;;
devhr)
	printf '{"now":%s,"rows":[' "$now"
	[ -r "$DIR/dev.hr" ] && awk -v lim=$((now - 93600)) 'NF >= 4 && $1 >= lim { printf "%s[%s,\"%s\",%d,%d]", (n++ ? "," : ""), $1, $2, $3, $4 }' "$DIR/dev.hr"
	printf ']}\n' ;;
airscan)
	# эфир вокруг роутера: собственные радиоинтерфейсы и соседние сети (для «Загруженности каналов»)
	IW=${NF_IWINFO:-iwinfo}
	if [ -n "$NF_IWDEVS" ]; then devs=$NF_IWDEVS
	else devs=$(ubus call iwinfo devices 2>/dev/null | awk -F'"' 'NF >= 3 && $2 != "devices" { print $2 }'); fi
	printf '{"now":%s,"radios":[' "$now"
	sep=
	for d in $devs; do
		info=$("$IW" "$d" info 2>/dev/null)
		[ -n "$info" ] || continue
		ph=$(printf '%s\n' "$info" | sed -n 's/.*PHY name: *\(phy[0-9]*\).*/\1/p' | head -n 1)
		ht=; ch0=
		if [ -n "$ph" ] && command -v uci >/dev/null 2>&1; then ht=$(uci -q get "wireless.radio${ph#phy}.htmode" 2>/dev/null); ch0=$(uci -q get "wireless.radio${ph#phy}.channel" 2>/dev/null); fi
		printf '%s\n' "$info" | tr -d '\000-\010\013-\037' | awk -v dev="$d" -v ht="$ht" -v ch0="$ch0" -v sep="$sep" '
			/ESSID:/ { q = index($0, "\""); if (q) { t = substr($0, q + 1); e = index(t, "\""); ess = (e ? substr(t, 1, e - 1) : t); gsub(/["\\]/, "", ess) } }
			/Access Point:/ { bs = tolower($NF) }
			/Channel:/ { if (match($0, /Channel: *[0-9]+/)) { ch = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", ch) } if (match($0, /\([0-9.]+ GHz\)/)) { fq = substr($0, RSTART + 1, RLENGTH - 2); gsub(/[^0-9.]/, "", fq) } }
			/Tx-Power:/ { if (match($0, /Tx-Power: *[0-9]+/)) { tp = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", tp) } }
			END { printf "%s{\"dev\":\"%s\",\"ssid\":\"%s\",\"bssid\":\"%s\",\"ch\":%d,\"ghz\":%s,\"txp\":%d,\"ht\":\"%s\",\"cfg\":\"%s\"}", sep, dev, ess, bs, ch + 0, (fq == "" ? 0 : fq), tp + 0, ht, ch0 }'
		sep=,
	done
	printf '],"aps":['
	sep=
	for d in $devs; do
		{ if command -v timeout >/dev/null 2>&1; then timeout 8 "$IW" "$d" scan; else "$IW" "$d" scan; fi; } 2>/dev/null | tr -d '\000-\010\013-\037' | awk -v dev="$d" -v sep="$sep" '
			function flush() { if (b != "") { printf "%s[\"%s\",\"%s\",\"%s\",%d,%d]", (n++ ? "," : sep), dev, ss, b, ch, sg } b = ""; ss = ""; ch = 0; sg = -100 }
			/^Cell [0-9]+ - Address:/ { flush(); b = tolower($NF); next }
			/ESSID:/ { q = index($0, "\""); if (q) { t = substr($0, q + 1); e = index(t, "\""); ss = (e ? substr(t, 1, e - 1) : t); gsub(/["\\]/, "", ss) } next }
			/Channel:/ { if (match($0, /Channel: *[0-9]+/)) { c = substr($0, RSTART, RLENGTH); gsub(/[^0-9]/, "", c); ch = c + 0 } next }
			/Signal:/ { if (match($0, /Signal: *-?[0-9]+/)) { c = substr($0, RSTART, RLENGTH); gsub(/[^-0-9]/, "", c); sg = c + 0 } next }
			END { flush() }' > "$DIR/airscan.tmp"
		[ -s "$DIR/airscan.tmp" ] && { printf '%s' "$(cat "$DIR/airscan.tmp")"; sep=,; }
	done
	rm -f "$DIR/airscan.tmp"
	printf ']}\n' ;;
traffic)
	printf '{"now":%s,"persist":%s,"rows":[' "$now" "$([ -n "$(sed -n 's/^PERSIST_DIR=\(.\)/\1/p' /etc/nightfall-monitor.conf 2>/dev/null | head -n 1)" ] && echo 1 || echo 0)"
	# Итог за сутки берётся по счётчикам порта WAN. При аппаратном ускорении пакетов (MediaTek, Qualcomm и др.) порт не видит
	# часть трафика, и итог оказывается в десятки раз меньше реального. Поэтому, если сумма по устройствам (без самого роутера,
	# чей трафик повторяет трафик устройств через VPN или прокси) заметно больше, берём её. Источник суммы по устройствам:
	# архив суток, затем итоги вчерашнего и сегодняшнего дня, затем почасовые итоги. Четвёртое число строки: 1 — итог по устройствам.
	if [ -r "$DIR/traffic.daily" ]; then
		dday=$(cat "$DIR/day.date" 2>/dev/null); today=$(date +%Y%m%d); yest=$(date -d "@$((now - 86400))" +%Y%m%d 2>/dev/null)
		[ "$dday" = "$today" ] || yest=""
		{ [ -r "$DIR/dev.daily" ] && sed 's/^/A /' "$DIR/dev.daily"
		  [ -r "$DIR/dev.yday" ] && sed 's/^/Y /' "$DIR/dev.yday"
		  [ -r "$DIR/dev.day" ] && sed 's/^/T /' "$DIR/dev.day"
		  [ -r "$DIR/dev.hr" ] && sed 's/^/H /' "$DIR/dev.hr"
		  sed 's/^/W /' "$DIR/traffic.daily"; } 2>/dev/null |
		awk -v rips=" $(router_ips) " -v nets="$(router_nets)" -v tzs="$(date +%z 2>/dev/null)" -v dday="$dday" -v yest="$yest" "$AWKR"'
			function ymd(ts,   z, era, doe, yoe, y, doy, mp, d, m) {   # местная дата по метке времени (часовой пояс как сейчас)
				z = int((ts + tz) / 86400) + 719468; era = int(z / 146097); doe = z - era * 146097
				yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
				y = yoe + era * 400; doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
				mp = int((5 * doy + 2) / 153); d = doy - int((153 * mp + 2) / 5) + 1; m = (mp < 10 ? mp + 3 : mp - 9)
				if (m <= 2) y++
				return sprintf("%04d%02d%02d", y, m, d)
			}
			BEGIN { tz = (substr(tzs, 1, 1) == "-" ? -1 : 1) * (substr(tzs, 2, 2) * 3600 + substr(tzs, 4, 2) * 60) }
			$1 == "A" { if ($2 ~ /^[0-9]{8}$/ && !mine($3)) { ar[$2] += $4; at[$2] += $5; ah[$2] = 1 } next }
			$1 == "Y" { if (!mine($2)) { yr += $3; yt += $4; yh = 1 } next }
			$1 == "T" { if (!mine($2)) { tr += $3; tt += $4; th = 1 } next }
			$1 == "H" { if (NF >= 5 && $2 ~ /^[0-9]+$/ && !mine($3)) { k = ymd($2); hr_[k] += $4; ht_[k] += $5; hh[k] = 1 } next }
			$1 == "W" && NF >= 4 && $2 ~ /^[0-9]{8}$/ {
				d = $2; wr = $3 + 0; wt = $4 + 0; src = 0; cr = -1; ct = 0
				if (d in ah) { cr = ar[d]; ct = at[d] }
				else if (d == yest && yh) { cr = yr; ct = yt }
				else if (d == dday && th) { cr = tr; ct = tt }
				else if (d in hh) { cr = hr_[d]; ct = ht_[d] }
				if (cr >= 0 && cr + ct > 1.25 * (wr + wt) && cr + ct - wr - wt > 100000000) { wr = cr; wt = ct; src = 1 }
				printf "%s[\"%s\",%.0f,%.0f,%d]", (n++ ? "," : ""), d, wr, wt, src
			}'
	fi
	printf ']}\n' ;;
devdaily)   # итоги по устройствам за прошлые сутки: [день, ip, принято, отправлено, mac]
	printf '{"now":%s,"rows":[' "$now"
	[ -r "$DIR/dev.daily" ] && awk 'NF >= 4 && $1 ~ /^[0-9]{8}$/ { printf "%s[\"%s\",\"%s\",%d,%d,\"%s\"]", (n++ ? "," : ""), $1, $2, $3, $4, ($5 == "" ? "-" : $5) }' "$DIR/dev.daily"
	printf ']}\n' ;;
alerts)
	printf '{"now":%s,"active":' "$now"
	active_json
	printf ',"last":'; rows_json "$DIR/hist.fine" 1
	printf ',"info":'; info_json
	printf '}\n' ;;
*)
	echo "usage: nightfall-history series fine|coarse|long | devices | apps | channel | journal | speed | wifi [MAC] | wifi-hr [MAC] | devhr | devdaily | wifi-check | airscan | traffic | alerts" >&2
	exit 1 ;;
esac
