#!/bin/sh
# Nightfall config: чтение и безопасная запись настроек сборщика (/etc/nightfall-monitor.conf).
#   nightfall-config get                    — текущие значения и значения по умолчанию (JSON)
#   nightfall-config set KEY=VAL [KEY=VAL…] — проверить, записать и перезапустить сборщик
#   nightfall-config reset                  — вернуть настройки по умолчанию
#   nightfall-config disks                  — подключённые накопители (JSON)
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
DEF=${NF_DEF:-/usr/share/nightfall/nightfall-monitor.conf.default}
KEYS="TEMP_WARN TEMP_CRIT MEM_MIN_PCT FLASH_MAX_PCT CT_MAX_PCT CPU_MAX_PCT CPU_MINUTES PING_TARGET PING_TARGET2 PERSIST_DIR PERSIST_HOURS HIST_DAYS PERSIST_ANY JOURNAL WIFI_HIST SPEED_HOURS SPEED_URL SPEED_STREAMS APPS NEWDEV TG TG_ALERTS TG_TOKEN TG_CHAT TG_USERS TG_PROXY TG_IFACE TG_BOT TG_REPORT"

val() {     # val FILE KEY
	[ -r "$1" ] && sed -n "s/^$2=\"\{0,1\}\([^ #\"]*\).*/\1/p" "$1" | head -n 1
}

json_obj() {    # json_obj FILE [FALLBACK_FILE]: ключ, которого нет в FILE, берётся из FALLBACK_FILE
	printf '{'
	n=0
	for k in $KEYS; do
		if [ -r "$1" ] && grep -q "^$k=" "$1"; then v=$(val "$1" "$k"); else v=$(val "${2:-$1}" "$k"); fi
		[ "$n" -gt 0 ] && printf ','
		[ "$k" = TG_TOKEN ] && [ -n "$v" ] && v="***"      # токен наружу не отдаём
		printf '"%s":"%s"' "$k" "$v"
		n=$((n + 1))
	done
	printf '}'
}

fail() { printf '{"ok":false,"error":"%s"}\n' "$1"; exit 0; }

restart() { [ -n "$NF_NORESTART" ] || { /etc/init.d/nightfall-collector restart >/dev/null 2>&1 & }; }

range() {   # range KEY VAL MIN MAX
	case "$2" in ''|*[!0-9]*) fail "$1: нужно число" ;; esac
	[ "$2" -ge "$3" ] && [ "$2" -le "$4" ] || fail "$1: допустимо от $3 до $4"
}

PREFS=${NF_PREFS:-/etc/nightfall-prefs.json}
LOGO=${NF_LOGO:-/etc/nightfall-logo.json}
BGF=${NF_BGPHOTO:-/etc/nightfall-bg.json}
case "$1" in
logo-set)   # logo-set data:image/...;base64,... | off — своя картинка на экране входа (раздаётся как logo.json)
	v=$2
	if [ "$v" = off ]; then rm -f "$LOGO"; printf '{"ok":true}\n'; exit 0; fi
	[ -n "$v" ] && [ ${#v} -le 90000 ] || fail "картинка пустая или слишком большая"
	printf '%s' "$v" | grep -qE '^data:image/(png|webp|jpeg);base64,[A-Za-z0-9+/=]+$' || fail "нужна картинка png, webp или jpeg"
	printf '{"d":"%s"}\n' "$v" > "$LOGO.tmp" && chmod 644 "$LOGO.tmp" && mv "$LOGO.tmp" "$LOGO" || fail "не удалось записать картинку"
	printf '{"ok":true}\n' ;;
bg-set)     # bg-set data:image/...;base64,... | off — своё фото на фоне экрана входа (раздаётся как bg.json)
	v=$2
	if [ "$v" = off ]; then rm -f "$BGF"; printf '{"ok":true}\n'; exit 0; fi
	[ -n "$v" ] && [ ${#v} -le 110000 ] || fail "фото пустое или слишком большое"
	printf '%s' "$v" | grep -qE '^data:image/(webp|jpeg);base64,[A-Za-z0-9+/=]+$' || fail "нужно фото webp или jpeg"
	printf '{"d":"%s"}\n' "$v" > "$BGF.tmp" && chmod 644 "$BGF.tmp" && mv "$BGF.tmp" "$BGF" || fail "не удалось записать фото"
	printf '{"ok":true}\n' ;;
prefs-set)
	v=$2
	[ -n "$v" ] && [ ${#v} -le 8192 ] || fail "настройки темы пустые или слишком большие"
	case "$v" in '{'*'}') ;; *) fail "ожидался JSON-объект" ;; esac
	case "$v" in *'<'*|*'`'*|*'$('*) fail "недопустимые символы" ;; esac
	if command -v jsonfilter >/dev/null 2>&1; then [ -n "$(jsonfilter -s "$v" -e '@.t' 2>/dev/null)" ] || fail "некорректный JSON"; fi
	printf '%s\n' "$v" > "$PREFS.tmp" && chmod 644 "$PREFS.tmp" && mv "$PREFS.tmp" "$PREFS" || fail "не удалось записать настройки темы"
	printf '{"ok":true}\n' ;;
get)
	printf '{"values":'; json_obj "$CONF" "$DEF"
	printf ',"defaults":'; json_obj "$DEF"
	printf '}\n' ;;
set)
	shift
	[ $# -gt 0 ] || fail "нет параметров"
	for kv in "$@"; do
		k=${kv%%=*}; v=${kv#*=}
		case " $KEYS " in *" $k "*) ;; *) fail "неизвестный параметр: $k" ;; esac
		case "$k" in
		TEMP_WARN) range "$k" "$v" 40 120 ;;
		TEMP_CRIT) range "$k" "$v" 50 130 ;;
		MEM_MIN_PCT) range "$k" "$v" 1 90 ;;
		FLASH_MAX_PCT|CT_MAX_PCT|CPU_MAX_PCT) range "$k" "$v" 10 100 ;;
		CPU_MINUTES) range "$k" "$v" 1 60 ;;
		PING_TARGET|PING_TARGET2)
			case "$v" in ''|*[!A-Za-z0-9._:-]*) [ -z "$v" ] || fail "$k: недопустимые символы" ;; esac
			[ ${#v} -le 64 ] || fail "$k: слишком длинное значение" ;;
		PERSIST_HOURS) range "$k" "$v" 1 24 ;;
		HIST_DAYS) range "$k" "$v" 7 90 ;;
		TG_TOKEN)
			[ "$v" = "***" ] && continue       # интерфейс не менял токен
			[ -z "$v" ] || printf '%s' "$v" | grep -qE '^[0-9]{5,}:[A-Za-z0-9_-]{20,}$' || fail "TG_TOKEN: ожидался токен вида 123456:ABC… от @BotFather" ;;
		TG_CHAT) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^-?[0-9]{3,20}$' || fail "TG_CHAT: нужен числовой chat id" ;;
		TG_USERS) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[0-9]{3,20}(,[0-9]{3,20}){0,19}$' || fail "TG_USERS: числовые id через запятую, например 123456789,987654321" ;;
		TG_REPORT) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^([01][0-9]|2[0-3]):[0-5][0-9]$' || fail "TG_REPORT: время вида 21:00 или пусто" ;;
		TG_IFACE) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^[A-Za-z0-9_.-]{1,15}$' || fail "TG_IFACE: нужно имя интерфейса, например wg0" ;;
		TG_PROXY) [ -z "$v" ] || printf '%s' "$v" | grep -qE '^(http|https|socks5|socks5h)://[A-Za-z0-9._:@%-]{1,100}$' || fail "TG_PROXY: нужен адрес вида socks5h://127.0.0.1:1080 или http://host:port" ;;
		JOURNAL|PERSIST_ANY|WIFI_HIST|APPS|NEWDEV|TG|TG_ALERTS|TG_BOT) case "$v" in 0|1) ;; *) fail "$k: допустимо 0 или 1" ;; esac ;;
		SPEED_HOURS) range "$k" "$v" 0 168 ;;
		SPEED_STREAMS) range "$k" "$v" 1 8 ;;
		SPEED_URL)
			case "$v" in http://*|https://*) ;; *) fail "SPEED_URL: нужен адрес http:// или https://" ;; esac
			case "$v" in *[!A-Za-z0-9._~:/?=%+-]*) fail "SPEED_URL: недопустимые символы (разрешены буквы, цифры и . _ ~ : / ? = % + -)" ;; esac
			[ ${#v} -le 200 ] || fail "SPEED_URL: слишком длинный адрес" ;;
		PERSIST_DIR)
			if [ -n "$v" ]; then
				case "$v" in /*) ;; *) fail "PERSIST_DIR: нужен абсолютный путь" ;; esac
				case "$v" in *[!A-Za-z0-9._/-]*|*..*) fail "PERSIST_DIR: недопустимые символы" ;; esac
				case "$v" in /etc|/etc/*|/root|/root/*|/overlay|/overlay/*|/rom|/rom/*) fail "PERSIST_DIR: не используйте встроенную флеш-память" ;; esac
				[ ${#v} -le 100 ] || fail "PERSIST_DIR: слишком длинный путь"
			fi ;;
		esac
		eval "new_$k=\$v"
	done
	[ -f "$CONF" ] || cp "$DEF" "$CONF" 2>/dev/null || : > "$CONF"
	tw=${new_TEMP_WARN:-$(val "$CONF" TEMP_WARN)}; tc=${new_TEMP_CRIT:-$(val "$CONF" TEMP_CRIT)}
	[ -z "$tw" ] || [ -z "$tc" ] || [ "$tw" -lt "$tc" ] || fail "TEMP_WARN должен быть меньше TEMP_CRIT"
	cp "$CONF" "$CONF.tmp" || fail "не удалось записать конфигурацию"
	for kv in "$@"; do
		k=${kv%%=*}; v=${kv#*=}
		[ "$k" = TG_TOKEN ] && [ "$v" = "***" ] && continue
		if grep -q "^$k=" "$CONF.tmp"; then
			sed "s|^$k=[^ #]*|$k=$v|" "$CONF.tmp" > "$CONF.tmp2" && mv "$CONF.tmp2" "$CONF.tmp"
		else
			printf '%s=%s\n' "$k" "$v" >> "$CONF.tmp"
		fi
	done
	chmod 600 "$CONF.tmp" 2>/dev/null     # внутри токен бота
	mv "$CONF.tmp" "$CONF" || fail "не удалось записать конфигурацию"
	restart
	printf '{"ok":true}\n' ;;
disks)
	# подключённые USB-накопители, SD-карты и диски (не системный раздел роутера), куда можно сохранять историю
	M=${NF_MOUNTS:-/proc/mounts}; DFB=${NF_DF:-df}
	rd=$($DFB -P / 2>/dev/null | awk 'NR == 2 { print $1 }'); od=$($DFB -P /overlay 2>/dev/null | awk 'NR == 2 { print $1 }')
	printf '{"disks":['; n=0
	while read -r dev mnt fs opts _; do
		case "$dev" in /dev/sd[a-z]*|/dev/nvme*|/dev/mmcblk*|/dev/vd[a-z]*) ;; *) continue ;; esac
		case "$mnt" in /|/overlay|/overlay/*|/rom|/rom/*|/boot|/boot/*|/tmp|/tmp/*|/proc|/sys|/dev|/dev/*|/etc|/etc/*) continue ;; esac
		case "$mnt" in *[!A-Za-z0-9._/-]*) continue ;; esac
		[ "$dev" = "$rd" ] && continue
		[ "$dev" = "$od" ] && continue
		case ",$opts," in *,rw,*) ;; *) continue ;; esac
		kb=$($DFB -kP "$mnt" 2>/dev/null | awk 'NR == 2 { print $2, $4 }')
		[ -n "$kb" ] || continue
		[ "$n" -gt 0 ] && printf ','
		printf '{"dev":"%s","mount":"%s","fs":"%s","size_kb":%s,"free_kb":%s}' "$dev" "$mnt" "$fs" "${kb% *}" "${kb#* }"
		n=$((n + 1))
	done < "$M"
	printf '],"parts":['
	# разделы, которые видит ядро, но которые не смонтированы (для подсказки «почему список пуст»)
	n=0
	while read -r _ _ blocks name; do
		case "$name" in sd[a-z][0-9]*|nvme[0-9]*n[0-9]*p[0-9]*|mmcblk[0-9]*p[0-9]*|vd[a-z][0-9]*) ;; *) continue ;; esac
		grep -q "^/dev/$name " "$M" 2>/dev/null && continue
		bt=; command -v blkid >/dev/null 2>&1 && bt=$(blkid -o value -s TYPE "/dev/$name" 2>/dev/null | head -n 1 | tr -cd 'A-Za-z0-9_')
		[ "$n" -gt 0 ] && printf ','
		printf '{"dev":"/dev/%s","size_kb":%s,"type":"%s"}' "$name" "${blocks:-0}" "$bt"
		n=$((n + 1))
	done < "${NF_PARTS:-/proc/partitions}"
	printf '],"fs":['
	n=0
	for f in ext4 vfat exfat ntfs3 ntfs f2fs btrfs; do
		grep -qw "$f" "${NF_FSF:-/proc/filesystems}" 2>/dev/null || continue
		[ "$n" -gt 0 ] && printf ','
		printf '"%s"' "$f"; n=$((n + 1))
	done
	us=0; { [ -d "${NF_USBMOD:-/sys/module/usb_storage}" ] || grep -q '^usb_storage ' "${NF_MODS:-/proc/modules}" 2>/dev/null; } && us=1
	printf '],"usb_storage":%s}\n' "$us" ;;
reset)
	cp "$DEF" "$CONF" || fail "не удалось записать конфигурацию"
	restart
	printf '{"ok":true}\n' ;;
*)
	echo "usage: nightfall-config get | set KEY=VAL… | reset | disks" >&2
	exit 1 ;;
esac
