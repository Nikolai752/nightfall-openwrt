#!/bin/sh
# Nightfall: системный журнал роутера для вкладки «Журнал». Только чтение.
#   nightfall-log read [N]   — последние N строк (по умолчанию 400, не больше 1500), JSON:
#                              {"ok":true,"rows":[["Nov 16 02:10:01","daemon.info","dropbear","текст"],...]}
# Для проверок: NF_LOGREAD (команда вместо logread).
LOGREAD=${NF_LOGREAD:-logread}
case "$1" in
read)
	n=${2:-400}
	case "$n" in ''|*[!0-9]*) n=400 ;; esac
	[ "$n" -le 1500 ] || n=1500; [ "$n" -ge 1 ] || n=400
	printf '{"ok":true,"rows":['
	$LOGREAD 2>/dev/null | tail -n "$n" | awk '
	BEGIN { first = 1 }
	function q(x) { gsub(/\\/, "\\\\", x); gsub(/"/, "\\\"", x); gsub(/[\001-\037]/, " ", x); return x }
	function month(x) { return x ~ /^(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)$/ }
	function stampEnd() {
		if ($1 ~ /^(Sun|Mon|Tue|Wed|Thu|Fri|Sat)$/ && month($2)) return 5
		if (month($1)) return 3
		if ($1 ~ /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/) return 1
		/* Localized logread timestamp: [25 нояб. 2026 г., 09:42:11 GMT+4] */
		if ($1 ~ /^\[[0-9][0-9]?$/ && $2 ~ /^[[:alpha:]А-Яа-яЁё]+\.$/ && $3 ~ /^[0-9][0-9][0-9][0-9]$/ && $5 ~ /^[0-9][0-9]:[0-9][0-9]:[0-9][0-9]$/ && $6 ~ /^GMT[+-][0-9]+\]$/) return 6
		return 0
	}
	function cleanService(x) { sub(/\[[0-9]+\]:?$/, "", x); sub(/:$/, "", x); return x }
	function emit(t, lv, sv, msg, row) {
		/* Bound the RPC response: long log lines and large history must not break LuCI JSON. */
		if (length(msg) > 4096) msg = substr(msg, 1, 4096) " ... [truncated]"
		row = "[\"" q(t) "\",\"" q(lv) "\",\"" q(sv) "\",\"" q(msg) "\"]"
		rows[++last] = row
		bytes += length(row) + 1
		while (bytes > 45000 && first < last) {
			bytes -= length(rows[first]) + 1
			delete rows[first]
			first++
		}
	}
	function flushRows(i) {
		for (i = first; i <= last; i++)
			printf "%s%s", i == first ? "" : ",", rows[i]
	}
	{
		if ($0 == "") next
		pri = 0; sv = ""
		for (i = 1; i <= NF; i++) {
			if ($i ~ /^[[:alnum:]_-]+\.[[:alnum:]_-]+:?$/ || $i ~ /^<[0-9]+>[0-9]+$/ || $i ~ /^<[0-9]+>$/) { pri = i; break }
		}
		te = stampEnd(); t = ""
		for (i = 1; i <= te; i++) t = t (t == "" ? "" : " ") $i
		if (pri) {
			lv = $pri; sub(/:$/, "", lv); start = pri + 1
			if ($pri ~ /^<[0-9]+>[0-9]+$/ || $pri ~ /^<[0-9]+>$/) {
				num = $pri; sub(/^</, "", num); sub(/>.*/, "", num); sev = num % 8
				levels[0]="emerg"; levels[1]="alert"; levels[2]="crit"; levels[3]="err"; levels[4]="warn"; levels[5]="notice"; levels[6]="info"; levels[7]="debug"
				lv = "syslog." levels[sev]
				/* RFC5424: <PRI>VERSION TIMESTAMP HOST APP PROCID MSGID STRUCTURED-DATA MSG */
				if (pri == 1 && $pri ~ /^<[0-9]+>[0-9]+$/ && substr($(pri + 1), 1, 4) ~ /^[0-9][0-9][0-9][0-9]$/) {
					t = $(pri + 1); sv = cleanService($(pri + 3)); start = pri + 7
				} else if (pri == 1 && $pri ~ /^<[0-9]+>$/ && $(pri + 1) ~ /^[0-9]+$/ && substr($(pri + 2), 1, 4) ~ /^[0-9][0-9][0-9][0-9]$/) {
					t = $(pri + 2); sv = cleanService($(pri + 4)); start = pri + 8
				}
			}
			if (sv == "" && (lv ~ /^kern\.(emerg|alert|crit|err|warn|notice|info|debug):?$/ || lv ~ /^kernel\.(emerg|alert|crit|err|warn|notice|info|debug):?$/)) {
				sv = "kernel"
			} else if (start <= NF && sv == "") { sv = cleanService($start); start++ } else if (sv == "") sv = "unknown"
			msg = ""
			for (i = start; i <= NF; i++) msg = msg (msg == "" ? "" : " ") $i
			if (msg == "") msg = $0
			emit(t, lv, sv, msg)
		} else {
			/* Preserve lines whose priority syntax is unfamiliar. */
			start = te + 1; sv = start <= NF ? cleanService($start) : "unknown"
			emit(t, "unknown", sv, $0)
		}
	}
	END { flushRows() }
	printf ']}\n' ;;
*)
	echo "usage: nightfall-log read [N]" >&2; exit 1 ;;
esac
