#!/bin/sh
# Nightfall collector: фоновый сборщик истории для «Монитора ресурсов».
# Раз в STEP секунд (15) пишет в /tmp/nightfall:
#   hist.fine    — последний час (шаг 15 с)
#   hist.coarse  — последние 7 суток (шаг 5 мин)
#   temps.fine / temps.coarse — температура каждого датчика: час (шаг 15 с) и 7 суток (шаг 5 мин), строки «время имя:°C имя:°C»
#   hist.long    — длинная история (шаг 30 мин, HIST_DAYS суток); при PERSIST_DIR переживает перезагрузку
#   wifi.hr / dev.hr — сигнал Wi-Fi и трафик по устройствам по часам (тепловая карта, мини-графики)
#   dev.rate / dev.day / dev.yday — трафик по устройствам (из conntrack accounting)
#   apps.day / apps.hist, dns.map — трафик по приложениям (при APPS=1; имена из журнала DNS dnsmasq)
#   events.log, alerts.active    — события и активные предупреждения
# Режим: LITE=1 (слабые роутеры) — шаг 60 с, без учёта по приложениям (APPS) и истории Wi-Fi (WIFI_HIST); текущий режим пишется в info (mode=full|lite).
# Настройки: /etc/nightfall-monitor.conf (см. /usr/share/nightfall/nightfall-monitor.conf.default)

PROC=${NF_PROC:-/proc}
SYS=${NF_SYS:-/sys}
DIR=${NF_DIR:-/tmp/nightfall}
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
STEP=${NF_STEP:-15}
LOOPS=${NF_LOOPS:-0}            # для тестов: сколько циклов выполнить (0 = бесконечно)
CT=${NF_CT:-$PROC/net/nf_conntrack}

TEMP_WARN=80; TEMP_CRIT=90; MEM_MIN_PCT=10; FLASH_MAX_PCT=90; CT_MAX_PCT=80
CPU_MAX_PCT=90; CPU_MINUTES=3
PING_TARGET=1.1.1.1; PING_TARGET2=77.88.8.8
PERSIST_DIR=; PERSIST_HOURS=6; HIST_DAYS=30; PERSIST_ANY=0; JOURNAL=1; WIFI_HIST=1; SPEED_HOURS=0; APPS=0; NEWDEV=1; TG=0; TG_ALERTS=1; TG_REPORT=
NOTIFY=${NF_NOTIFY:-/usr/libexec/nightfall-notify}
KNOWN=${NF_KNOWN:-/etc/nightfall-known.list}
LEASES=${NF_LEASES:-/tmp/dhcp.leases}
DNSLOG=${NF_DNSLOG:-/tmp/nightfall-dns.log}
RULES=${NF_RULES:-/usr/share/nightfall/apps.list}
RULES_USER=${NF_RULES_USER:-/etc/nightfall-apps.list}
SPEED_URL=https://speed.cloudflare.com/__down?bytes=25000000
JOURNAL_FILE=${NF_JOURNAL:-/etc/nightfall-journal.log}
[ -r "$CONF" ] && . "$CONF"
# режим работы: LITE=1 для слабых роутеров (шаг 60 с вместо 15, без учёта по приложениям и истории Wi-Fi); по умолчанию «мощный»
MODE=full
if [ "$LITE" = 1 ]; then MODE=lite; [ -n "$NF_STEP" ] || STEP=60; WIFI_HIST=0; APPS=0; fi

mkdir -p "$DIR" || exit 1

# одна копия: если уже работает другой сборщик (например, оставшийся от прошлой версии), останавливаем его
for p in /proc/[0-9]*; do
	pid=${p#/proc/}
	[ "$pid" = "$$" ] && continue
	cmd=$( { tr '\0' ' ' < "$p/cmdline"; } 2>/dev/null )
	case "$cmd" in "/bin/sh $0 "*|"sh $0 "*) kill "$pid" 2>/dev/null ;; esac
done
echo $$ > "$DIR/pid"
AGG=${NF_AGG:-$((300 / STEP))}  # сколько шагов в 5 минутах
[ "$AGG" -ge 1 ] || AGG=1
HOST=$(cat "$PROC/sys/kernel/hostname" 2>/dev/null || echo router)

# ---------- события и предупреждения ----------
clean() { printf '%s' "$1" | tr -d '"\\|' | tr '\n' ' '; }

BLOCKBIN=${NF_BLOCKBIN:-/usr/libexec/nightfall-block}
BOTBIN=${NF_BOTBIN:-/usr/libexec/nightfall-bot}
BLOCKLIST=${NF_BLOCK:-/etc/nightfall-block.list}
GROUPLIST=${NF_GROUPS:-/etc/nightfall-groups.list}
REPORT_MARK="$DIR/report.sent"

tgsend() {  # tgsend ТЕКСТ [КНОПКИ_JSON]: в фоне, чтобы сбой сети не тормозил сборщик
	[ "$TG" = 1 ] && [ -x "$NOTIFY" ] || return 0
	"$NOTIFY" send "$1" "$2" >/dev/null 2>&1 &
}

event() {   # event LEVEL TEXT [quiet]
	printf '%s|%s|%s\n' "$now" "$1" "$(clean "$2")" >> "$DIR/events.log"
	[ "$3" = quiet ] && return 0
	[ "$TG_ALERTS" = 1 ] || return 0
	case "$1" in
		warn) tgsend "⚠️ $(clean "$2")" ;;
		bad) tgsend "🔴 $(clean "$2")" ;;
		ok) tgsend "✅ $(clean "$2")" ;;
	esac
}

fmt_dur() {
	d=$1
	if [ "$d" -ge 3600 ]; then echo "$((d / 3600)) ч $((d % 3600 / 60)) мин"
	elif [ "$d" -ge 60 ]; then echo "$((d / 60)) мин $((d % 60)) с"
	else echo "$d с"; fi
}

# alert KEY LEVEL NEED_ON COND(0|1) TEXT
alert() {
	k=$1; lvl=$2; need=$3; cond=$4; txt=$5
	eval "n=\${n_$k:-0}; f=\${f_$k:-0}; a=\${a_$k:-0}"
	if [ "$cond" = 1 ]; then
		n=$((n + 1)); f=0
		if [ "$a" = 0 ] && [ "$n" -ge "$need" ]; then
			a=$now
			printf '%s|%s|%s|%s\n' "$k" "$now" "$lvl" "$(clean "$txt")" >> "$DIR/alerts.active"
			event "$lvl" "$txt"
			logger -t nightfall -p daemon.warning "$txt" 2>/dev/null
		fi
	else
		f=$((f + 1)); n=0
		if [ "$a" != 0 ] && [ "$f" -ge 2 ]; then
			dur=$(fmt_dur $((now - a)))
			was=$(grep "^$k|" "$DIR/alerts.active" 2>/dev/null | head -n 1 | cut -d'|' -f4)
			[ -n "$was" ] || was=$txt
			grep -v "^$k|" "$DIR/alerts.active" > "$DIR/alerts.tmp" 2>/dev/null; mv "$DIR/alerts.tmp" "$DIR/alerts.active"
			event ok "Снова в норме: $was (длилось $dur)"
			logger -t nightfall "Снова в норме: $was" 2>/dev/null
			a=0
		fi
	fi
	eval "n_$k=$n; f_$k=$f; a_$k=$a"
}

# ---------- измерения ----------
read_temp() {   # печатает температуру процессора в °C с десятой долей или -1
	best=""; first=""
	for z in "$SYS"/class/thermal/thermal_zone*; do
		[ -r "$z/temp" ] || continue
		t=""; read -r t < "$z/temp" 2>/dev/null || continue
		nm=""; read -r nm < "$z/type" 2>/dev/null
		case "$nm" in *phy*|*mt76*|*mt79*|*wifi*|*wlan*|*ath*|*iwlwifi*) continue ;; esac
		[ -n "$first" ] || first=$t
		case "$nm" in *cpu*|*soc*|*core*|*a53*|*a73*|*thermal*) best=$t; break ;; esac
	done
	if [ -z "$best" ]; then
		for h in "$SYS"/class/hwmon/hwmon*; do
			[ -r "$h/temp1_input" ] || continue
			read -r first < "$h/temp1_input" 2>/dev/null && break
		done
	fi
	[ -n "$best" ] || best=$first
	case "$best" in ''|*[!0-9]*) echo -1; return ;; esac
	[ "$best" -gt 0 ] || { echo -1; return; }
	echo "$((best / 1000)).$((best % 1000 / 100))"
}

read_temps() {  # печатает температуры всех датчиков «имя:°C» через пробел (имена как в nightfall-stats; повтор имени получает #2, #3)
	out=""
	for z in "$SYS"/class/thermal/thermal_zone*; do
		[ -r "$z/temp" ] || continue
		t=""; nm="zone"
		read -r t < "$z/temp" 2>/dev/null || continue
		read -r nm < "$z/type" 2>/dev/null
		out="$out z|$(printf '%s' "$nm" | tr -cd 'A-Za-z0-9_.-')|$t"
	done
	for h in "$SYS"/class/hwmon/hwmon*; do
		[ -r "$h/temp1_input" ] || continue
		t=""; nm="hwmon"
		read -r t < "$h/temp1_input" 2>/dev/null || continue
		read -r nm < "$h/name" 2>/dev/null
		out="$out h|$(printf '%s' "$nm" | tr -cd 'A-Za-z0-9_.-')|$t"
	done
	# один и тот же датчик виден и как зона (cpu-thermal), и как hwmon (cpu_thermal): оставляем hwmon, как в штатной карточке LuCI
	printf '%s\n' "$out" | tr ' ' '\n' | awk -F'|' '
		function norm(x) { x = tolower(x); gsub(/-/, "_", x); return x }
		NF == 3 && $3 ~ /^[0-9]+$/ && $3 > 0 { n++; src[n] = $1; nm[n] = ($2 == "" ? "sensor" : $2); v[n] = $3; if ($1 == "h") hw[norm(nm[n])] = 1 }
		END { for (i = 1; i <= n; i++) {
			if (src[i] == "z" && (norm(nm[i]) in hw)) continue
			k = nm[i]; c[k]++; if (c[k] > 1) k = k "#" c[k]
			printf "%s%s:%d.%d", (m++ ? " " : ""), k, int(v[i] / 1000), int((v[i] % 1000) / 100) } }'
}

ping_ms() {     # ping_ms HOST -> миллисекунды или -1
	[ -n "$1" ] || { echo -1; return; }
	r=$(ping -c 1 -W 1 "$1" 2>/dev/null | awk -F'time=' '/time=/ { split($2, a, " "); print a[1]; exit }')
	[ -n "$r" ] && echo "$r" || echo -1
}

# ---------- новые устройства ----------
# Источник: ARP-таблица (проводные и Wi-Fi) и аренды DHCP. Первый запуск только запоминает то, что уже есть.
do_newdev() {
	[ "$NEWDEV" = 1 ] || return 0
	[ -r "$PROC/net/arp" ] || return 0
	seed=0; [ -f "$KNOWN" ] || seed=1
	awk -v known="$KNOWN" -v leases="$LEASES" -v seed="$seed" -v out="$DIR/newdev.out" -v wan="$wdev" '
		BEGIN {
			while ((getline l < known) > 0) { split(l, a, "|"); k[a[1]] = 1 }
			close(known)
			while ((getline l < leases) > 0) { split(l, a, " "); m = tolower(a[2]); nm[m] = (a[4] == "*" ? "" : a[4]); ip[m] = a[3]; ls[m] = 1 }
			close(leases)
		}
		NR > 1 && $3 == "0x2" && $4 != "00:00:00:00:00:00" && ($6 != wan || (tolower($4) in ls)) {   # на WAN-интерфейсе берём только клиентов из аренд DHCP (схема «на одной ноге»)
			m = tolower($4); ip[m] = $1
			if (!(m in k)) { k[m] = 1; print m "|" nm[m] "|" ip[m] > out; n++ }
		}
		END {
			# арендованные, но сейчас не видимые адреса тоже считаем знакомыми (иначе после включения «новыми» станут свои выключенные устройства)
			for (m in ls) if (!(m in k)) { k[m] = 1; print m "|" nm[m] "|" ip[m] > out }
		}' "$PROC/net/arp"
	[ -s "$DIR/newdev.out" ] || { rm -f "$DIR/newdev.out"; [ "$seed" = 1 ] && : > "$KNOWN"; return 0; }
	while IFS='|' read -r m nm ipa; do
		printf '%s|%s|%s\n' "$m" "$nm" "$now" >> "$KNOWN"
		[ "$seed" = 1 ] && continue
		h=$(printf '%s' "$m" | cut -c2)
		priv=""; case "$h" in 2|6|a|e|A|E) priv=" (частный адрес Wi-Fi, у телефона он может меняться)" ;; esac
		txt="Новое устройство в сети: ${nm:-без имени}, $ipa, $m$priv"
		event warn "$txt" quiet
		k=$(printf '%s' "$m" | tr -d ':')
		tgsend "🆕 $(clean "$txt"). Если это ваше устройство, больше это сообщение не повторится." "{\"inline_keyboard\":[[{\"text\":\"✅ Это моё\",\"callback_data\":\"ok:$k\"},{\"text\":\"🚫 Заблокировать\",\"callback_data\":\"bk:$k\"}]]}"
	done < "$DIR/newdev.out"
	rm -f "$DIR/newdev.out"
}

# журнал DNS dnsmasq -> dns.map («адрес приложение»): по именам из ответов определяем, какому сервису принадлежит адрес
do_dns() {
	[ "$APPS" = 1 ] && [ -r "$DNSLOG" ] || return 0
	size=$(wc -c < "$DNSLOG" 2>/dev/null | tr -d ' '); [ -n "$size" ] || return 0
	off=$(cat "$DIR/dns.off" 2>/dev/null); case "$off" in ''|*[!0-9]*) off=0 ;; esac
	[ "$size" -ge "$off" ] || off=0
	if [ "$size" -gt "$off" ]; then
		tail -c +$((off + 1)) "$DNSLOG" 2>/dev/null | awk -v rules="$RULES" -v urules="$RULES_USER" -v map="$DIR/dns.map" '
		function load(f,   l, a, n, d, i) {
			while ((getline l < f) > 0) {
				if (l ~ /^#/ || l == "") continue
				n = split(l, a, "|"); if (n < 2) continue
				split(a[2], d, " "); for (i in d) if (!(d[i] in dom)) dom[d[i]] = a[1]
			}
			close(f)
		}
		function cls(n,   p) {
			n = tolower(n)
			while (1) { if (n in dom) return dom[n]; p = index(n, "."); if (!p) return ""; n = substr(n, p + 1) }
		}
		# «основное» имя для неопознанных адресов: последние две части (example.com), для co.uk/com.ru и т. п. три
		function sld(n,   p, k, i) {
			n = tolower(n); gsub(/[^a-z0-9.-]/, "", n); sub(/\.$/, "", n)
			k = split(n, p, ".")
			if (k <= 2) return n
			if (length(p[k]) == 2 && p[k - 1] ~ /^(co|com|net|org|gov|edu|ac)$/) return p[k - 2] "." p[k - 1] "." p[k]
			return p[k - 1] "." p[k]
		}
		BEGIN { load(urules); load(rules) }
		{
			k = 0
			for (i = 1; i <= NF; i++) if ($i ~ /^query\[/ || $i == "reply" || $i == "cached") { k = i; break }
			if (!k) next
			if ($k ~ /^query\[/) { cur = $(k + 1); chain = 0; next }
			name = $(k + 1); v = $(k + 3)
			if ($(k + 2) != "is") next
			if (v == "<CNAME>") { chain = 1; next }
			if (v !~ /^[0-9a-fA-F.:]+$/) next
			a = ""; if (chain) a = cls(cur); if (a == "") a = cls(name)   # youtube.com -> CNAME на адреса Google: выигрывает исходное имя запроса
			if (a == "") { a = sld(chain ? cur : name); if (a != "" && a ~ /\./) a = "Прочее · " a; else a = "" }
			if (a != "") print tolower(v) "|" a >> map
		}'
		n=$(wc -l < "$DIR/dns.map" 2>/dev/null | tr -d ' ')
		if [ "${n:-0}" -gt 20000 ]; then tail -n 12000 "$DIR/dns.map" > "$DIR/dns.map.tmp" && mv "$DIR/dns.map.tmp" "$DIR/dns.map"; fi
	fi
	# журнал не должен расти бесконечно
	if [ "$size" -gt 1048576 ]; then : > "$DNSLOG"; size=0; fi
	echo "$size" > "$DIR/dns.off"
}

# ---------- суточные итоги трафика WAN (для календаря «Трафик по месяцам») ----------
# traffic.daily: строки «ГГГГММДД принято_байт отправлено_байт», не более 400 дней.
td_date=""; td_rx=0; td_tx=0; td_flush=0
traffic_day() {
	[ "$rx" -ge 0 ] 2>/dev/null && [ "$dtm" -gt 0 ] || return 0
	d=$(date +%Y%m%d)
	[ "$d" -gt 20240101 ] 2>/dev/null || return 0    # часы ещё не синхронизированы
	if [ "$d" != "$td_date" ]; then
		td_date=$d; td_rx=0; td_tx=0
		set -- $(awk -v d="$d" '$1 == d { print $2, $3 }' "$DIR/traffic.daily" 2>/dev/null)
		[ -n "$1" ] && { td_rx=$1; td_tx=$2; }
	fi
	td_rx=$((td_rx + rx * dtm)); td_tx=$((td_tx + tx * dtm))
	if [ $((now - td_flush)) -ge 60 ]; then
		td_flush=$now
		{ [ -r "$DIR/traffic.daily" ] && awk -v d="$d" '$1 != d' "$DIR/traffic.daily" | tail -n 399
		  echo "$d $td_rx $td_tx"; } > "$DIR/traffic.daily.tmp" 2>/dev/null && mv "$DIR/traffic.daily.tmp" "$DIR/traffic.daily"
	fi
}

archive_devday() {   # итоги устройств за закончившиеся сутки: «ГГГГММДД ip принято отправлено mac» (отчёт «Трафик по месяцам → день»)
	[ -s "$DIR/dev.day" ] || return 0
	lf=${NF_LEASES:-/tmp/dhcp.leases}; [ -r "$lf" ] || lf=/dev/null
	awk -v d="$1" 'FILENAME == ARGV[1] { ip[$3] = tolower($2); next } NF >= 3 { print d, $1, $2, $3, ($1 in ip ? ip[$1] : "-") }' "$lf" "$DIR/dev.day" >> "$DIR/dev.daily" 2>/dev/null
	if [ "$(wc -l < "$DIR/dev.daily" 2>/dev/null || echo 0)" -gt 6500 ]; then   # около 90 суток по 64 устройства
		tail -n 6000 "$DIR/dev.daily" > "$DIR/dev.daily.tmp" && mv "$DIR/dev.daily.tmp" "$DIR/dev.daily"
	fi
	return 0
}

do_devices() {  # трафик по устройствам: разница счётчиков conntrack между замерами
	[ -r "$CT" ] || return 0
	today=$(date +%Y%m%d)
	if [ "$today" -gt 20240101 ] 2>/dev/null; then
		old=$(cat "$DIR/day.date" 2>/dev/null)
		if [ "$old" != "$today" ]; then
			[ -n "$old" ] && archive_devday "$old"
			[ -n "$old" ] && mv "$DIR/dev.day" "$DIR/dev.yday" 2>/dev/null
			if [ -n "$old" ] && [ -s "$DIR/apps.day" ]; then
				awk -v d="$old" '{ print d "|" $0 }' "$DIR/apps.day" >> "$DIR/apps.hist"
				# храним последние 30 суток
				awk -F'|' '{ if (!($1 in s)) { s[$1] = 1; n++; ds[n] = $1 } l[NR] = $0; dt[NR] = $1 } END { for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (ds[j] > ds[i]) { t = ds[i]; ds[i] = ds[j]; ds[j] = t }
					for (i = 1; i <= n && i <= 30; i++) keep[ds[i]] = 1
					for (i = 1; i <= NR; i++) if (dt[i] in keep) print l[i] }' "$DIR/apps.hist" > "$DIR/apps.hist.tmp" && mv "$DIR/apps.hist.tmp" "$DIR/apps.hist"
			fi
			: > "$DIR/apps.day"
			echo "$today" > "$DIR/day.date"
			: > "$DIR/dev.day"
		fi
	fi
	# Версия 3: пересобираем суточные итоги после перехода от эвристики private-IP к реальным LAN-подсетям.
	# Старые итоги могли включать WAN/VPN-адреса и не могут быть достоверно исправлены задним числом.
	if [ "$(cat "$DIR/acct.v" 2>/dev/null)" != 3 ]; then
		: > "$DIR/dev.day"; : > "$DIR/dev.yday"; : > "$DIR/apps.day"; : > "$DIR/apps.hist"; rm -f "$DIR/ct.state"
		echo 3 > "$DIR/acct.v"
	fi
	# Строим список реальных клиентских IPv4-подсетей по connected routes основной таблицы.
# WAN-подсеть допускается только при наличии в ней DHCP-клиента (режим «на одной ноге»).
: > "$DIR/client.nets"
ip -4 route show table main 2>/dev/null | awk -v wan="$wdev" -v lf="$LEASES" '
	function num(ip, a) { split(ip, a, "."); return (((a[1] * 256 + a[2]) * 256 + a[3]) * 256 + a[4]) }
	{
		net = $1
		if (net !~ /^[0-9.]+\/[0-9]+$/) next
		split(net, p, "/"); bits = p[2] + 0
		if (bits < 8 || bits > 30) next
		dev = ""; scope = ""; proto = ""
		for (i = 1; i <= NF; i++) {
			if ($i == "dev") dev = $(i + 1)
			if ($i == "scope") scope = $(i + 1)
			if ($i == "proto") proto = $(i + 1)
		}
		if (scope != "link" && proto != "kernel") next
		if (dev == wan) {
			sz = 2 ^ (32 - bits); base = num(p[1]); lo = base - (base % sz); found = 0
			while ((getline l < lf) > 0) { split(l, f, " "); x = num(f[3]); if (f[3] ~ /^[0-9.]+$/ && x >= lo && x < lo + sz) { found = 1; break } }
			close(lf)
			if (!found) next
		}
		print net
	}' > "$DIR/client.nets"
# Исключаем все текущие адреса самого роутера, включая VPN /32 и WAN.
for ra in $(ip -4 addr show 2>/dev/null | awk '/inet / { split($2, a, "/"); print a[1] }'); do
	grep -qx "$ra" "$DIR/router.ips" 2>/dev/null || echo "$ra" >> "$DIR/router.ips"
done
first=0; [ -s "$DIR/ct.state" ] || first=1
	rm -f "$DIR/ct.state.new"
	head -n 40000 "$CT" 2>/dev/null | awk -v netf="$DIR/client.nets" -v routerf="$DIR/router.ips" -v statef="$DIR/ct.state" -v newf="$DIR/ct.state.new" -v dayf="$DIR/dev.day" \
		-v ratef="$DIR/dev.rate.new" -v tmpf="$DIR/dev.day.tmp" -v svcf="$DIR/svc.raw" -v dstf="$DIR/dst.raw" -v dt="$dtm" -v first="$first" -v ts="$now" \
		-v apps="$APPS" -v mapf="$DIR/dns.map" -v appf="$DIR/apps.day" -v appn="$DIR/apps.day.tmp" -v rules="$RULES" -v urules="$RULES_USER" '
	function isprivate(ip) { return ip ~ /^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|169\.254\.)/ || ip ~ /^(f[cdef]|FE|FC|FD|fe80:)/ || ip == "::1" || ip ~ /^0000:0000:0000:0000:0000:0000:0000:0001$/ }
	function ipnum(ip, a) { split(ip, a, "."); return (((a[1] * 256 + a[2]) * 256 + a[3]) * 256 + a[4]) }
	function isrouter(ip) { return ip in router }
	function islan(ip,   i, p, bits, size, base, addr) {
		if (index(ip, ":")) return isprivate(ip)
		if (ip !~ /^[0-9.]+$/) return 0
		addr = ipnum(ip)
		for (i = 1; i <= nn; i++) {
			split(nets[i], p, "/"); bits = p[2] + 0; size = 2 ^ (32 - bits)
			base = ipnum(p[1]); base -= (base % size)
			if (addr >= base && addr < base + size) return 1
		}
		return 0
	}
	BEGIN {
		while ((getline l < netf) > 0) if (l != "") nets[++nn] = l; close(netf)
		while ((getline l < routerf) > 0) if (l != "") router[l] = 1; close(routerf)
		while ((getline l < statef) > 0) { split(l, a, " "); po[a[1]] = a[2]; pr[a[1]] = a[3] }
		close(statef)
		while ((getline l < dayf) > 0) { split(l, a, " "); dd[a[1]] = a[2] + 0; du[a[1]] = a[3] + 0 }
		close(dayf)
		if (apps == 1) {
			while ((getline l < mapf) > 0) { split(l, a, "|"); if (a[2] != "") am[a[1]] = a[2] }
			close(mapf)
			ld(urules); ld(rules)
			while ((getline l < appf) > 0) { split(l, a, "|"); k = a[1] "|" a[2]; adl[k] = a[3] + 0; aul[k] = a[4] + 0 }
			close(appf)
		}
	}
	function ld(f,   l, a, n, p, i) {
		while ((getline l < f) > 0) {
			if (l ~ /^#/ || l == "") continue
			n = split(l, a, "|"); if (n < 3) continue
			m = split(a[3], p, " "); for (i = 1; i <= m; i++) { npf++; pf[npf] = p[i]; pfa[npf] = a[1] }
		}
		close(f)
	}
	function appof(ip,   i) {
		if (ip in am) return am[ip]
		for (i = 1; i <= npf; i++) if (index(ip, pf[i]) == 1) return pfa[i]
		return "Прочее"
	}
	{
		src = ""; dst = ""; sp = ""; dp = ""; nb = 0; ob = 0; rb = 0
		for (i = 4; i <= NF; i++) {
			f = $i
			if (src == "" && substr(f, 1, 4) == "src=") src = substr(f, 5)
			else if (dst == "" && substr(f, 1, 4) == "dst=") dst = substr(f, 5)
			else if (sp == "" && substr(f, 1, 6) == "sport=") sp = substr(f, 7)
			else if (dp == "" && substr(f, 1, 6) == "dport=") dp = substr(f, 7)
			else if (substr(f, 1, 6) == "bytes=") { nb++; if (nb == 1) ob = substr(f, 7) + 0; else if (nb == 2) rb = substr(f, 7) + 0 }
		}
		if (nb < 2 || src == "" || dst == "") next
		if (!islan(src) || isrouter(src)) next                 # источник должен принадлежать реальной LAN/VLAN-подсети
		if (islan(dst) || isrouter(dst)) next                  # LAN↔LAN и обращения к роутеру не считаем интернетом
		key = $1 "|" $3 "|" src ">" dst ":" sp ">" dp
		# одинаковые «адрес:порт» бывают у нескольких записей (старая в TIME_WAIT и новая): складываем их счётчики,
		# иначе одна запись «уменьшалась» и каждый цикл засчитывалась заново целиком (завышение в сотни раз)
		if (key in so) { so[key] += ob; sr[key] += rb; next }
		so[key] = ob; sr[key] = rb; sa[key] = src; sd[key] = dst; sp3[key] = $3; sdp[key] = dp
	}
	function account(key,   ob, rb, src, dst, do_, dr_, sk, dk, ak) {
		ob = so[key]; rb = sr[key]; src = sa[key]; dst = sd[key]
		printf "%s %.0f %.0f\n", key, ob, rb > newf
		if (first) return
		if (key in po) { do_ = ob - po[key]; dr_ = rb - pr[key]; if (do_ < 0) do_ = ob; if (dr_ < 0) dr_ = rb }
		else { do_ = ob; dr_ = rb }
		# за один цикл по одному соединению не может пройти больше ~2 Гбит/с: всё, что выше, это сбой счётчика
		if (do_ + dr_ > cap) return
		cu[src] += do_; cd[src] += dr_
		if (do_ + dr_ > 0) {
			sk = src " " sp3[key] " " (sdp[key] == "" ? "-" : sdp[key]); sv_d[sk] += dr_; sv_u[sk] += do_
			if (!islan(dst) && !isrouter(dst)) {
				dk = src " " dst; ds_d[dk] += dr_; ds_u[dk] += do_
				if (apps == 1) { ak = src "|" appof(tolower(dst)); adl[ak] += dr_; aul[ak] += do_ }
			}
		}
	}
	END {
		cap = (dt > 0 ? dt : 10) * 250000000
		for (k in so) account(k)
		print ts > ratef
		for (ip in cd) {
			if (cd[ip] + cu[ip] <= 0) continue
			printf "%s %.0f %.0f\n", ip, cd[ip] / dt, cu[ip] / dt > ratef
			dd[ip] += cd[ip]; du[ip] += cu[ip]
		}
		for (ip in dd) printf "%s %.0f %.0f %.0f\n", ip, dd[ip], du[ip], dd[ip] + du[ip] > tmpf
		if (apps == 1 && !first) { for (k in adl) printf "%s|%.0f|%.0f\n", k, adl[k], aul[k] > appn }
		if (dt > 0) {
			for (k in sv_d) printf "%s %.0f %.0f\n", k, sv_d[k] / dt, sv_u[k] / dt > svcf
			for (k in ds_d) printf "%s %.0f %.0f\n", k, ds_d[k] / dt, ds_u[k] / dt > dstf
		}
	}'
	if [ "$first" = 0 ]; then
		{ echo "$now"; [ -f "$DIR/svc.raw" ] && sort -k4,4nr "$DIR/svc.raw" | head -n 40; } > "$DIR/svc.rate.new"; mv "$DIR/svc.rate.new" "$DIR/svc.rate"
		{ echo "$now"; [ -f "$DIR/dst.raw" ] && sort -k3,3nr "$DIR/dst.raw" | head -n 40; } > "$DIR/dst.rate.new"; mv "$DIR/dst.rate.new" "$DIR/dst.rate"
	fi
	rm -f "$DIR/svc.raw" "$DIR/dst.raw"
	[ -f "$DIR/ct.state.new" ] && mv "$DIR/ct.state.new" "$DIR/ct.state" || : > "$DIR/ct.state"
	[ -f "$DIR/dev.rate.new" ] && mv "$DIR/dev.rate.new" "$DIR/dev.rate"
	if [ -f "$DIR/apps.day.tmp" ]; then
		sort -t'|' -k3,3nr "$DIR/apps.day.tmp" | head -n 600 > "$DIR/apps.day"; rm -f "$DIR/apps.day.tmp"
	fi
	if [ -f "$DIR/dev.day.tmp" ]; then
		sort -k4,4nr "$DIR/dev.day.tmp" | head -n 64 | cut -d' ' -f1-3 > "$DIR/dev.day"
		rm -f "$DIR/dev.day.tmp"
	fi
}

write_info() {
	off=$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)
	acct=0; [ -r "$PROC/sys/net/netfilter/nf_conntrack_acct" ] && acct=$(cat "$PROC/sys/net/netfilter/nf_conntrack_acct" 2>/dev/null)
	{
		echo "step=$STEP"
		echo "mode=$MODE"
		echo "started=$started"
		echo "wan_dev=$wdev"
		echo "gateway=$gw"
		echo "targets=$PING_TARGET $PING_TARGET2"
		echo "acct=${acct:-0}"
		echo "flow_hw=$FLOW_HW"
		echo "offload=${off:-0}"
		# адреса самого роутера: текущие и прежние (внешний адрес провайдера может меняться; его трафик не принадлежит устройствам)
		for ra in $(ip -4 addr show 2>/dev/null | awk '/inet / { split($2, a, "/"); print a[1] }'); do grep -qx "$ra" "$DIR/router.ips" 2>/dev/null || echo "$ra" >> "$DIR/router.ips"; done
		[ "$(wc -l < "$DIR/router.ips" 2>/dev/null || echo 0)" -gt 24 ] && { tail -n 16 "$DIR/router.ips" > "$DIR/router.ips.tmp" && mv "$DIR/router.ips.tmp" "$DIR/router.ips"; }
		echo "router_ips=$(tr '\n' ' ' < "$DIR/router.ips" 2>/dev/null)"
		# подсеть на внешнем интерфейсе: провайдер выдаёт роутеру разные адреса из неё, и весь трафик с этих адресов принадлежит роутеру,
		# а не устройству. Исключение: подсеть, в которой есть клиенты из аренд DHCP (схема «на одной ноге»: WAN и LAN на одном интерфейсе)
		rnets=""
		if [ -n "$wdev" ]; then
			for rc in $(ip -4 addr show dev "$wdev" 2>/dev/null | awk '/inet / { print $2 }'); do
				rn=$(awk -v c="$rc" -v lf="$LEASES" '
					function n(ip,   a) { split(ip, a, "."); return ((a[1] * 256 + a[2]) * 256 + a[3]) * 256 + a[4] }
					BEGIN { split(c, p, "/"); bits = p[2] + 0; if (bits < 8 || bits > 30) exit; sz = 2 ^ (32 - bits); b = n(p[1]); lo = b - (b % sz)
						while ((getline l < lf) > 0) { split(l, f, " "); x = n(f[3]); if (x >= lo && x < lo + sz) exit }
						printf "%d.%d.%d.%d/%d", int(lo / 16777216), int(lo / 65536) % 256, int(lo / 256) % 256, lo % 256, bits }' 2>/dev/null)
				[ -n "$rn" ] && rnets="$rnets$rn "
			done
		fi
		echo "router_nets=$rnets"
		echo "persist=$([ -n "$PERSIST_DIR" ] && [ "$persist_ok" = 1 ] && echo 1 || echo 0)"
		echo "persist_dir=$PERSIST_DIR"
		echo "persist_blocked=$([ -n "$PERSIST_DIR" ] && [ "$persist_ok" = 0 ] && [ "${persist_error:-0}" != 1 ] && echo 1 || echo 0)"
		echo "persist_hours=$PERSIST_HOURS"
		echo "hist_days=$HIST_DAYS"
		echo "long_n=$(wc -l < "$DIR/hist.long" 2>/dev/null | tr -d ' ')"
		echo "persist_any=$PERSIST_ANY"
		echo "persist_kb=${persist_kb:-0}"
		echo "persist_last=${persist_last:-0}"
		echo "persist_error=${persist_error:-0}"
		echo "journal=$JOURNAL"
		echo "journal_file=$JOURNAL_FILE"
		echo "speed_hours=$SPEED_HOURS"
		echo "wifi_hist=$WIFI_HIST"
		echo "limits=temp>=$TEMP_WARN/$TEMP_CRIT, free RAM<$MEM_MIN_PCT%, flash>=$FLASH_MAX_PCT%, conntrack>=$CT_MAX_PCT%, CPU>=$CPU_MAX_PCT% $CPU_MINUTES min"
	} > "$DIR/info.tmp" && mv "$DIR/info.tmp" "$DIR/info"
}

# Возвращает устройство и самую длинную точку монтирования, содержащую путь.
# NF_MOUNTS позволяет тестировать поведение без изменения настоящей таблицы монтирования.
persist_mount_info() {
	local p
	p=$1
	[ -n "$p" ] || return 1
	awk -v p="$p" '
		function unescape(s) {
			gsub(/\\040/, " ", s); gsub(/\\011/, "\t", s)
			gsub(/\\012/, "\n", s); gsub(/\\134/, "\\", s)
			return s
		}
		BEGIN { while (length(p) > 1 && substr(p, length(p), 1) == "/") p = substr(p, 1, length(p) - 1) }
		{
			dev = $1; mp = unescape($2)
			match_path = (mp == "/" ? substr(p, 1, 1) == "/" : (p == mp || index(p, mp "/") == 1))
			if (match_path && length(mp) > best) { best = length(mp); bestdev = dev; bestmp = mp }
		}
		END { if (best) print bestdev "|" bestmp }
	' "${NF_MOUNTS:-/proc/mounts}" 2>/dev/null
}

on_flash() {    # 0 = встроенное/неподтверждённое хранилище (запись запрещена), 1 = внешний mount
	local mi fd mp
	mi=$(persist_mount_info "$1")
	[ -n "$mi" ] || return 0
	fd=${mi%%|*}; mp=${mi#*|}
	# PERSIST_ANY разрешает нестандартные устройства, но никогда не разрешает писать в корневую overlay/ROM.
	case "$mp" in /|/overlay|/rom) return 0 ;; esac
	[ "$PERSIST_ANY" = 1 ] && return 1
	# Только явно распознанные внешние блочные устройства. Неизвестные источники запрещаем по умолчанию.
	case "$fd" in /dev/mmcblk*|/dev/sd[a-z]*|/dev/nvme*|/dev/vd[a-z]*|/dev/loop*) return 1 ;; esac
	return 0
}

PFILES="extip.log hist.coarse temps.coarse hist.long wifi.hr dev.hr dev.snap dev.daily router.ips events.log dev.day dev.yday day.date speed.log apps.day apps.hist traffic.daily acct.v"
procmem_point() {   # раз в 15 минут: память (RSS, КБ) десяти самых «толстых» программ; по ней монитор ищет утечки
	[ "$LITE" = 1 ] && return 0
	cat "${NF_PROCDIR:-/proc}"/[0-9]*/status 2>/dev/null | awk '
		/^Name:/ { n = $2 } /^VmRSS:/ { if (n != "") { m[n] += $2; n = "" } }
		END { for (k in m) if (m[k] >= 1024) print m[k], k }' | sort -rn | head -n 10 | awk -v t="$(date +%s)" '{ printf "%s%s:%s", (n++ ? " " : t " "), $2, $1 } END { if (n) print "" }' >> "$DIR/procmem.log"
}
extip_point() {   # адрес роутера на WAN: пишем только когда он сменился
	ip=$(ifstatus wan 2>/dev/null | jsonfilter -e '@["ipv4-address"][0].address' 2>/dev/null)
	[ -n "$ip" ] || return 0
	[ "$(tail -n 1 "$DIR/extip.log" 2>/dev/null | awk '{ print $2 }')" = "$ip" ] && return 0
	echo "$(date +%s) $ip" >> "$DIR/extip.log"
}
persist_warn() {
	if [ "${persist_error_notified:-0}" != 1 ]; then event warn "$1"; fi
	persist_ok=0; persist_error=$2; persist_error_notified=1
}

persist() {
	local mi mp rel rc
	[ -n "$PERSIST_DIR" ] || return 0
	mi=$(persist_mount_info "$PERSIST_DIR")
	if [ -z "$mi" ] || on_flash "$PERSIST_DIR"; then
		persist_warn "Постоянная история недоступна: $PERSIST_DIR не находится на подключённом внешнем накопителе. Сбор данных продолжается в RAM" 0
		return 1
	fi
	mp=${mi#*|}; rel=${PERSIST_DIR#"$mp"}; rel=${rel#/}
	case "/$rel/" in */../*) persist_warn "Некорректный путь постоянной истории: $PERSIST_DIR" 1; return 1 ;; esac

	# При первом подключении или после возврата USB объединяем временную RAM-историю с архивной.
	[ "$persist_ok" = 1 ] || restore

	# Переход внутрь mount удерживает файловую систему на время записи: штатное отключение не
	# сможет незаметно переключить путь в нижележащий overlay.
	(
		cd "$mp" 2>/dev/null || exit 3
		on_flash "$PWD" && exit 2
		if [ -n "$rel" ]; then
			mkdir -p "$rel" 2>/dev/null || exit 3
			cd "$rel" 2>/dev/null || exit 3
		fi
		on_flash "$PWD" && exit 2
		for f in $PFILES; do
			[ -f "$DIR/$f" ] || continue
			cmp -s "$DIR/$f" "$f" 2>/dev/null && continue
			if ! cp "$DIR/$f" "$f.tmp" 2>/dev/null; then rm -f "$f.tmp"; exit 3; fi
			if on_flash "$PWD"; then rm -f "$f.tmp"; exit 2; fi
			if ! mv "$f.tmp" "$f" 2>/dev/null; then rm -f "$f.tmp"; exit 3; fi
		done
	)
	rc=$?
	if [ "$rc" = 2 ]; then
		persist_warn "Внешний накопитель $PERSIST_DIR отключён; запись на внутреннюю память запрещена. Сбор данных продолжается в RAM" 0
		return 1
	elif [ "$rc" != 0 ]; then
		persist_warn "Не удалось сохранить постоянную историю в $PERSIST_DIR; проверьте накопитель и файловую систему" 1
		return 1
	fi

	persist_ok=1
	persist_last=$(date +%s)
	persist_kb=$(du -sk "$PERSIST_DIR" 2>/dev/null | awk '{ print $1 + 0 }')
	if [ "${persist_error_notified:-0}" = 1 ]; then event ok "Постоянное хранение Nightfall снова работает"; fi
	persist_error=0; persist_error_notified=0
	return 0
}

restore() {
	local mi mp rel f
	[ "${persist_ok:-0}" = 1 ] && return 0
	[ -n "$PERSIST_DIR" ] || return 0
	mi=$(persist_mount_info "$PERSIST_DIR")
	[ -n "$mi" ] && ! on_flash "$PERSIST_DIR" || return 0
	mp=${mi#*|}; rel=${PERSIST_DIR#"$mp"}; rel=${rel#/}
	case "/$rel/" in */../*) return 1 ;; esac
	(
		cd "$mp" 2>/dev/null || exit 1
		on_flash "$PWD" && exit 1
		[ -n "$rel" ] && { [ -d "$rel" ] || exit 0; cd "$rel" 2>/dev/null || exit 1; }
		on_flash "$PWD" && exit 1
		for f in $PFILES; do
			[ -f "$f" ] || continue
			if [ ! -f "$DIR/$f" ]; then
				cp "$f" "$DIR/$f" 2>/dev/null || :
				continue
			fi
			# Исторические ряды объединяем по полным строкам и времени, чтобы подключение USB
			# после длительного отсутствия не затирало архив свежей RAM-историей.
			case "$f" in
				extip.log|hist.coarse|temps.coarse|hist.long|wifi.hr|dev.hr|events.log|speed.log)
					if [ "$f" = apps.hist ]; then
						cat "$f" "$DIR/$f" | awk '!seen[$0]++' | sort -t'|' -n -k1,1 > "$DIR/$f.merge"
					else
						cat "$f" "$DIR/$f" | awk '!seen[$0]++' | sort -n -k1,1 > "$DIR/$f.merge"
					fi
					case "$f" in
						extip.log) limit=200 ;;
						hist.coarse|temps.coarse) limit=2016 ;;
						hist.long) limit=$((HIST_DAYS * 48)) ;;
						wifi.hr) limit=12000 ;;
						dev.hr|dev.daily) limit=6000 ;;
						events.log) limit=300 ;;
						speed.log) limit=400 ;;
						apps.hist) limit=18000 ;;
						traffic.daily) limit=400 ;;
					esac
					tail -n "$limit" "$DIR/$f.merge" > "$DIR/$f.trim" && mv "$DIR/$f.trim" "$DIR/$f" || rm -f "$DIR/$f.merge" "$DIR/$f.trim"
					rm -f "$DIR/$f.merge"
					;;
				router.ips)
					cat "$f" "$DIR/$f" | awk '!seen[$0]++' | tail -n 16 > "$DIR/$f.merge"
					mv "$DIR/$f.merge" "$DIR/$f" 2>/dev/null || rm -f "$DIR/$f.merge"
					;;
				dev.day|apps.day)
					# Суточные счётчики складываем только если USB и RAM относятся к одной дате.
					pday=$(cat day.date 2>/dev/null); rday=$(cat "$DIR/day.date" 2>/dev/null)
					[ -n "$pday" ] && [ "$pday" = "$rday" ] || continue
					if [ "$f" = dev.day ]; then
						awk '{ d[$1]+=$2; u[$1]+=$3 } END { for (k in d) printf "%s %.0f %.0f %.0f\n", k, d[k], u[k], d[k]+u[k] }' "$f" "$DIR/$f" | sort -k4,4nr | head -n 64 | cut -d' ' -f1-3 > "$DIR/$f.merge"
					else
						awk -F'|' '{ k=$1 "|" $2; d[k]+=$3; u[k]+=$4 } END { for (k in d) printf "%s|%.0f|%.0f\n", k, d[k], u[k] }' "$f" "$DIR/$f" | sort -t'|' -k3,3nr | head -n 600 > "$DIR/$f.merge"
					fi
					mv "$DIR/$f.merge" "$DIR/$f" 2>/dev/null || rm -f "$DIR/$f.merge"
					;;
				traffic.daily)
					awk '{ d[$1]+=$2; u[$1]+=$3 } END { for (k in d) printf "%s %.0f %.0f\n", k, d[k], u[k] }' "$f" "$DIR/$f" | sort -n -k1,1 | tail -n 400 > "$DIR/$f.merge"
					mv "$DIR/$f.merge" "$DIR/$f" 2>/dev/null || rm -f "$DIR/$f.merge"
					;;
				dev.daily)
					awk '{ k=$1 "|" $2 "|" $5; d[k]+=$3; u[k]+=$4 } END { for (k in d) { split(k,a,"|"); printf "%s %s %.0f %.0f %s\n",a[1],a[2],d[k],u[k],a[3] } }' "$f" "$DIR/$f" | sort -n -k1,1 | tail -n 6000 > "$DIR/$f.merge"
					mv "$DIR/$f.merge" "$DIR/$f" 2>/dev/null || rm -f "$DIR/$f.merge"
					;;
				apps.hist)
					awk -F'|' '{ k=$1 "|" $2 "|" $3; d[k]+=$4; u[k]+=$5 } END { for (k in d) printf "%s|%.0f|%.0f\n", k, d[k], u[k] }' "$f" "$DIR/$f" | sort -t'|' -n -k1,1 | tail -n 18000 > "$DIR/$f.merge"
					mv "$DIR/$f.merge" "$DIR/$f" 2>/dev/null || rm -f "$DIR/$f.merge"
					;;
			esac
		done
	)
}

# ---------- журнал перезагрузок и обрывов связи (редкие короткие записи на флеш) ----------
jwrite() {      # jwrite TS TYPE DURATION TEXT
	[ "$JOURNAL" = 1 ] || return 0
	printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$(clean "$4")" >> "$JOURNAL_FILE" 2>/dev/null || return 0
	if [ "$(wc -l < "$JOURNAL_FILE" 2>/dev/null)" -gt 260 ]; then
		tail -n 200 "$JOURNAL_FILE" > "$JOURNAL_FILE.tmp" 2>/dev/null && mv "$JOURNAL_FILE.tmp" "$JOURNAL_FILE"
	fi
}

# ---------- Wi-Fi клиенты в динамике (раз в минуту, только в памяти) ----------
do_wifi() {
	command -v ubus >/dev/null 2>&1 || return 0
	devs=$(ubus call iwinfo devices 2>/dev/null | awk -F'"' 'NF >= 3 && $2 != "devices" { print $2 }')
	[ -n "$devs" ] || return 0
	: > "$DIR/wifi.cur.new"
	for d in $devs; do
		ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null | awk -v ts="$now" -v d="$d" -F'"' '
			$2 == "mac" { m = tolower($4) }
			$2 == "signal" && m != "" { s = $3; gsub(/[^-0-9]/, "", s); if (s != "") print ts, m, s, d; m = "" }' >> "$DIR/wifi.cur.new"
	done
	cat "$DIR/wifi.cur.new" >> "$DIR/wifi.fine"
	if [ -f "$DIR/wifi.cur" ]; then
		awk -v ts="$now" 'NR == FNR { old[$2] = $4; next } { new_[$2] = $4; if (!($2 in old)) print ts, $2, "join", $4 }
			END { for (m in old) if (!(m in new_)) print ts, m, "leave", old[m] }' "$DIR/wifi.cur" "$DIR/wifi.cur.new" >> "$DIR/wifi.ev"
	fi
	mv "$DIR/wifi.cur.new" "$DIR/wifi.cur"
}

# ---------- почасовые ряды: сигнал Wi-Fi по клиентам и трафик по устройствам ----------
wifi_hour() {   # средний сигнал каждого клиента за прошедший час: «время mac сигнал замеров»
	[ -s "$DIR/wifi.fine" ] || return 0
	awk -v ts="$now" -v lim=$((now - 3600)) '$1 >= lim && $3 ~ /^-?[0-9]+$/ { s[$2] += $3; c[$2]++ }
		END { for (m in s) printf "%s %s %d %d\n", ts, m, s[m] / c[m], c[m] }' "$DIR/wifi.fine" >> "$DIR/wifi.hr"
}
dev_hour() {    # сколько каждое устройство передало за прошедший час: «время ip скачано отдано»
	local today prev=
	today=$(date +%Y%m%d)
	[ -s "$DIR/dev.day" ] || { echo "#$today" > "$DIR/dev.snap"; return 0; }
	if [ ! -f "$DIR/dev.snap" ]; then { echo "#$today"; cat "$DIR/dev.day"; } > "$DIR/dev.snap"; return 0; fi   # нет точки отсчёта: первый час не пишем
	read -r prev < "$DIR/dev.snap"
	awk -v ts="$now" -v same=$([ "$prev" = "#$today" ] && echo 1 || echo 0) 'FILENAME == ARGV[1] { if ($1 !~ /^#/) { pd[$1] = $2; pu[$1] = $3 } next }
		{ d = $2; u = $3; if (same && ($1 in pd)) { dd = d - pd[$1]; du = u - pu[$1]; if (dd < 0 || du < 0) { dd = d; du = u } } else { dd = d; du = u }
		  if (dd + du > 0) printf "%s %s %.0f %.0f\n", ts, $1, dd, du }' "$DIR/dev.snap" "$DIR/dev.day" >> "$DIR/dev.hr"
	{ echo "#$today"; cat "$DIR/dev.day"; } > "$DIR/dev.snap"
}
# длинная история: средние за 30 минут по шести точкам hist.coarse и пики скорости
long_point() {
	[ -s "$DIR/hist.coarse" ] || return 0
	tail -n 6 "$DIR/hist.coarse" | awk '{ last = $1; for (i = 2; i <= 10; i++) if ($i >= 0) { s[i] += $i; c[i]++ } if ($5 > pr) pr = $5; if ($6 > pt) pt = $6 }
		END { printf "%d", last; for (i = 2; i <= 10; i++) printf " %s", (c[i] ? sprintf("%.1f", s[i] / c[i]) : -1); printf " %d %d\n", pr, pt }' >> "$DIR/hist.long"
}

stop() { persist; exit 0; }
trap stop TERM INT

# блокировка устройств: правила применяются при старте и раз в минуту (расписание), если список не пуст
do_block() {
	[ -x "$BLOCKBIN" ] || return 0
	if [ -s "$BLOCKLIST" ] || [ -s "$GROUPLIST" ]; then
		bt=$((bt + 1)); [ "$bt" = 1 ] || [ $((now - blast)) -ge 60 ] || return 0
		blast=$now; "$BLOCKBIN" apply >/dev/null 2>&1; bhad=1
	elif [ "$bhad" = 1 ]; then
		bhad=0; "$BLOCKBIN" apply >/dev/null 2>&1
	fi
}
bt=0; blast=0; bhad=0

# ежедневный отчёт: раз в сутки в заданное время (ЧЧ:ММ), метка последней отправки хранится рядом с данными
do_report() {
	[ "$TG" = 1 ] && [ -n "$TG_REPORT" ] && [ -x "$BOTBIN" ] || return 0
	hm=$(date +%H:%M); [ "$hm" = "$TG_REPORT" ] || return 0
	td=$(date +%Y-%m-%d); [ "$(cat "$REPORT_MARK" 2>/dev/null)" = "$td" ] && return 0
	echo "$td" > "$REPORT_MARK"
	txt=$("$BOTBIN" report 2>/dev/null) && [ -n "$txt" ] && tgsend "$txt"
}

# ---------- основной цикл ----------
now=$(date +%s); started=$now
# Состояние постоянного хранилища определяется заново при каждой записи.
# Не создаём PERSIST_DIR до подтверждения внешнего mount: иначе отсутствующая USB станет каталогом на overlay.
persist_ok=0; persist_error=0; persist_error_notified=0
# аппаратное ускорение пакетов (HW flow offloading) прячет трафик от счётчиков сетевых портов
FLOW_HW=0; command -v uci >/dev/null 2>&1 && [ "$(uci -q get firewall.@defaults[0].flow_offloading_hw 2>/dev/null)" = 1 ] && FLOW_HW=1
case "$HIST_DAYS" in ''|*[!0-9]*) HIST_DAYS=30 ;; esac; [ "$HIST_DAYS" -ge 7 ] || HIST_DAYS=7; [ "$HIST_DAYS" -le 90 ] || HIST_DAYS=90
case "$PERSIST_HOURS" in ''|*[!0-9]*) PERSIST_HOURS=6 ;; esac; [ "$PERSIST_HOURS" -ge 1 ] || PERSIST_HOURS=1
restore
[ -n "$PERSIST_DIR" ] && persist
read -r up0 _ < "$PROC/uptime" 2>/dev/null; up0=${up0%.*}; case "$up0" in ''|*[!0-9]*) up0=99999 ;; esac
boot_pending=0; [ "$up0" -lt 300 ] && boot_pending=1
gap_note=""
if [ -s "$DIR/hist.coarse" ]; then lastts=$(tail -n 1 "$DIR/hist.coarse" | cut -d' ' -f1); else lastts=0; fi
out_n=0; out_t=0; out_gwfail=0; last_speed=0; wtick=0
[ -s "$DIR/speed.log" ] && last_speed=$(tail -n 1 "$DIR/speed.log" | cut -d' ' -f1)
: > "$DIR/alerts.active"
ptot=""; pidl=""; prx=""; ptx=""; pts=""; tick=0; loops=0

while :; do
	now=$(date +%s)
	tick=$((tick + 1))

	# процессор
	cpu=-1
	read -r _ u n s i w q sq st _ < "$PROC/stat"
	tot=$((u + n + s + i + w + q + sq + st)); idl=$((i + w))
	if [ -n "$ptot" ]; then
		dt=$((tot - ptot)); di=$((idl - pidl))
		[ "$dt" -gt 0 ] && cpu=$((100 * (dt - di) / dt))
	fi
	ptot=$tot; pidl=$idl

	# память
	set -- $(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } /^MemFree:/ { f = $2 } /^Buffers:/ { b = $2 } /^Cached:/ { c = $2 } END { if (a == "") a = f + b + c; print t + 0, a + 0 }' "$PROC/meminfo")
	memt=${1:-0}; mema=${2:-0}
	mem=0; [ "$memt" -gt 0 ] && mem=$((100 * (memt - mema) / memt))

	temp=$(read_temp)

	# WAN-интерфейс и шлюз (маршрут по умолчанию)
	if [ -n "$NF_WAN_DEV" ]; then wdev=$NF_WAN_DEV; gw=${NF_GW:-}
	else
		set -- $(ip -4 route show default 2>/dev/null | awk 'NR == 1 { d = ""; g = ""; for (i = 1; i <= NF; i++) { if ($i == "dev") d = $(i + 1); if ($i == "via") g = $(i + 1) } print d, g }')
		wdev=${1:-}; gw=${2:-}
	fi

	# скорость WAN
	rx=-1; tx=-1; dtm=0
	if [ -n "$wdev" ]; then
		set -- $(awk -v d="$wdev" '{ gsub(/:/, " ") } $1 == d { print $2, $10 }' "$PROC/net/dev")
		crx=$1; ctx=$2
		if [ -n "$crx" ] && [ -n "$prx" ] && [ -n "$pts" ]; then
			dtm=$((now - pts))
			if [ "$dtm" -gt 0 ]; then
				rx=$(( (crx - prx) / dtm )); tx=$(( (ctx - ptx) / dtm ))
				[ "$rx" -ge 0 ] || rx=0; [ "$tx" -ge 0 ] || tx=0
			fi
		fi
		prx=$crx; ptx=$ctx
	else
		prx=""; ptx=""
	fi
	traffic_day
	[ "$dtm" -gt 0 ] || dtm=$((now - ${pts:-$now}))
	pts=$now

	# задержка до шлюза и до интернета
	gwms=-1; netms=-1
	[ -n "$gw" ] && gwms=$(ping_ms "$gw")
	if [ -n "$PING_TARGET" ]; then
		netms=$(ping_ms "$PING_TARGET")
		[ "$netms" = -1 ] && [ -n "$PING_TARGET2" ] && netms=$(ping_ms "$PING_TARGET2")
	fi
	loss=0; [ "$netms" = -1 ] && loss=100

	# журнал обрывов: старт — первый неудачный замер, запись — когда связь вернулась (от 2 неудач подряд)
	if [ -n "$PING_TARGET" ] && [ "$tick" -gt 1 ] && [ "$now" -gt 1700000000 ]; then
		if [ "$netms" = -1 ]; then
			out_n=$((out_n + 1)); [ "$out_n" = 1 ] && { out_t=$now; out_gwfail=0; }
			[ "$gwms" = -1 ] && [ -n "$gw" ] && out_gwfail=1
		elif [ "$out_n" -gt 0 ]; then
			if [ "$out_n" -ge 2 ]; then
				if [ "$out_gwfail" = 1 ]; then cz="нет связи со шлюзом (кабель, модем или провайдер)"; else cz="шлюз отвечал, нет выхода в интернет (провайдер или DNS)"; fi
				jwrite "$out_t" outage "$((now - out_t))" "$cz"
			fi
			out_n=0
		fi
	fi
	# журнал перезагрузок: пишем один раз после синхронизации времени
	if [ "$boot_pending" = 1 ] && [ "$now" -gt 1700000000 ]; then
		boot_pending=0
		read -r upn _ < "$PROC/uptime"; upn=${upn%.*}; bt=$((now - upn))
		if [ "$lastts" -gt 1700000000 ] && [ "$bt" -gt "$lastts" ]; then gap_note="; данных не было $(fmt_dur $((bt - lastts)))"; fi
		if ! tail -n 5 "$JOURNAL_FILE" 2>/dev/null | awk -F'|' -v bt="$bt" '$2 == "boot" { d = bt - $1; if (d < 0) d = -d; if (d < 180) f = 1 } END { exit !f }'; then
			jwrite "$bt" boot 0 "Роутер загружен${gap_note}"
			[ "$TG_ALERTS" = 1 ] && tgsend "🔄 Роутер загружен${gap_note}"
		fi
	fi

	# соединения, диск
	ctn=0; ctm=0
	# /proc/sys читаем через cat: BusyBox read читает по байту, а sysctl при этом отдаёт только первую цифру
	[ -r "$PROC/sys/net/netfilter/nf_conntrack_count" ] && ctn=$(cat "$PROC/sys/net/netfilter/nf_conntrack_count" 2>/dev/null)
	[ -r "$PROC/sys/net/netfilter/nf_conntrack_max" ] && ctm=$(cat "$PROC/sys/net/netfilter/nf_conntrack_max" 2>/dev/null)
	case "$ctn" in ''|*[!0-9]*) ctn=0 ;; esac
	case "$ctm" in ''|*[!0-9]*) ctm=0 ;; esac
	fp=/overlay; [ -d /overlay ] || fp=/
	fl=$(df -kP "$fp" 2>/dev/null | awk 'END { if (NR > 1 && $2 > 0) print int($3 * 100 / $2); else print 0 }')

	# история пишется только когда часы синхронизированы и после первого замера
	if [ "$now" -gt 1700000000 ] && [ "$tick" -gt 1 ]; then
		printf '%s %s %s %s %s %s %s %s %s %s\n' "$now" "$cpu" "$mem" "$temp" "$rx" "$tx" "$gwms" "$netms" "$loss" "$ctn" >> "$DIR/hist.fine"
		tl=$(read_temps); [ -n "$tl" ] && printf '%s %s\n' "$now" "$tl" >> "$DIR/temps.fine"
		do_dns
		do_devices
		do_newdev
		do_block
		[ -f /etc/nightfall-guest.list ] && [ $((tick % (STEP >= 60 ? 2 : 6))) = 0 ] && /usr/libexec/nightfall-guest tick >/dev/null 2>&1
		do_report
		wtick=$((wtick + 1))
		if [ "$WIFI_HIST" = 1 ] && [ $((wtick % 4)) = 1 ]; then do_wifi; fi
		if [ "$SPEED_HOURS" -gt 0 ] 2>/dev/null && [ "$netms" != -1 ] && [ $((now - last_speed)) -ge $((SPEED_HOURS * 3600)) ] && [ "$rx" -lt 400000 ] 2>/dev/null; then
			last_speed=$now
			[ -x /usr/libexec/nightfall-speed ] && /usr/libexec/nightfall-speed start >/dev/null 2>&1
		fi

		# предупреждения
		ti=${temp%.*}; [ "$ti" -ge 0 ] 2>/dev/null || ti=0
		c=0; [ "$ti" -ge "$TEMP_WARN" ] && [ "$ti" -lt "$TEMP_CRIT" ] && c=1
		alert temp warn $((60 / STEP + 1)) $c "Процессор перегрет: ${temp} °C (порог $TEMP_WARN °C)"
		c=0; [ "$ti" -ge "$TEMP_CRIT" ] && c=1
		alert tempc crit 2 $c "Критическая температура процессора: ${temp} °C"
		c=0; [ "$mem" -gt $((100 - MEM_MIN_PCT)) ] && c=1
		alert mem warn $((120 / STEP)) $c "Мало свободной памяти: занято ${mem}%"
		c=0; [ "$fl" -ge "$FLASH_MAX_PCT" ] && c=1
		alert flash warn 2 $c "Флеш-память почти заполнена: ${fl}%"
		c=0; [ "$ctm" -gt 0 ] && [ $((100 * ctn / ctm)) -ge "$CT_MAX_PCT" ] && c=1
		alert ct warn 2 $c "Таблица соединений заполнена на $((100 * ctn / ${ctm:-1}))%"
		c=0; [ "$cpu" -ge "$CPU_MAX_PCT" ] && c=1
		alert cpu warn $((CPU_MINUTES * 60 / STEP)) $c "Процессор загружен на ${cpu}% дольше ${CPU_MINUTES} мин"
		if [ -n "$PING_TARGET" ]; then
			c=0; [ "$netms" = -1 ] && c=1
			if [ "$gwms" = -1 ] && [ -n "$gw" ]; then wt="Нет связи со шлюзом $gw"; else wt="Нет доступа в интернет"; fi
			alert wan crit 3 $c "$wt"
		fi

		# раз в 5 минут: сводная точка за неделю, обрезка, сохранение
		if [ $((tick % AGG)) = 0 ]; then
			tail -n "$AGG" "$DIR/hist.fine" | awk '{ for (i = 2; i <= 10; i++) if ($i >= 0) { s[i] += $i; c[i]++ } last = $1 }
				END { printf "%d", last; for (i = 2; i <= 10; i++) printf " %s", (c[i] ? sprintf("%.1f", s[i] / c[i]) : -1); print "" }' >> "$DIR/hist.coarse"
			[ -s "$DIR/temps.fine" ] && tail -n "$AGG" "$DIR/temps.fine" | awk '{ last = $1; for (i = 2; i <= NF; i++) { j = index($i, ":"); k = substr($i, 1, j - 1); v = substr($i, j + 1) + 0; if (!(k in c)) o[++no] = k; s[k] += v; c[k]++ } }
				END { if (!no) exit; printf "%d", last; for (i = 1; i <= no; i++) printf " %s:%.1f", o[i], s[o[i]] / c[o[i]]; print "" }' >> "$DIR/temps.coarse"
			[ $((tick % (AGG * 6))) = 0 ] && long_point
			extip_point
			[ $((tick % (AGG * 3))) = 0 ] && procmem_point
			# всплеск неудачных входов (SSH, LuCI): сообщение в Telegram, если TG_SEC не выключен
			if [ "$TG" = 1 ] && [ "$TG_SEC" != 0 ] && [ -x /usr/libexec/nightfall-sec ]; then
				m=$(NF_DIR="$DIR" /usr/libexec/nightfall-sec watch 2>/dev/null); [ -z "$m" ] || tgsend "🛡 $m"
			fi
			[ $((tick % (AGG * 12))) = 0 ] && { wifi_hour; dev_hour; }
			for f in "hist.fine 400" "hist.coarse 2016" "temps.fine 400" "temps.coarse 2016" "hist.long $((HIST_DAYS * 48))" "wifi.hr 12000" "dev.hr 6000" "events.log 300" "wifi.fine 8000" "wifi.ev 400" "extip.log 200" "procmem.log 672" "speed.log 400"; do
				[ -f "$DIR/${f% *}" ] || continue
				set -- $f
				if [ "$(wc -l < "$DIR/$1")" -gt "$2" ]; then tail -n "$2" "$DIR/$1" > "$DIR/$1.tmp" && mv "$DIR/$1.tmp" "$DIR/$1"; fi
			done
			write_info
			[ $((tick % (AGG * 12 * PERSIST_HOURS))) = 0 ] && persist
		fi
	fi
	[ "$tick" = 1 ] && { write_info; event info "Сборщик истории запущен"; }

	loops=$((loops + 1))
	[ "$LOOPS" -gt 0 ] && [ "$loops" -ge "$LOOPS" ] && break
	sleep "$STEP" & wait $!
done