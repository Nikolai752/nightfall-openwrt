#!/bin/sh
# Nightfall collector: фоновый сборщик истории для «Монитора ресурсов».
# Раз в STEP секунд (15) пишет в /tmp/nightfall:
#   hist.fine    — последний час (шаг 15 с)
#   hist.coarse  — последние 7 суток (шаг 5 мин)
#   dev.rate / dev.day / dev.yday — трафик по устройствам (из conntrack accounting)
#   apps.day / apps.hist, dns.map — трафик по приложениям (при APPS=1; имена из журнала DNS dnsmasq)
#   events.log, alerts.active    — события и активные предупреждения
# Настройки: /etc/nightfall-monitor.conf (см. /usr/share/nightfall/nightfall-monitor.conf.default)

PROC=${NF_PROC:-/proc}
SYS=${NF_SYS:-/sys}
DIR=${NF_DIR:-/tmp/nightfall}
CONF=${NF_CONF:-/etc/nightfall-monitor.conf}
STEP=${NF_STEP:-15}
LOOPS=${NF_LOOPS:-0}            # для тестов: сколько циклов выполнить (0 = бесконечно)
CT=${NF_CT:-$PROC/net/nf_conntrack}

TEMP_WARN=80; TEMP_CRIT=90; MEM_MIN_PCT=10; FLASH_MAX_PCT=90; CT_MAX_PCT=80
CPU_MAX_PCT=90; CPU_MINUTES=3
PING_TARGET=1.1.1.1; PING_TARGET2=77.88.8.8
PERSIST_DIR=; PERSIST_HOURS=6; PERSIST_ANY=0; JOURNAL=1; WIFI_HIST=1; SPEED_HOURS=0; APPS=0; NEWDEV=1; TG=0; TG_ALERTS=1; TG_REPORT=
NOTIFY=${NF_NOTIFY:-/usr/libexec/nightfall-notify}
KNOWN=${NF_KNOWN:-/etc/nightfall-known.list}
LEASES=${NF_LEASES:-/tmp/dhcp.leases}
DNSLOG=${NF_DNSLOG:-/tmp/nightfall-dns.log}
RULES=${NF_RULES:-/usr/share/nightfall/apps.list}
RULES_USER=${NF_RULES_USER:-/etc/nightfall-apps.list}
SPEED_URL=https://speed.cloudflare.com/__down?bytes=25000000
JOURNAL_FILE=${NF_JOURNAL:-/etc/nightfall-journal.log}
[ -r "$CONF" ] && . "$CONF"

mkdir -p "$DIR" || exit 1

# одна копия: если уже работает другой сборщик (например, оставшийся от прошлой версии), останавливаем его
for p in /proc/[0-9]*; do
	pid=${p#/proc/}
	[ "$pid" = "$$" ] && continue
	cmd=$( { tr '\0' ' ' < "$p/cmdline"; } 2>/dev/null )
	case "$cmd" in "/bin/sh $0 "*|"sh $0 "*) kill "$pid" 2>/dev/null ;; esac
done
echo $$ > "$DIR/pid"
AGG=${NF_AGG:-$((300 / STEP))}  # сколько шагов в 5 минутах
[ "$AGG" -ge 1 ] || AGG=1
HOST=$(cat "$PROC/sys/kernel/hostname" 2>/dev/null || echo router)

# ---------- события и предупреждения ----------
clean() { printf '%s' "$1" | tr -d '"\\|' | tr '\n' ' '; }

BLOCKBIN=${NF_BLOCKBIN:-/usr/libexec/nightfall-block}
BOTBIN=${NF_BOTBIN:-/usr/libexec/nightfall-bot}
BLOCKLIST=${NF_BLOCK:-/etc/nightfall-block.list}
GROUPLIST=${NF_GROUPS:-/etc/nightfall-groups.list}
REPORT_MARK="$DIR/report.sent"

tgsend() {  # tgsend ТЕКСТ [КНОПКИ_JSON]: в фоне, чтобы сбой сети не тормозил сборщик
	[ "$TG" = 1 ] && [ -x "$NOTIFY" ] || return 0
	"$NOTIFY" send "$1" "$2" >/dev/null 2>&1 &
}

event() {   # event LEVEL TEXT [quiet]
	printf '%s|%s|%s\n' "$now" "$1" "$(clean "$2")" >> "$DIR/events.log"
	[ "$3" = quiet ] && return 0
	[ "$TG_ALERTS" = 1 ] || return 0
	case "$1" in
		warn) tgsend "⚠️ $(clean "$2")" ;;
		bad) tgsend "🔴 $(clean "$2")" ;;
		ok) tgsend "✅ $(clean "$2")" ;;
	esac
}

fmt_dur() {
	d=$1
	if [ "$d" -ge 3600 ]; then echo "$((d / 3600)) ч $((d % 3600 / 60)) мин"
	elif [ "$d" -ge 60 ]; then echo "$((d / 60)) мин $((d % 60)) с"
	else echo "$d с"; fi
}

# alert KEY LEVEL NEED_ON COND(0|1) TEXT
alert() {
	k=$1; lvl=$2; need=$3; cond=$4; txt=$5
	eval "n=\${n_$k:-0}; f=\${f_$k:-0}; a=\${a_$k:-0}"
	if [ "$cond" = 1 ]; then
		n=$((n + 1)); f=0
		if [ "$a" = 0 ] && [ "$n" -ge "$need" ]; then
			a=$now
			printf '%s|%s|%s|%s\n' "$k" "$now" "$lvl" "$(clean "$txt")" >> "$DIR/alerts.active"
			event "$lvl" "$txt"
			logger -t nightfall -p daemon.warning "$txt" 2>/dev/null
		fi
	else
		f=$((f + 1)); n=0
		if [ "$a" != 0 ] && [ "$f" -ge 2 ]; then
			dur=$(fmt_dur $((now - a)))
			was=$(grep "^$k|" "$DIR/alerts.active" 2>/dev/null | head -n 1 | cut -d'|' -f4)
			[ -n "$was" ] || was=$txt
			grep -v "^$k|" "$DIR/alerts.active" > "$DIR/alerts.tmp" 2>/dev/null; mv "$DIR/alerts.tmp" "$DIR/alerts.active"
			event ok "Снова в норме: $was (длилось $dur)"
			logger -t nightfall "Снова в норме: $was" 2>/dev/null
			a=0
		fi
	fi
	eval "n_$k=$n; f_$k=$f; a_$k=$a"
}

# ---------- измерения ----------
read_temp() {   # печатает температуру процессора в °C с десятой долей или -1
	best=""; first=""
	for z in "$SYS"/class/thermal/thermal_zone*; do
		[ -r "$z/temp" ] || continue
		t=""; read -r t < "$z/temp" 2>/dev/null || continue
		nm=""; read -r nm < "$z/type" 2>/dev/null
		case "$nm" in *phy*|*mt76*|*mt79*|*wifi*|*wlan*|*ath*|*iwlwifi*) continue ;; esac
		[ -n "$first" ] || first=$t
		case "$nm" in *cpu*|*soc*|*core*|*a53*|*a73*|*thermal*) best=$t; break ;; esac
	done
	if [ -z "$best" ]; then
		for h in "$SYS"/class/hwmon/hwmon*; do
			[ -r "$h/temp1_input" ] || continue
			read -r first < "$h/temp1_input" 2>/dev/null && break
		done
	fi
	[ -n "$best" ] || best=$first
	case "$best" in ''|*[!0-9]*) echo -1; return ;; esac
	[ "$best" -gt 0 ] || { echo -1; return; }
	echo "$((best / 1000)).$((best % 1000 / 100))"
}

ping_ms() {     # ping_ms HOST -> миллисекунды или -1
	[ -n "$1" ] || { echo -1; return; }
	r=$(ping -c 1 -W 1 "$1" 2>/dev/null | awk -F'time=' '/time=/ { split($2, a, " "); print a[1]; exit }')
	[ -n "$r" ] && echo "$r" || echo -1
}

# ---------- новые устройства ----------
# Источник: ARP-таблица (проводные и Wi-Fi) и аренды DHCP. Первый запуск только запоминает то, что уже есть.
do_newdev() {
	[ "$NEWDEV" = 1 ] || return 0
	[ -r "$PROC/net/arp" ] || return 0
	seed=0; [ -f "$KNOWN" ] || seed=1
	awk -v known="$KNOWN" -v leases="$LEASES" -v seed="$seed" -v out="$DIR/newdev.out" -v wan="$wdev" '
		BEGIN {
			while ((getline l < known) > 0) { split(l, a, "|"); k[a[1]] = 1 }
			close(known)
			while ((getline l < leases) > 0) { split(l, a, " "); m = tolower(a[2]); nm[m] = (a[4] == "*" ? "" : a[4]); ip[m] = a[3]; ls[m] = 1 }
			close(leases)
		}
		NR > 1 && $3 == "0x2" && $4 != "00:00:00:00:00:00" && $6 != wan {
			m = tolower($4); ip[m] = $1
			if (!(m in k)) { k[m] = 1; print m "|" nm[m] "|" ip[m] > out; n++ }
		}
		END {
			# арендованные, но сейчас не видимые адреса тоже считаем знакомыми (иначе после включения «новыми» станут свои выключенные устройства)
			for (m in ls) if (!(m in k)) { k[m] = 1; print m "|" nm[m] "|" ip[m] > out }
		}' "$PROC/net/arp"
	[ -s "$DIR/newdev.out" ] || { rm -f "$DIR/newdev.out"; [ "$seed" = 1 ] && : > "$KNOWN"; return 0; }
	while IFS='|' read -r m nm ipa; do
		printf '%s|%s|%s\n' "$m" "$nm" "$now" >> "$KNOWN"
		[ "$seed" = 1 ] && continue
		h=$(printf '%s' "$m" | cut -c2)
		priv=""; case "$h" in 2|6|a|e|A|E) priv=" (частный адрес Wi-Fi, у телефона он может меняться)" ;; esac
		txt="Новое устройство в сети: ${nm:-без имени}, $ipa, $m$priv"
		event warn "$txt" quiet
		k=$(printf '%s' "$m" | tr -d ':')
		tgsend "🆕 $(clean "$txt"). Если это ваше устройство, больше это сообщение не повторится." "{\"inline_keyboard\":[[{\"text\":\"✅ Это моё\",\"callback_data\":\"ok:$k\"},{\"text\":\"🚫 Заблокировать\",\"callback_data\":\"bk:$k\"}]]}"
	done < "$DIR/newdev.out"
	rm -f "$DIR/newdev.out"
}

# журнал DNS dnsmasq -> dns.map («адрес приложение»): по именам из ответов определяем, какому сервису принадлежит адрес
do_dns() {
	[ "$APPS" = 1 ] && [ -r "$DNSLOG" ] || return 0
	size=$(wc -c < "$DNSLOG" 2>/dev/null | tr -d ' '); [ -n "$size" ] || return 0
	off=$(cat "$DIR/dns.off" 2>/dev/null); case "$off" in ''|*[!0-9]*) off=0 ;; esac
	[ "$size" -ge "$off" ] || off=0
	if [ "$size" -gt "$off" ]; then
		tail -c +$((off + 1)) "$DNSLOG" 2>/dev/null | awk -v rules="$RULES" -v urules="$RULES_USER" -v map="$DIR/dns.map" '
		function load(f,   l, a, n, d, i) {
			while ((getline l < f) > 0) {
				if (l ~ /^#/ || l == "") continue
				n = split(l, a, "|"); if (n < 2) continue
				split(a[2], d, " "); for (i in d) if (!(d[i] in dom)) dom[d[i]] = a[1]
			}
			close(f)
		}
		function cls(n,   p) {
			n = tolower(n)
			while (1) { if (n in dom) return dom[n]; p = index(n, "."); if (!p) return ""; n = substr(n, p + 1) }
		}
		# «основное» имя для неопознанных адресов: последние две части (example.com), для co.uk/com.ru и т. п. три
		function sld(n,   p, k, i) {
			n = tolower(n); gsub(/[^a-z0-9.-]/, "", n); sub(/\.$/, "", n)
			k = split(n, p, ".")
			if (k <= 2) return n
			if (length(p[k]) == 2 && p[k - 1] ~ /^(co|com|net|org|gov|edu|ac)$/) return p[k - 2] "." p[k - 1] "." p[k]
			return p[k - 1] "." p[k]
		}
		BEGIN { load(urules); load(rules) }
		{
			k = 0
			for (i = 1; i <= NF; i++) if ($i ~ /^query\[/ || $i == "reply" || $i == "cached") { k = i; break }
			if (!k) next
			if ($k ~ /^query\[/) { cur = $(k + 1); chain = 0; next }
			name = $(k + 1); v = $(k + 3)
			if ($(k + 2) != "is") next
			if (v == "<CNAME>") { chain = 1; next }
			if (v !~ /^[0-9a-fA-F.:]+$/) next
			a = ""; if (chain) a = cls(cur); if (a == "") a = cls(name)   # youtube.com -> CNAME на адреса Google: выигрывает исходное имя запроса
			if (a == "") { a = sld(chain ? cur : name); if (a != "" && a ~ /\./) a = "Прочее · " a; else a = "" }
			if (a != "") print tolower(v) "|" a >> map
		}'
		n=$(wc -l < "$DIR/dns.map" 2>/dev/null | tr -d ' ')
		if [ "${n:-0}" -gt 20000 ]; then tail -n 12000 "$DIR/dns.map" > "$DIR/dns.map.tmp" && mv "$DIR/dns.map.tmp" "$DIR/dns.map"; fi
	fi
	# журнал не должен расти бесконечно
	if [ "$size" -gt 1048576 ]; then : > "$DNSLOG"; size=0; fi
	echo "$size" > "$DIR/dns.off"
}

# ---------- суточные итоги трафика WAN (для календаря «Трафик по месяцам») ----------
# traffic.daily: строки «ГГГГММДД принято_байт отправлено_байт», не более 400 дней.
td_date=""; td_rx=0; td_tx=0; td_flush=0
traffic_day() {
	[ "$rx" -ge 0 ] 2>/dev/null && [ "$dtm" -gt 0 ] || return 0
	d=$(date +%Y%m%d)
	[ "$d" -gt 20240101 ] 2>/dev/null || return 0    # часы ещё не синхронизированы
	if [ "$d" != "$td_date" ]; then
		td_date=$d; td_rx=0; td_tx=0
		set -- $(awk -v d="$d" '$1 == d { print $2, $3 }' "$DIR/traffic.daily" 2>/dev/null)
		[ -n "$1" ] && { td_rx=$1; td_tx=$2; }
	fi
	td_rx=$((td_rx + rx * dtm)); td_tx=$((td_tx + tx * dtm))
	if [ $((now - td_flush)) -ge 60 ]; then
		td_flush=$now
		{ [ -r "$DIR/traffic.daily" ] && awk -v d="$d" '$1 != d' "$DIR/traffic.daily" | tail -n 399
		  echo "$d $td_rx $td_tx"; } > "$DIR/traffic.daily.tmp" 2>/dev/null && mv "$DIR/traffic.daily.tmp" "$DIR/traffic.daily"
	fi
}

do_devices() {  # трафик по устройствам: разница счётчиков conntrack между замерами
	[ -r "$CT" ] || return 0
	today=$(date +%Y%m%d)
	if [ "$today" -gt 20240101 ] 2>/dev/null; then
		old=$(cat "$DIR/day.date" 2>/dev/null)
		if [ "$old" != "$today" ]; then
			[ -n "$old" ] && mv "$DIR/dev.day" "$DIR/dev.yday" 2>/dev/null
			if [ -n "$old" ] && [ -s "$DIR/apps.day" ]; then
				awk -v d="$old" '{ print d "|" $0 }' "$DIR/apps.day" >> "$DIR/apps.hist"
				# храним последние 30 суток
				awk -F'|' '{ if (!($1 in s)) { s[$1] = 1; n++; ds[n] = $1 } l[NR] = $0; dt[NR] = $1 } END { for (i = 1; i <= n; i++) for (j = i + 1; j <= n; j++) if (ds[j] > ds[i]) { t = ds[i]; ds[i] = ds[j]; ds[j] = t }
					for (i = 1; i <= n && i <= 30; i++) keep[ds[i]] = 1
					for (i = 1; i <= NR; i++) if (dt[i] in keep) print l[i] }' "$DIR/apps.hist" > "$DIR/apps.hist.tmp" && mv "$DIR/apps.hist.tmp" "$DIR/apps.hist"
			fi
			: > "$DIR/apps.day"
			echo "$today" > "$DIR/day.date"
			: > "$DIR/dev.day"
		fi
	fi
	# учёт по устройствам до версии 1.12.1 мог завышаться: один раз обнуляем накопленные суточные итоги
	if [ "$(cat "$DIR/acct.v" 2>/dev/null)" != 2 ]; then
		: > "$DIR/dev.day"; : > "$DIR/dev.yday"; : > "$DIR/apps.day"; : > "$DIR/apps.hist"; rm -f "$DIR/ct.state"
		echo 2 > "$DIR/acct.v"
	fi
	first=0; [ -s "$DIR/ct.state" ] || first=1
	rm -f "$DIR/ct.state.new"
	head -n 40000 "$CT" 2>/dev/null | awk -v statef="$DIR/ct.state" -v newf="$DIR/ct.state.new" -v dayf="$DIR/dev.day" \
		-v ratef="$DIR/dev.rate.new" -v tmpf="$DIR/dev.day.tmp" -v svcf="$DIR/svc.raw" -v dstf="$DIR/dst.raw" -v dt="$dtm" -v first="$first" -v ts="$now" \
		-v apps="$APPS" -v mapf="$DIR/dns.map" -v appf="$DIR/apps.day" -v appn="$DIR/apps.day.tmp" -v rules="$RULES" -v urules="$RULES_USER" '
	function isprivate(ip) { return ip ~ /^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|127\.|169\.254\.)/ || ip ~ /^(f[cdef]|FE|FC|FD)/ || ip == "::1" || ip ~ /^0000:0000:0000:0000:0000:0000:0000:0001$/ }
	BEGIN {
		while ((getline l < statef) > 0) { split(l, a, " "); po[a[1]] = a[2]; pr[a[1]] = a[3] }
		close(statef)
		while ((getline l < dayf) > 0) { split(l, a, " "); dd[a[1]] = a[2] + 0; du[a[1]] = a[3] + 0 }
		close(dayf)
		if (apps == 1) {
			while ((getline l < mapf) > 0) { split(l, a, "|"); if (a[2] != "") am[a[1]] = a[2] }
			close(mapf)
			ld(urules); ld(rules)
			while ((getline l < appf) > 0) { split(l, a, "|"); k = a[1] "|" a[2]; adl[k] = a[3] + 0; aul[k] = a[4] + 0 }
			close(appf)
		}
	}
	function ld(f,   l, a, n, p, i) {
		while ((getline l < f) > 0) {
			if (l ~ /^#/ || l == "") continue
			n = split(l, a, "|"); if (n < 3) continue
			m = split(a[3], p, " "); for (i = 1; i <= m; i++) { npf++; pf[npf] = p[i]; pfa[npf] = a[1] }
		}
		close(f)
	}
	function appof(ip,   i) {
		if (ip in am) return am[ip]
		for (i = 1; i <= npf; i++) if (index(ip, pf[i]) == 1) return pfa[i]
		return "Прочее"
	}
	{
		src = ""; dst = ""; sp = ""; dp = ""; nb = 0; ob = 0; rb = 0
		for (i = 4; i <= NF; i++) {
			f = $i
			if (src == "" && substr(f, 1, 4) == "src=") src = substr(f, 5)
			else if (dst == "" && substr(f, 1, 4) == "dst=") dst = substr(f, 5)
			else if (sp == "" && substr(f, 1, 6) == "sport=") sp = substr(f, 7)
			else if (dp == "" && substr(f, 1, 6) == "dport=") dp = substr(f, 7)
			else if (substr(f, 1, 6) == "bytes=") { nb++; if (nb == 1) ob = substr(f, 7) + 0; else if (nb == 2) rb = substr(f, 7) + 0 }
		}
		if (nb < 2 || src == "" || dst == "") next
		if (!isprivate(src) && $1 == "ipv4") next          # соединение извне, не устройство локальной сети
		if (isprivate(src) && isprivate(dst)) next          # трафик внутри сети/до роутера — не интернет
		key = $1 "|" $3 "|" src ">" dst ":" sp ">" dp
		# одинаковые «адрес:порт» бывают у нескольких записей (старая в TIME_WAIT и новая): складываем их счётчики,
		# иначе одна запись «уменьшалась» и каждый цикл засчитывалась заново целиком (завышение в сотни раз)
		if (key in so) { so[key] += ob; sr[key] += rb; next }
		so[key] = ob; sr[key] = rb; sa[key] = src; sd[key] = dst; sp3[key] = $3; sdp[key] = dp
	}
	function account(key,   ob, rb, src, dst, do_, dr_, sk, dk, ak) {
		ob = so[key]; rb = sr[key]; src = sa[key]; dst = sd[key]
		printf "%s %.0f %.0f\n", key, ob, rb > newf
		if (first) return
		if (key in po) { do_ = ob - po[key]; dr_ = rb - pr[key]; if (do_ < 0) do_ = ob; if (dr_ < 0) dr_ = rb }
		else { do_ = ob; dr_ = rb }
		# за один цикл по одному соединению не может пройти больше ~2 Гбит/с: всё, что выше, это сбой счётчика
		if (do_ + dr_ > cap) return
		cu[src] += do_; cd[src] += dr_
		if (do_ + dr_ > 0) {
			sk = src " " sp3[key] " " (sdp[key] == "" ? "-" : sdp[key]); sv_d[sk] += dr_; sv_u[sk] += do_
			if (!isprivate(dst)) {
				dk = src " " dst; ds_d[dk] += dr_; ds_u[dk] += do_
				if (apps == 1) { ak = src "|" appof(tolower(dst)); adl[ak] += dr_; aul[ak] += do_ }
			}
		}
	}
	END {
		cap = (dt > 0 ? dt : 10) * 250000000
		for (k in so) account(k)
		print ts > ratef
		for (ip in cd) {
			if (cd[ip] + cu[ip] <= 0) continue
			printf "%s %.0f %.0f\n", ip, cd[ip] / dt, cu[ip] / dt > ratef
			dd[ip] += cd[ip]; du[ip] += cu[ip]
		}
		for (ip in dd) printf "%s %.0f %.0f %.0f\n", ip, dd[ip], du[ip], dd[ip] + du[ip] > tmpf
		if (apps == 1 && !first) { for (k in adl) printf "%s|%.0f|%.0f\n", k, adl[k], aul[k] > appn }
		if (dt > 0) {
			for (k in sv_d) printf "%s %.0f %.0f\n", k, sv_d[k] / dt, sv_u[k] / dt > svcf
			for (k in ds_d) printf "%s %.0f %.0f\n", k, ds_d[k] / dt, ds_u[k] / dt > dstf
		}
	}'
	if [ "$first" = 0 ]; then
		{ echo "$now"; [ -f "$DIR/svc.raw" ] && sort -k4,4nr "$DIR/svc.raw" | head -n 40; } > "$DIR/svc.rate.new"; mv "$DIR/svc.rate.new" "$DIR/svc.rate"
		{ echo "$now"; [ -f "$DIR/dst.raw" ] && sort -k3,3nr "$DIR/dst.raw" | head -n 40; } > "$DIR/dst.rate.new"; mv "$DIR/dst.rate.new" "$DIR/dst.rate"
	fi
	rm -f "$DIR/svc.raw" "$DIR/dst.raw"
	[ -f "$DIR/ct.state.new" ] && mv "$DIR/ct.state.new" "$DIR/ct.state" || : > "$DIR/ct.state"
	[ -f "$DIR/dev.rate.new" ] && mv "$DIR/dev.rate.new" "$DIR/dev.rate"
	if [ -f "$DIR/apps.day.tmp" ]; then
		sort -t'|' -k3,3nr "$DIR/apps.day.tmp" | head -n 600 > "$DIR/apps.day"; rm -f "$DIR/apps.day.tmp"
	fi
	if [ -f "$DIR/dev.day.tmp" ]; then
		sort -k4,4nr "$DIR/dev.day.tmp" | head -n 64 | cut -d' ' -f1-3 > "$DIR/dev.day"
		rm -f "$DIR/dev.day.tmp"
	fi
}

write_info() {
	off=$(uci -q get firewall.@defaults[0].flow_offloading 2>/dev/null)
	acct=0; [ -r "$PROC/sys/net/netfilter/nf_conntrack_acct" ] && acct=$(cat "$PROC/sys/net/netfilter/nf_conntrack_acct" 2>/dev/null)
	{
		echo "step=$STEP"
		echo "started=$started"
		echo "wan_dev=$wdev"
		echo "gateway=$gw"
		echo "targets=$PING_TARGET $PING_TARGET2"
		echo "acct=${acct:-0}"
		echo "offload=${off:-0}"
		echo "router_ips=$(ip -4 addr show 2>/dev/null | awk '/inet / { split($2, a, "/"); printf "%s ", a[1] }')"
		echo "persist=$([ -n "$PERSIST_DIR" ] && [ "$persist_ok" = 1 ] && echo 1 || echo 0)"
		echo "persist_dir=$PERSIST_DIR"
		echo "persist_blocked=$([ -n "$PERSIST_DIR" ] && [ "$persist_ok" = 0 ] && echo 1 || echo 0)"
		echo "persist_hours=$PERSIST_HOURS"
		echo "persist_any=$PERSIST_ANY"
		echo "persist_kb=${persist_kb:-0}"
		echo "persist_last=${persist_last:-0}"
		echo "journal=$JOURNAL"
		echo "journal_file=$JOURNAL_FILE"
		echo "speed_hours=$SPEED_HOURS"
		echo "wifi_hist=$WIFI_HIST"
		echo "limits=temp>=$TEMP_WARN/$TEMP_CRIT, free RAM<$MEM_MIN_PCT%, flash>=$FLASH_MAX_PCT%, conntrack>=$CT_MAX_PCT%, CPU>=$CPU_MAX_PCT% $CPU_MINUTES min"
	} > "$DIR/info.tmp" && mv "$DIR/info.tmp" "$DIR/info"
}

on_flash() {    # 0, если каталог находится на встроенной флеш-памяти роутера (её нельзя изнашивать)
	d=$1; mkdir -p "$d" 2>/dev/null || return 1
	fd=$(df -P "$d" 2>/dev/null | awk 'NR == 2 { print $1 }')
	[ "$PERSIST_ANY" = 1 ] && return 1                  # владелец сам разрешил (например, eMMC или SSD с общим разделом)
	# SD-карта, USB-диск, SSD и NVMe (Raspberry Pi, x86): это не сырая флеш-память роутера, запись раз в несколько часов им не вредит
	case "$fd" in /dev/mmcblk*|/dev/sd[a-z]*|/dev/nvme*|/dev/vd[a-z]*|/dev/loop*) return 1 ;; esac
	for r in /overlay / /rom; do
		[ -d "$r" ] || continue
		fr=$(df -P "$r" 2>/dev/null | awk 'NR == 2 { print $1 }')
		[ -n "$fd" ] && [ "$fd" = "$fr" ] && return 0
	done
	case "$fd" in ubi*|mtd*|/dev/mtd*|/dev/ubi*|rootfs*|overlay*) return 0 ;; esac
	return 1
}

PFILES="hist.coarse events.log dev.day dev.yday day.date speed.log apps.day apps.hist traffic.daily acct.v"
persist() {
	[ -n "$PERSIST_DIR" ] && [ "$persist_ok" = 1 ] || return 0
	mkdir -p "$PERSIST_DIR" 2>/dev/null || return 0
	for f in $PFILES; do
		[ -f "$DIR/$f" ] || continue
		cmp -s "$DIR/$f" "$PERSIST_DIR/$f" 2>/dev/null && continue    # без изменений — не пишем
		cp "$DIR/$f" "$PERSIST_DIR/$f.tmp" 2>/dev/null && mv "$PERSIST_DIR/$f.tmp" "$PERSIST_DIR/$f"
	done
	persist_last=$(date +%s)
	persist_kb=$(du -sk "$PERSIST_DIR" 2>/dev/null | awk '{ print $1 + 0 }')
}

restore() {
	[ -n "$PERSIST_DIR" ] && [ "$persist_ok" = 1 ] && [ -f "$PERSIST_DIR/hist.coarse" ] && [ ! -f "$DIR/hist.coarse" ] || return 0
	for f in $PFILES; do
		[ -f "$PERSIST_DIR/$f" ] && cp "$PERSIST_DIR/$f" "$DIR/$f"
	done
}

# ---------- журнал перезагрузок и обрывов связи (редкие короткие записи на флеш) ----------
jwrite() {      # jwrite TS TYPE DURATION TEXT
	[ "$JOURNAL" = 1 ] || return 0
	printf '%s|%s|%s|%s\n' "$1" "$2" "$3" "$(clean "$4")" >> "$JOURNAL_FILE" 2>/dev/null || return 0
	if [ "$(wc -l < "$JOURNAL_FILE" 2>/dev/null)" -gt 260 ]; then
		tail -n 200 "$JOURNAL_FILE" > "$JOURNAL_FILE.tmp" 2>/dev/null && mv "$JOURNAL_FILE.tmp" "$JOURNAL_FILE"
	fi
}

# ---------- Wi-Fi клиенты в динамике (раз в минуту, только в памяти) ----------
do_wifi() {
	command -v ubus >/dev/null 2>&1 || return 0
	devs=$(ubus call iwinfo devices 2>/dev/null | awk -F'"' 'NF >= 3 && $2 != "devices" { print $2 }')
	[ -n "$devs" ] || return 0
	: > "$DIR/wifi.cur.new"
	for d in $devs; do
		ubus call iwinfo assoclist "{\"device\":\"$d\"}" 2>/dev/null | awk -v ts="$now" -v d="$d" -F'"' '
			$2 == "mac" { m = tolower($4) }
			$2 == "signal" && m != "" { s = $3; gsub(/[^-0-9]/, "", s); if (s != "") print ts, m, s, d; m = "" }' >> "$DIR/wifi.cur.new"
	done
	cat "$DIR/wifi.cur.new" >> "$DIR/wifi.fine"
	if [ -f "$DIR/wifi.cur" ]; then
		awk -v ts="$now" 'NR == FNR { old[$2] = $4; next } { new_[$2] = $4; if (!($2 in old)) print ts, $2, "join", $4 }
			END { for (m in old) if (!(m in new_)) print ts, m, "leave", old[m] }' "$DIR/wifi.cur" "$DIR/wifi.cur.new" >> "$DIR/wifi.ev"
	fi
	mv "$DIR/wifi.cur.new" "$DIR/wifi.cur"
}

stop() { persist; exit 0; }
trap stop TERM INT

# блокировка устройств: правила применяются при старте и раз в минуту (расписание), если список не пуст
do_block() {
	[ -x "$BLOCKBIN" ] || return 0
	if [ -s "$BLOCKLIST" ] || [ -s "$GROUPLIST" ]; then
		bt=$((bt + 1)); [ "$bt" = 1 ] || [ $((now - blast)) -ge 60 ] || return 0
		blast=$now; "$BLOCKBIN" apply >/dev/null 2>&1; bhad=1
	elif [ "$bhad" = 1 ]; then
		bhad=0; "$BLOCKBIN" apply >/dev/null 2>&1
	fi
}
bt=0; blast=0; bhad=0

# ежедневный отчёт: раз в сутки в заданное время (ЧЧ:ММ), метка последней отправки хранится рядом с данными
do_report() {
	[ "$TG" = 1 ] && [ -n "$TG_REPORT" ] && [ -x "$BOTBIN" ] || return 0
	hm=$(date +%H:%M); [ "$hm" = "$TG_REPORT" ] || return 0
	td=$(date +%Y-%m-%d); [ "$(cat "$REPORT_MARK" 2>/dev/null)" = "$td" ] && return 0
	echo "$td" > "$REPORT_MARK"
	txt=$("$BOTBIN" report 2>/dev/null) && [ -n "$txt" ] && tgsend "$txt"
}

# ---------- основной цикл ----------
now=$(date +%s); started=$now
persist_ok=1
if [ -n "$PERSIST_DIR" ] && on_flash "$PERSIST_DIR"; then persist_ok=0; fi
case "$PERSIST_HOURS" in ''|*[!0-9]*) PERSIST_HOURS=6 ;; esac; [ "$PERSIST_HOURS" -ge 1 ] || PERSIST_HOURS=1
restore
read -r up0 _ < "$PROC/uptime" 2>/dev/null; up0=${up0%.*}; case "$up0" in ''|*[!0-9]*) up0=99999 ;; esac
boot_pending=0; [ "$up0" -lt 300 ] && boot_pending=1
gap_note=""
if [ -s "$DIR/hist.coarse" ]; then lastts=$(tail -n 1 "$DIR/hist.coarse" | cut -d' ' -f1); else lastts=0; fi
out_n=0; out_t=0; out_gwfail=0; last_speed=0; wtick=0
[ -s "$DIR/speed.log" ] && last_speed=$(tail -n 1 "$DIR/speed.log" | cut -d' ' -f1)
: > "$DIR/alerts.active"
ptot=""; pidl=""; prx=""; ptx=""; pts=""; tick=0; loops=0

while :; do
	now=$(date +%s)
	tick=$((tick + 1))

	# процессор
	cpu=-1
	read -r _ u n s i w q sq st _ < "$PROC/stat"
	tot=$((u + n + s + i + w + q + sq + st)); idl=$((i + w))
	if [ -n "$ptot" ]; then
		dt=$((tot - ptot)); di=$((idl - pidl))
		[ "$dt" -gt 0 ] && cpu=$((100 * (dt - di) / dt))
	fi
	ptot=$tot; pidl=$idl

	# память
	set -- $(awk '/^MemTotal:/ { t = $2 } /^MemAvailable:/ { a = $2 } /^MemFree:/ { f = $2 } /^Buffers:/ { b = $2 } /^Cached:/ { c = $2 } END { if (a == "") a = f + b + c; print t + 0, a + 0 }' "$PROC/meminfo")
	memt=${1:-0}; mema=${2:-0}
	mem=0; [ "$memt" -gt 0 ] && mem=$((100 * (memt - mema) / memt))

	temp=$(read_temp)

	# WAN-интерфейс и шлюз (маршрут по умолчанию)
	if [ -n "$NF_WAN_DEV" ]; then wdev=$NF_WAN_DEV; gw=${NF_GW:-}
	else
		set -- $(ip -4 route show default 2>/dev/null | awk 'NR == 1 { d = ""; g = ""; for (i = 1; i <= NF; i++) { if ($i == "dev") d = $(i + 1); if ($i == "via") g = $(i + 1) } print d, g }')
		wdev=${1:-}; gw=${2:-}
	fi

	# скорость WAN
	rx=-1; tx=-1; dtm=0
	if [ -n "$wdev" ]; then
		set -- $(awk -v d="$wdev" '{ gsub(/:/, " ") } $1 == d { print $2, $10 }' "$PROC/net/dev")
		crx=$1; ctx=$2
		if [ -n "$crx" ] && [ -n "$prx" ] && [ -n "$pts" ]; then
			dtm=$((now - pts))
			if [ "$dtm" -gt 0 ]; then
				rx=$(( (crx - prx) / dtm )); tx=$(( (ctx - ptx) / dtm ))
				[ "$rx" -ge 0 ] || rx=0; [ "$tx" -ge 0 ] || tx=0
			fi
		fi
		prx=$crx; ptx=$ctx
	else
		prx=""; ptx=""
	fi
	traffic_day
	[ "$dtm" -gt 0 ] || dtm=$((now - ${pts:-$now}))
	pts=$now

	# задержка до шлюза и до интернета
	gwms=-1; netms=-1
	[ -n "$gw" ] && gwms=$(ping_ms "$gw")
	if [ -n "$PING_TARGET" ]; then
		netms=$(ping_ms "$PING_TARGET")
		[ "$netms" = -1 ] && [ -n "$PING_TARGET2" ] && netms=$(ping_ms "$PING_TARGET2")
	fi
	loss=0; [ "$netms" = -1 ] && loss=100

	# журнал обрывов: старт — первый неудачный замер, запись — когда связь вернулась (от 2 неудач подряд)
	if [ -n "$PING_TARGET" ] && [ "$tick" -gt 1 ] && [ "$now" -gt 1700000000 ]; then
		if [ "$netms" = -1 ]; then
			out_n=$((out_n + 1)); [ "$out_n" = 1 ] && { out_t=$now; out_gwfail=0; }
			[ "$gwms" = -1 ] && [ -n "$gw" ] && out_gwfail=1
		elif [ "$out_n" -gt 0 ]; then
			if [ "$out_n" -ge 2 ]; then
				if [ "$out_gwfail" = 1 ]; then cz="нет связи со шлюзом (кабель, модем или провайдер)"; else cz="шлюз отвечал, нет выхода в интернет (провайдер или DNS)"; fi
				jwrite "$out_t" outage "$((now - out_t))" "$cz"
			fi
			out_n=0
		fi
	fi
	# журнал перезагрузок: пишем один раз после синхронизации времени
	if [ "$boot_pending" = 1 ] && [ "$now" -gt 1700000000 ]; then
		boot_pending=0
		read -r upn _ < "$PROC/uptime"; upn=${upn%.*}; bt=$((now - upn))
		if [ "$lastts" -gt 1700000000 ] && [ "$bt" -gt "$lastts" ]; then gap_note="; данных не было $(fmt_dur $((bt - lastts)))"; fi
		if ! tail -n 5 "$JOURNAL_FILE" 2>/dev/null | awk -F'|' -v bt="$bt" '$2 == "boot" { d = bt - $1; if (d < 0) d = -d; if (d < 180) f = 1 } END { exit !f }'; then
			jwrite "$bt" boot 0 "Роутер загружен${gap_note}"
			[ "$TG_ALERTS" = 1 ] && tgsend "🔄 Роутер загружен${gap_note}"
		fi
	fi

	# соединения, диск
	ctn=0; ctm=0
	# /proc/sys читаем через cat: BusyBox read читает по байту, а sysctl при этом отдаёт только первую цифру
	[ -r "$PROC/sys/net/netfilter/nf_conntrack_count" ] && ctn=$(cat "$PROC/sys/net/netfilter/nf_conntrack_count" 2>/dev/null)
	[ -r "$PROC/sys/net/netfilter/nf_conntrack_max" ] && ctm=$(cat "$PROC/sys/net/netfilter/nf_conntrack_max" 2>/dev/null)
	case "$ctn" in ''|*[!0-9]*) ctn=0 ;; esac
	case "$ctm" in ''|*[!0-9]*) ctm=0 ;; esac
	fp=/overlay; [ -d /overlay ] || fp=/
	fl=$(df -kP "$fp" 2>/dev/null | awk 'END { if (NR > 1 && $2 > 0) print int($3 * 100 / $2); else print 0 }')

	# история пишется только когда часы синхронизированы и после первого замера
	if [ "$now" -gt 1700000000 ] && [ "$tick" -gt 1 ]; then
		printf '%s %s %s %s %s %s %s %s %s %s\n' "$now" "$cpu" "$mem" "$temp" "$rx" "$tx" "$gwms" "$netms" "$loss" "$ctn" >> "$DIR/hist.fine"
		do_dns
		do_devices
		do_newdev
		do_block
		[ -f /etc/nightfall-guest.list ] && [ $((tick % 6)) = 0 ] && /usr/libexec/nightfall-guest tick >/dev/null 2>&1
		do_report
		wtick=$((wtick + 1))
		if [ "$WIFI_HIST" = 1 ] && [ $((wtick % 4)) = 1 ]; then do_wifi; fi
		if [ "$SPEED_HOURS" -gt 0 ] 2>/dev/null && [ "$netms" != -1 ] && [ $((now - last_speed)) -ge $((SPEED_HOURS * 3600)) ] && [ "$rx" -lt 400000 ] 2>/dev/null; then
			last_speed=$now
			[ -x /usr/libexec/nightfall-speed ] && /usr/libexec/nightfall-speed start >/dev/null 2>&1
		fi

		# предупреждения
		ti=${temp%.*}; [ "$ti" -ge 0 ] 2>/dev/null || ti=0
		c=0; [ "$ti" -ge "$TEMP_WARN" ] && [ "$ti" -lt "$TEMP_CRIT" ] && c=1
		alert temp warn $((60 / STEP + 1)) $c "Процессор перегрет: ${temp} °C (порог $TEMP_WARN °C)"
		c=0; [ "$ti" -ge "$TEMP_CRIT" ] && c=1
		alert tempc crit 2 $c "Критическая температура процессора: ${temp} °C"
		c=0; [ "$mem" -gt $((100 - MEM_MIN_PCT)) ] && c=1
		alert mem warn $((120 / STEP)) $c "Мало свободной памяти: занято ${mem}%"
		c=0; [ "$fl" -ge "$FLASH_MAX_PCT" ] && c=1
		alert flash warn 2 $c "Флеш-память почти заполнена: ${fl}%"
		c=0; [ "$ctm" -gt 0 ] && [ $((100 * ctn / ctm)) -ge "$CT_MAX_PCT" ] && c=1
		alert ct warn 2 $c "Таблица соединений заполнена на $((100 * ctn / ${ctm:-1}))%"
		c=0; [ "$cpu" -ge "$CPU_MAX_PCT" ] && c=1
		alert cpu warn $((CPU_MINUTES * 60 / STEP)) $c "Процессор загружен на ${cpu}% дольше ${CPU_MINUTES} мин"
		if [ -n "$PING_TARGET" ]; then
			c=0; [ "$netms" = -1 ] && c=1
			if [ "$gwms" = -1 ] && [ -n "$gw" ]; then wt="Нет связи со шлюзом $gw"; else wt="Нет доступа в интернет"; fi
			alert wan crit 3 $c "$wt"
		fi

		# раз в 5 минут: сводная точка за неделю, обрезка, сохранение
		if [ $((tick % AGG)) = 0 ]; then
			tail -n "$AGG" "$DIR/hist.fine" | awk '{ for (i = 2; i <= 10; i++) if ($i >= 0) { s[i] += $i; c[i]++ } last = $1 }
				END { printf "%d", last; for (i = 2; i <= 10; i++) printf " %s", (c[i] ? sprintf("%.1f", s[i] / c[i]) : -1); print "" }' >> "$DIR/hist.coarse"
			for f in "hist.fine 400" "hist.coarse 2016" "events.log 300" "wifi.fine 8000" "wifi.ev 400" "speed.log 400"; do
				[ -f "$DIR/${f% *}" ] || continue
				set -- $f
				if [ "$(wc -l < "$DIR/$1")" -gt "$2" ]; then tail -n "$2" "$DIR/$1" > "$DIR/$1.tmp" && mv "$DIR/$1.tmp" "$DIR/$1"; fi
			done
			write_info
			[ $((tick % (AGG * 12 * PERSIST_HOURS))) = 0 ] && persist
		fi
	fi
	[ "$tick" = 1 ] && { write_info; event info "Сборщик истории запущен"; }

	loops=$((loops + 1))
	[ "$LOOPS" -gt 0 ] && [ "$loops" -ge "$LOOPS" ] && break
	sleep "$STEP" & wait $!
done
