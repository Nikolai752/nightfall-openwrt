#!/bin/sh

changed=0

set_opt() {
	local key=$1
	local val=$2

	if ! uci -q get "luci.$key" 2>/dev/null; then
		uci set "luci.$key=$val"
		changed=1
	fi
}

set_opt themes.Nightfall /luci-static/nightfall

set_opt themes.NightfallDark /luci-static/nightfall-dark
set_opt themes.NightfallLight /luci-static/nightfall-light

if [ $changed = 1 ]; then
	uci commit luci
fi

exit 0
